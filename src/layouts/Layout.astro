---
import "../styles/global.css"
import { ClientRouter } from "astro:transitions"
import PlayerBar from "../components/PlayerBar.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Sushicloud</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <!-- First-visit intro (see initIntro in pages/index.astro). Decided
         here, before first paint, so the hero never flashes fully drawn
         and then restarts. Only a visitor's very first page load counts,
         and only when that page is the landing page; every later visit,
         and any first visit that starts elsewhere, skips it. The timeout
         is a safety net in case the page script never runs. -->
    <script is:inline>
      try {
        if (!localStorage.getItem("sc-intro-seen")) {
          localStorage.setItem("sc-intro-seen", "1")
          if (
            location.pathname === "/" &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches
          ) {
            var r = document.documentElement
            r.classList.add("intro")
            setTimeout(function () {
              r.classList.remove("intro", "intro-go")
            }, 5000)
          }
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <PlayerBar />
  </body>
</html>
