---
import Layout from "../../layouts/Layout.astro"
import CabinetFrame from "../../components/ddr/CabinetFrame.astro"
import HeaderBand from "../../components/ddr/HeaderBand.astro"
import InfoPlate from "../../components/ddr/InfoPlate.astro"
import Jacket from "../../components/ddr/Jacket.astro"
import GrooveRadar from "../../components/ddr/GrooveRadar.astro"
import FootMeter from "../../components/ddr/FootMeter.astro"
import WaveformMini from "../../components/ddr/WaveformMini.astro"
import SongWheel from "../../components/ddr/SongWheel.astro"
import MarqueeFooter from "../../components/ddr/MarqueeFooter.astro"
import { getCollection } from "astro:content"
import {
  aggregateStats,
  hashString,
  jacketSeed,
  resolveTrackStats,
} from "../../lib/track-stats"
import type { DdrData, DdrTrack, DdrYear } from "../../scripts/ddr/types"
import type { TrackStats } from "../../lib/track-stats"

// DDR EXTREME-style "Select Music" concept: Year -> tracks on a song
// wheel, with a groove radar, BPM, difficulty and 16:9 jacket per
// track. Stats are seeded from each track's slug unless hand-set in
// its JSON (see src/lib/track-stats.ts).

const albums = (await getCollection("albums")).sort((a, b) => {
  const aReleaseDate = a.data.releaseDate?.valueOf() ?? 0
  const bReleaseDate = b.data.releaseDate?.valueOf() ?? 0
  return bReleaseDate - aReleaseDate
})

const allTracks = await getCollection(
  "tracks",
  ({ data }) => data.display && !!data.audioUrl,
)

// Duplicated from src/pages/albums/index.astro -- worth extracting to
// a shared util if/when this concept merges into production.
function parseDuration(duration?: string) {
  if (!duration) return 0
  const [minutes, seconds] = duration.split(":").map(Number)
  if (Number.isNaN(minutes) || Number.isNaN(seconds)) return 0
  return minutes * 60 + seconds
}
function formatTotal(totalSeconds: number) {
  const totalMinutes = Math.round(totalSeconds / 60)
  if (totalMinutes <= 0) return null
  if (totalMinutes < 60) return `${totalMinutes} MIN`
  const hours = Math.floor(totalMinutes / 60)
  const minutes = totalMinutes % 60
  return minutes > 0 ? `${hours} HR ${minutes} MIN` : `${hours} HR`
}

const data: DdrData = { years: [], tracks: {}, totalTracks: 0 }

for (const album of albums) {
  const yearTracks = allTracks
    .filter((t) => t.data.album.id === album.id)
    .sort((a, b) => a.data.trackNumber - b.data.trackNumber)
  if (yearTracks.length === 0) continue

  const yearId = album.id
  const trackIds: string[] = []
  const stats: TrackStats[] = []
  let totalSeconds = 0

  yearTracks.forEach((track, i) => {
    const slug = track.id.split("/").pop() ?? track.id
    const id = `track-${yearId}-${slug}`
    const trackStats = resolveTrackStats(slug, {
      stats: track.data.stats,
      bpm: track.data.bpm,
      feet: track.data.feet,
    })
    const durationSeconds = parseDuration(track.data.duration)
    totalSeconds += durationSeconds
    trackIds.push(id)
    stats.push(trackStats)
    const serialized: DdrTrack = {
      kind: "track",
      id,
      slug,
      title: track.data.displayTitle ?? track.data.title,
      yearId,
      year: album.data.title,
      audioUrl: track.data.audioUrl!,
      position: i + 1,
      duration: track.data.duration ?? null,
      durationSeconds,
      stats: trackStats,
      jacket: track.data.jacket ?? null,
      jacketSeed: jacketSeed(slug),
    }
    data.tracks[id] = serialized
  })

  const year: DdrYear = {
    kind: "year",
    id: yearId,
    title: album.data.title,
    trackIds,
    totalDuration: formatTotal(totalSeconds),
    agg: aggregateStats(stats),
    category: hashString(`year:${yearId}`) % 6,
    jacketSeed: jacketSeed(`year-${yearId}`),
  }
  data.years.push(year)
  data.totalTracks += trackIds.length
}
---

<Layout>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Bungee&family=Bungee+Outline&family=Michroma&family=Orbitron:wght@500;700;900&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <CabinetFrame>
    <div class="slot-hdr"><HeaderBand /></div>

    <main class="body">
      <section class="left" aria-label="Song details">
        <div class="slot-plate"><InfoPlate /></div>
        <div class="slot-jacket"><Jacket /></div>
        <div class="slot-lower">
          <div class="slot-radar"><GrooveRadar /></div>
          <div class="slot-side">
            <FootMeter />
            <div class="slot-wave"><WaveformMini /></div>
          </div>
        </div>
      </section>
      <section class="right" aria-label="Song wheel">
        <SongWheel />
      </section>
    </main>

    <div class="slot-ftr"><MarqueeFooter /></div>
  </CabinetFrame>

  <audio id="ddr-preview" preload="none" crossorigin="anonymous"></audio>
  <div class="sr-only" id="ddr-announcer" aria-live="polite" aria-atomic="true">
  </div>
  <script
    type="application/json"
    id="wheel-data"
    set:html={JSON.stringify(data)}
  />
</Layout>

<script>
  import { initDdr } from "../../scripts/ddr/main"
  document.addEventListener("astro:page-load", initDdr)
</script>

<style>
  /* The cabinet is position:fixed and owns the whole viewport. */
  :global(body) {
    padding-bottom: 0 !important;
    overflow: hidden;
  }
  /* This page has its own transport strip; the global bar keeps
     playing underneath and reappears on every other page. */
  :global(#player-bar),
  :global(#player-drawer) {
    display: none !important;
  }

  .slot-hdr {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 5;
  }

  .body {
    position: absolute;
    top: calc(114 * var(--u));
    bottom: calc(102 * var(--u));
    left: calc(18 * var(--u));
    right: calc(12 * var(--u));
    display: grid;
    grid-template-columns: calc(440 * var(--u)) minmax(0, 1fr);
    gap: calc(14 * var(--u));
  }

  .left {
    display: grid;
    grid-template-rows: calc(58 * var(--u)) auto minmax(0, 1fr);
    gap: calc(8 * var(--u));
    min-height: 0;
  }
  .slot-lower {
    display: grid;
    grid-template-columns: calc(200 * var(--u)) minmax(0, 1fr);
    gap: calc(10 * var(--u));
    min-height: 0;
  }
  .slot-radar {
    min-height: 0;
  }
  .slot-side {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
    min-height: 0;
  }
  .slot-wave {
    flex: 1;
    min-height: 0;
    display: grid;
  }

  .right {
    position: relative;
    min-height: 0;
  }

  .slot-ftr {
    position: absolute;
    inset: auto 0 0 0;
    height: calc(96 * var(--u));
    z-index: 5;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- phones: one stacked column ---------- */
  @media (max-width: 780px) {
    .body {
      top: calc(92 * var(--u) + env(safe-area-inset-top));
      bottom: calc(96 * var(--u) + env(safe-area-inset-bottom));
      left: calc(10 * var(--u));
      right: calc(8 * var(--u));
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      gap: calc(8 * var(--u));
    }
    .left {
      grid-template-columns: calc(232 * var(--u)) minmax(0, 1fr);
      grid-template-rows: auto auto;
      gap: calc(6 * var(--u)) calc(8 * var(--u));
    }
    .slot-plate {
      grid-column: 1 / -1;
      height: calc(48 * var(--u));
    }
    .slot-jacket {
      grid-column: 1;
    }
    .slot-lower {
      grid-column: 2;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr);
    }
    .slot-side {
      display: none;
    }
    .slot-ftr {
      height: calc(92 * var(--u) + env(safe-area-inset-bottom));
    }
  }
</style>
