  .genre-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .genre-chip.is-primary {
    color: var(--bone);
    border-color: var(--ash-dim);
