    z-index: 1;
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(260px, 340px) 1fr;
    grid-template-rows: minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .left-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero {
    background: var(--static);
    border: 1px solid var(--line);
    border-radius: 16px;
