---
import Layout from "../../layouts/Layout.astro"
import { getCollection } from "astro:content"

const albums = (await getCollection("albums")).sort((a, b) => {
  const aReleaseDate = a.data.releaseDate?.valueOf() ?? 0
  const bReleaseDate = b.data.releaseDate?.valueOf() ?? 0
  return bReleaseDate - aReleaseDate
})

const allTracks = await getCollection(
  "tracks",
  ({ data }) => data.display && !!data.audioUrl,
)

const tracksByAlbum = new Map<string, typeof allTracks>()
for (const track of allTracks) {
  const albumId = track.data.album.id
  const list = tracksByAlbum.get(albumId) ?? []
  list.push(track)
  tracksByAlbum.set(albumId, list)
}

// Sample-only BPM/genre data for this concept page -- no such fields
// exist on the real tracks schema (see src/content.config.ts). Keyed
// by the track's slug (last segment of its content-collection id).
// Tracks not listed here render an explicit empty state.
const SAMPLE_TRACK_META: Record<string, { bpm: number; genres: string[] }> = {
  "boom-original-mix": { bpm: 128, genres: ["Progressive House", "Electro"] },
  "chrome-lights-original-mix-2": { bpm: 132, genres: ["Techno"] },
  "just-for-kicks-original-mix": { bpm: 124, genres: ["House", "Funk"] },
  "birth-of-a-hero-final-mix": { bpm: 140, genres: ["Trance", "Uplifting"] },
  deadmau6: { bpm: 126, genres: ["Progressive House"] },
  "ghost-n-stuff-remix": { bpm: 128, genres: ["Electro House", "Dubstep"] },
  "the-light": { bpm: 130, genres: ["Trance"] },
}

// Duplicated from src/pages/albums/index.astro -- worth extracting to
// a shared util if/when this concept merges into production.
function parseDuration(duration?: string) {
  if (!duration) return 0
  const [minutes, seconds] = duration.split(":").map(Number)
  if (Number.isNaN(minutes) || Number.isNaN(seconds)) return 0
  return minutes * 60 + seconds
}
function formatTotal(totalSeconds: number) {
  const totalMinutes = Math.round(totalSeconds / 60)
  if (totalMinutes <= 0) return null
  if (totalMinutes < 60) return `${totalMinutes} min`
  const hours = Math.floor(totalMinutes / 60)
  const minutes = totalMinutes % 60
  return minutes > 0 ? `${hours} hr ${minutes} min` : `${hours} hr`
}

type SerializedTrack = {
  kind: "track"
  id: string
  title: string
  album?: string
  albumId?: string
  audioUrl: string
  trackNumber?: number
  duration?: string | null
  bpm?: number | null
  genres: string[]
  parentFolderId: string
}
type SerializedFolder = {
  kind: "folder"
  id: string
  title: string
  year: string | null
  trackCount: number
  totalDuration: string | null
  trackIds: string[]
}
type SerializedItem = SerializedFolder | SerializedTrack

const itemsById: Record<string, SerializedItem> = {}
const topLevelFolderIds: string[] = []

for (const album of albums) {
  const albumTracks = (tracksByAlbum.get(album.id) ?? []).sort(
    (a, b) => a.data.trackNumber - b.data.trackNumber,
  )
  if (albumTracks.length === 0) continue // don't render empty folders

  const folderId = `album-${album.id}`
  const trackIds: string[] = []
  let totalSeconds = 0

  for (const track of albumTracks) {
    const slug = track.id.split("/").pop() ?? track.id
    const meta = SAMPLE_TRACK_META[slug]
    const trackItemId = `track-${slug}`
    trackIds.push(trackItemId)
    totalSeconds += parseDuration(track.data.duration)
    itemsById[trackItemId] = {
      kind: "track",
      id: trackItemId,
      title: track.data.displayTitle ?? track.data.title,
      album: album.data.title,
      albumId: album.id,
      audioUrl: track.data.audioUrl!,
      trackNumber: track.data.trackNumber,
      duration: track.data.duration ?? null,
      bpm: meta?.bpm ?? null,
      genres: meta?.genres ?? [],
      parentFolderId: folderId,
    }
  }

  itemsById[folderId] = {
    kind: "folder",
    id: folderId,
    title: album.data.title,
    year: album.data.releaseDate
      ? album.data.releaseDate.toLocaleDateString("en-US", {
          timeZone: "UTC",
          year: "numeric",
        })
      : null,
    trackCount: albumTracks.length,
    totalDuration: formatTotal(totalSeconds),
    trackIds,
  }
  topLevelFolderIds.push(folderId)
}

// Tracks whose album reference doesn't resolve to a fetched album --
// the real schema requires `album` on every track (reference("albums"),
// not optional), so with today's data this is always empty. Built
// defensively/correctly regardless, per "Singles only if it has tracks."
const singlesTracks = allTracks
  .filter((t) => !albums.some((a) => a.id === t.data.album.id))
  .sort((a, b) => a.data.trackNumber - b.data.trackNumber)

if (singlesTracks.length > 0) {
  const folderId = "singles"
  const trackIds: string[] = []
  let totalSeconds = 0
  for (const track of singlesTracks) {
    const slug = track.id.split("/").pop() ?? track.id
    const meta = SAMPLE_TRACK_META[slug]
    const trackItemId = `track-${slug}`
    trackIds.push(trackItemId)
    totalSeconds += parseDuration(track.data.duration)
    itemsById[trackItemId] = {
      kind: "track",
      id: trackItemId,
      title: track.data.displayTitle ?? track.data.title,
      album: "Singles",
      audioUrl: track.data.audioUrl!,
      trackNumber: track.data.trackNumber,
      duration: track.data.duration ?? null,
      bpm: meta?.bpm ?? null,
      genres: meta?.genres ?? [],
      parentFolderId: folderId,
    }
  }
  itemsById[folderId] = {
    kind: "folder",
    id: folderId,
    title: "Singles",
    year: null,
    trackCount: singlesTracks.length,
    totalDuration: formatTotal(totalSeconds),
    trackIds,
  }
  topLevelFolderIds.push(folderId)
}

function pluralTracks(n: number) {
  return `${n} track${n === 1 ? "" : "s"}`
}
function folderYearLabel(folder: SerializedFolder) {
  return folder.year && folder.year !== folder.title ? folder.year : ""
}
---

<Layout>
  <div class="wheel-page">
    <div class="top-row" id="top-row">
      <a class="back" href="/"> ← Back to site </a>
      <button class="sfx-toggle" id="sfx-toggle" type="button">
        SFX: <span id="sfx-toggle-state">On</span>
      </button>
    </div>

    <div class="wheel-grid" id="wheel-grid">
      <div class="left-col" id="left-col">
        <div class="hero" id="hero">
          <div class="hero-albums-view" id="hero-albums-view">
            <!--
              Mobile only: merges the old separate docked-header back
              control into this same hero block, so album info shows
              exactly once. Hidden on desktop (never unhidden there)
              and in mobile albums view (nothing to go back from).
            -->
            <button
              class="mobile-hero-back"
              id="mobile-hero-back"
              type="button"
              hidden
              aria-label="Back to albums"
            >
              <span class="ic-collapse" aria-hidden="true"></span>
            </button>
            <div class="hero-top">
              <h2 class="hero-title" id="albums-hero-title">—</h2>
              <button
                class="hero-play"
                id="albums-hero-play-btn"
                type="button"
                aria-label="Play album"
              >
                <span
                  class="ic-hero-icon ic-play-mini"
                  id="albums-hero-play-icon"
                ></span>
              </button>
            </div>
            <div class="hero-meta">
              <span id="albums-hero-year"></span>
              <span id="albums-hero-count"></span>
              <span id="albums-hero-duration"></span>
            </div>
          </div>

          <div class="hero-album-view" id="hero-album-view" hidden>
            <div class="hero-top">
              <h2 class="hero-title" id="track-hero-title">—</h2>
              <button
                class="hero-play"
                id="track-hero-play-btn"
                type="button"
                aria-label="Play"
              >
                <span
                  class="ic-hero-icon ic-play-mini"
                  id="track-hero-play-icon"
                ></span>
              </button>
            </div>
            <div class="hero-meta">
              <span>Track <b id="track-hero-number">—</b></span>
              <span id="track-hero-duration">—</span>
            </div>
          </div>
        </div>

        <div class="stats" id="stats" hidden>
          <p class="stats-label">Stats</p>
          <div class="bpm-row">
            <span class="bpm-value" id="stats-bpm">—</span>
            <span class="bpm-label">BPM</span>
          </div>
          <div class="genres" id="stats-genres">
            <span class="genre-empty">No genre data</span>
          </div>
        </div>
      </div>

      <div class="wheel-area" id="wheel-area">
        <!--
          Top slot for the wheel column: a quiet "Albums" label in
          albums view, replaced by the docked header (cloned from
          docked-header-template below) once an album is open. The
          docked header is the clicked album row itself, morphed into
          place via the View Transitions API where supported -- see
          the client script's beginEnterAlbum/beginExitAlbum.
        -->
        <div class="wheel-top-slot" id="wheel-top-slot">
          <span class="wheel-top-label is-active" id="wheel-top-label">
            Albums
          </span>
        </div>

        <ol
          class="wheel"
          id="wheel"
          role="listbox"
          aria-label="Albums"
          tabindex="0"
        >
          {
            topLevelFolderIds.map((folderId, i) => {
              const folder = itemsById[folderId] as SerializedFolder
              return (
                <li
                  class="wheel-row is-folder"
                  id={`wheel-item-${folder.id}`}
                  role="option"
                  aria-selected={i === 0 ? "true" : "false"}
                  aria-setsize={topLevelFolderIds.length}
                  aria-posinset={i + 1}
                  data-id={folder.id}
                >
                  <span class="row-icon">
                    <svg
                      class="ic-album-cursor"
                      viewBox="0 0 24 24"
                      width="24"
                      height="24"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="8" fill="var(--void)" />
                      <circle
                        cx="12"
                        cy="12"
                        r="5"
                        fill="none"
                        stroke="var(--ash-dim)"
                        stroke-width="1"
                      />
                      <circle
                        class="ic-album-cursor-ring"
                        cx="12"
                        cy="12"
                        r="10"
                        fill="none"
                        stroke-width="2"
                        stroke-dasharray="53 10"
                        transform="rotate(-90 12 12)"
                      />
                    </svg>
                  </span>
                  <span class="row-text">
                    <span class="row-title-row">
                      <span class="row-title">{folder.title}</span>
                      <span class="row-playing-dot" hidden />
                    </span>
                    <span class="row-album">{folderYearLabel(folder)}</span>
                  </span>
                  <span class="row-duration">
                    {pluralTracks(folder.trackCount)}
                  </span>
                </li>
              )
            })
          }
        </ol>
      </div>
    </div>

    <!--
      Row/chip templates for JS-side cloning. A clone of a server-
      rendered <template>'s content keeps Astro's scoped-style
      attribute, unlike a node built with document.createElement --
      which is why the scoped CSS below actually applies to anything
      created after the initial page load.
    -->
    <template id="track-row-template">
      <li class="wheel-row" role="option" aria-selected="false">
        <span class="row-icon">
          <span class="ic-track-icon ic-play-mini"></span>
        </span>
        <span class="row-text">
          <span class="row-title"></span>
          <span class="row-album"></span>
        </span>
        <span class="row-duration"></span>
      </li>
    </template>
    <template id="folder-row-template">
      <li class="wheel-row is-folder" role="option" aria-selected="false">
        <span class="row-icon">
          <svg
            class="ic-album-cursor"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8" fill="var(--void)"></circle>
            <circle
              cx="12"
              cy="12"
              r="5"
              fill="none"
              stroke="var(--ash-dim)"
              stroke-width="1"
            ></circle>
            <circle
              class="ic-album-cursor-ring"
              cx="12"
              cy="12"
              r="10"
              fill="none"
              stroke-width="2"
              stroke-dasharray="53 10"
              transform="rotate(-90 12 12)"
            ></circle>
          </svg>
        </span>
        <span class="row-text">
          <span class="row-title-row">
            <span class="row-title"></span>
            <span class="row-playing-dot" hidden></span>
          </span>
          <span class="row-album"></span>
        </span>
        <span class="row-duration"></span>
      </li>
    </template>
    <template id="genre-chip-template">
      <span class="genre-chip"></span>
    </template>
    <template id="genre-empty-template">
      <span class="genre-empty">No genre data</span>
    </template>
    <!--
      The docked header: not a wheel row (outside #wheel, never
      touched by the arc/scale math), but reuses the exact same row
      shape/icon markup so the View Transition between this and the
      clicked album row has matching content to morph between. Cloned
      once at init and reused for the page's whole lifetime; only its
      text content and aria-label change per album.
    -->
    <template id="docked-header-template">
      <button class="wheel-row docked-header" id="docked-header" type="button" hidden>
        <span class="ic-collapse docked-chevron" aria-hidden="true"></span>
        <span class="row-icon">
          <svg
            class="ic-album-cursor"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8" fill="var(--void)"></circle>
            <circle
              cx="12"
              cy="12"
              r="5"
              fill="none"
              stroke="var(--ash-dim)"
              stroke-width="1"
            ></circle>
            <circle
              class="ic-album-cursor-ring"
              cx="12"
              cy="12"
              r="10"
              fill="none"
              stroke-width="2"
              stroke-dasharray="53 10"
              transform="rotate(-90 12 12)"
            ></circle>
          </svg>
        </span>
        <span class="row-text">
          <span class="row-title"></span>
          <span class="row-album"></span>
        </span>
      </button>
    </template>

    <!--
      Docked mini player: replaces the old status icon/now-playing
      pill. Hidden until a track has actually loaded -- never show a
      button that does nothing. Tapping it anywhere but the two
      buttons opens the expanded player below.
    -->
    <div class="mini-player" id="mini-player" hidden>
      <div class="mini-player-progress-track" aria-hidden="true">
        <div class="mini-player-progress" id="mini-player-progress"></div>
      </div>
      <div class="mini-player-info">
        <div class="mini-player-title" id="mini-player-title"></div>
        <div class="mini-player-album" id="mini-player-album"></div>
      </div>
      <div class="mini-player-controls">
        <button
          class="mini-player-btn"
          id="mini-player-play-btn"
          type="button"
          aria-label="Play"
        >
          <span class="ic-play-mini" id="mini-player-play-icon"></span>
        </button>
        <button
          class="mini-player-btn"
          id="mini-player-next-btn"
          type="button"
          aria-label="Next"
        >
          <span class="ic-skip-mini"></span>
        </button>
      </div>
    </div>

    <!--
      Expanded player: a page-scoped modal, not PlayerBar's own
      #player-drawer (which is a different shape -- album art, no
      history handling, a different breakpoint -- see the merge-debt
      note at the top of this page's script). Slides up from the mini
      bar; closes via the chevron, swipe-down, Escape, or back.
    -->
    <div
      class="expanded-player"
      id="expanded-player"
      role="dialog"
      aria-modal="true"
      aria-label=""
      hidden
    >
      <div class="expanded-top">
        <button
          class="expanded-close"
          id="expanded-close-btn"
          type="button"
          aria-label="Close player"
        >
          <span class="ic-expanded-chevron-down" aria-hidden="true"></span>
        </button>
        <span class="expanded-source" id="expanded-source-label"></span>
      </div>

      <div class="expanded-visualizer" aria-hidden="true"></div>

      <div class="expanded-meta-block">
        <h2 class="expanded-title" id="expanded-title">—</h2>
        <p class="expanded-subtitle" id="expanded-subtitle">—</p>
      </div>

      <div class="expanded-scrub">
        <input
          class="expanded-seek"
          id="expanded-seek"
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          aria-label="Seek"
        />
        <div class="expanded-times">
          <span class="expanded-time" id="expanded-elapsed">0:00</span>
          <span class="expanded-time" id="expanded-remaining">-0:00</span>
        </div>
      </div>

      <div class="expanded-controls">
        <button
          class="expanded-tbtn"
          id="expanded-prev-btn"
          type="button"
          aria-label="Previous"
        >
          <span class="ic-skip-mini prev"></span>
        </button>
        <button
          class="expanded-tbtn expanded-play"
          id="expanded-play-btn"
          type="button"
          aria-label="Play"
        >
          <span class="ic-play-mini" id="expanded-play-icon"></span>
        </button>
        <button
          class="expanded-tbtn"
          id="expanded-next-btn"
          type="button"
          aria-label="Next"
        >
          <span class="ic-skip-mini"></span>
        </button>
      </div>
    </div>

    <div class="sr-only" aria-live="polite" id="wheel-announcer"></div>
  </div>

  <script
    type="application/json"
    id="wheel-data"
    set:html={JSON.stringify({ topLevelFolderIds, itemsById })}
  />
</Layout>

<script>
  // ---------- merge-debt notes (mobile playback controls round) ----------
  // Three known inconsistencies introduced or exposed by this round,
  // left as-is because reconciling them wasn't part of this task's
  // scope, but worth resolving together whenever this concept work
  // merges into production:
  //
  // 1. PlayerBar.astro's own #player-drawer (a full-screen now-playing
  //    UI, gated to <681px) is now largely redundant with this page's
  //    expanded player -- different shape (album art vs. a reserved
  //    visualizer placeholder), no history handling, no Media Session
  //    tie-in of its own beyond what PlayerBar already does globally.
  //    Candidate for retiring #player-drawer in favor of this one.
  // 2. #player-drawer's own breakpoint (681px) doesn't match this
  //    page's (780px, MOBILE_BREAKPOINT below) -- a viewport between
  //    the two sees neither. Should become one shared value.
  // 3. This page's next/previous (and PlayerBar's own Media Session
  //    action handlers) are non-wrapping (stop at the ends of the
  //    queue); PlayerBar's own on-screen bar/drawer buttons still wrap
  //    around. Three different behaviors for the same underlying
  //    action across the codebase now -- should converge on one.

  function initWheel() {
    const page = document.querySelector(".wheel-page") as HTMLElement | null
    const wheelEl = document.getElementById("wheel")
    const dataEl = document.getElementById("wheel-data")
    if (!page || !wheelEl || !dataEl || page.dataset.initialized === "true")
      return
    page.dataset.initialized = "true"

    type TrackItem = {
      kind: "track"
      id: string
      title: string
      album?: string
      albumId?: string
      audioUrl: string
      trackNumber?: number
      duration?: string | null
      bpm?: number | null
      genres: string[]
      parentFolderId: string
    }
    type FolderItem = {
      kind: "folder"
      id: string
      title: string
      year: string | null
      trackCount: number
      totalDuration: string | null
      trackIds: string[]
    }
    type WheelItem = TrackItem | FolderItem
    type QueueTrack = {
      title: string
      album?: string
      albumId?: string
      audioUrl: string
    }
    type VisibleEntry = { item: WheelItem; posinset: number; setsize: number }
    // Minimal shape for the (still-unstable-in-some-lib.dom-versions)
    // View Transitions API -- declared locally rather than relying on
    // a global type so this compiles regardless of the TS/lib version.
    type ViewTransitionLike = {
      ready: Promise<void>
      updateCallbackDone: Promise<void>
      finished: Promise<void>
      skipTransition: () => void
    }
    type MorphSpec = {
      oldEl: HTMLElement | null
      getNewEl: () => HTMLElement | null
      name: string
    }

    let topLevelFolderIds: string[] = []
    let itemsById: Record<string, WheelItem> = {}
    try {
      const parsed = JSON.parse(dataEl.textContent ?? "{}")
      topLevelFolderIds = parsed.topLevelFolderIds ?? []
      itemsById = parsed.itemsById ?? {}
    } catch {
      topLevelFolderIds = []
      itemsById = {}
    }

    if (topLevelFolderIds.length === 0) return

    const wheelGridEl = document.getElementById("wheel-grid")
    const leftCol = document.getElementById("left-col")
    const heroAlbumsView = document.getElementById("hero-albums-view")
    const heroAlbumView = document.getElementById("hero-album-view")
    const mobileHeroBack = document.getElementById(
      "mobile-hero-back",
    ) as HTMLButtonElement | null
    const albumsHeroTitle = document.getElementById("albums-hero-title")
    const albumsHeroYear = document.getElementById("albums-hero-year")
    const albumsHeroCount = document.getElementById("albums-hero-count")
    const albumsHeroDuration = document.getElementById("albums-hero-duration")
    const albumsHeroPlayBtn = document.getElementById(
      "albums-hero-play-btn",
    ) as HTMLButtonElement | null
    const albumsHeroPlayIcon = document.getElementById("albums-hero-play-icon")
    const trackHeroTitle = document.getElementById("track-hero-title")
    const trackHeroNumber = document.getElementById("track-hero-number")
    const trackHeroDuration = document.getElementById("track-hero-duration")
    const trackHeroPlayBtn = document.getElementById(
      "track-hero-play-btn",
    ) as HTMLButtonElement | null
    const trackHeroPlayIcon = document.getElementById("track-hero-play-icon")
    const wheelTopSlot = document.getElementById("wheel-top-slot")
    const wheelTopLabel = document.getElementById("wheel-top-label")
    const statsEl = document.getElementById("stats")
    const statsBpm = document.getElementById("stats-bpm")
    const statsGenres = document.getElementById("stats-genres")
    const topRowEl = document.getElementById("top-row")
    const miniPlayerEl = document.getElementById("mini-player")
    const miniPlayerProgress = document.getElementById("mini-player-progress")
    const miniPlayerTitle = document.getElementById("mini-player-title")
    const miniPlayerAlbum = document.getElementById("mini-player-album")
    const miniPlayerPlayBtn = document.getElementById(
      "mini-player-play-btn",
    ) as HTMLButtonElement | null
    const miniPlayerPlayIcon = document.getElementById("mini-player-play-icon")
    const miniPlayerNextBtn = document.getElementById(
      "mini-player-next-btn",
    ) as HTMLButtonElement | null
    const expandedPlayerEl = document.getElementById("expanded-player")
    const expandedCloseBtn = document.getElementById(
      "expanded-close-btn",
    ) as HTMLButtonElement | null
    const expandedSourceLabel = document.getElementById("expanded-source-label")
    const expandedTitle = document.getElementById("expanded-title")
    const expandedSubtitle = document.getElementById("expanded-subtitle")
    const expandedSeek = document.getElementById(
      "expanded-seek",
    ) as HTMLInputElement | null
    const expandedElapsed = document.getElementById("expanded-elapsed")
    const expandedRemaining = document.getElementById("expanded-remaining")
    const expandedPrevBtn = document.getElementById(
      "expanded-prev-btn",
    ) as HTMLButtonElement | null
    const expandedPlayBtn = document.getElementById(
      "expanded-play-btn",
    ) as HTMLButtonElement | null
    const expandedPlayIcon = document.getElementById("expanded-play-icon")
    const expandedNextBtn = document.getElementById(
      "expanded-next-btn",
    ) as HTMLButtonElement | null
    const announcer = document.getElementById("wheel-announcer")
    const sfxToggleBtn = document.getElementById(
      "sfx-toggle",
    ) as HTMLButtonElement | null
    const sfxToggleState = document.getElementById("sfx-toggle-state")

    const trackRowTemplate = document.getElementById(
      "track-row-template",
    ) as HTMLTemplateElement | null
    const folderRowTemplate = document.getElementById(
      "folder-row-template",
    ) as HTMLTemplateElement | null
    const genreChipTemplate = document.getElementById(
      "genre-chip-template",
    ) as HTMLTemplateElement | null
    const genreEmptyTemplate = document.getElementById(
      "genre-empty-template",
    ) as HTMLTemplateElement | null
    const dockedHeaderTemplate = document.getElementById(
      "docked-header-template",
    ) as HTMLTemplateElement | null

    // Cloned once, reused for the page's whole lifetime -- only its
    // text content, aria-label, and hidden state change per album.
    const dockedHeaderSource = dockedHeaderTemplate?.content.firstElementChild
    const dockedHeaderEl = dockedHeaderSource
      ? (dockedHeaderSource.cloneNode(true) as HTMLButtonElement)
      : null
    if (dockedHeaderEl) wheelTopSlot?.appendChild(dockedHeaderEl)

    // ---------- constants ----------
    const ROW_HEIGHT = 64
    const EDGE_PADDING = 32
    const DESKTOP_ROW_WIDTH_RATIO = 0.62
    const DESKTOP_RADIUS_RATIO = 1.4
    const SCALE_FALLOFF = 0.08
    const SCALE_FLOOR = 0.72
    const OPACITY_FALLOFF = 0.22
    const OPACITY_FLOOR = 0.15
    const RENDER_WINDOW = 10
    const EASE_DECAY_RATE = 16 // per second, framerate-independent
    const SNAP_EPSILON = 0.001
    const WHEEL_STEP_THRESHOLD = 70
    const WHEEL_LOCK_SILENCE_MS = 150
    const WHEEL_DECAY_TOLERANCE = 0.85
    const MOBILE_BREAKPOINT = "(max-width: 780px)"
    const SWEEP_OFFSET = 14 // rows, beyond RENDER_WINDOW -- fully off-screen
    const SWEEP_LEG_MS = 200
    const MOBILE_FADE_MS = 150
    // Fallback-only (no View Transitions support): a plain crossfade
    // between the "Albums" label and the docked header.
    const TOP_SLOT_FADE_MS = 200
    // Where the album-view center slot sits, as a fraction of the
    // wheel area's own height -- 1/2 (unchanged) in albums view, up
    // near the docked header in album view so the selected track
    // isn't stranded in empty space below it.
    const ALBUM_CENTER_Y_RATIO = 1 / 3
    // Kept in sync with .expanded-player's own CSS transition
    // duration -- used to know when the slide-down close animation
    // has actually finished before hiding the element for real.
    const EXPANDED_PLAYER_TRANSITION_MS = 250
    // Vertical drag distance (px) past which releasing a swipe-down
    // gesture commits to closing the expanded player, rather than
    // snapping back open.
    const SWIPE_CLOSE_THRESHOLD = 80

    // ---------- state ----------
    let view: "albums" | "album" = "albums"
    let selectedAlbumId: string | null = topLevelFolderIds[0] ?? null
    let selectedTrackId: string | null = null
    let visibleEntries: VisibleEntry[] = []
    let rowEls: HTMLLIElement[] = []
    let selectedIndex = 0
    let wheelPosition = 0
    let targetIndex = 0
    let animating = false
    let lastFrameTime = 0
    let activeAudioUrl: string | null = null
    let activePlaying = false
    // From player:state's enriched payload -- the non-wrapping queue
    // boundaries, so next/previous can grey out/restart correctly
    // without this page ever seeing PlayerBar's actual queue/index.
    let hasPrevious = false
    let hasNext = false
    // Cached from player:progress -- this page never reads
    // #player-audio directly, so this is the only source of "current
    // playback position" it has, used for both the mini/expanded
    // player's time display and the 3-second previous-track rule.
    let lastKnownCurrentTime = 0
    let lastKnownDuration = 0
    // True while the expanded player's own seek slider is being
    // dragged -- incoming player:progress updates must not fight that
    // drag by resetting the slider mid-gesture.
    let expandedSeekDragging = false
    // Mobile only: the albums list's own scrollTop, captured right
    // before drilling into an album so "back" can restore it exactly
    // rather than centering/scrolling anything.
    let savedAlbumsScrollTop = 0
    // Whether the expanded player is currently open -- gates the
    // global keydown handler (Escape closes it instead of triggering
    // album-view back-navigation) and the focus trap.
    let expandedPlayerOpen = false
    let lastFocusedBeforeExpand: HTMLElement | null = null

    // transition state (desktop sweep + mobile crossfade both use this
    // as the "is something in flight" guard). "pre-swap" = old content
    // still showing, easing/fading out; "morphing" = the doSwap DOM
    // mutation + docked-header morph is in flight (view has already
    // flipped, but the post-swap row sweep hasn't started yet -- only
    // meaningfully distinct from "post-swap" while a View Transition
    // is actually pending); "post-swap" = new content showing,
    // easing/fading in.
    let transitionPhase: "idle" | "pre-swap" | "morphing" | "post-swap" = "idle"
    let transitionDirection: 1 | -1 = 1
    let sweepRafId: number | null = null
    let mobileFadeTimeoutId: number | null = null
    let activeViewTransition: ViewTransitionLike | null = null
    // Bumped by cancelActiveTransition() (always called at the start
    // of a fresh runLevelTransition(), and directly by a mid-"pre-swap"
    // reversal in requestBack()). Every async continuation (a sweep's
    // onDone, a mobile timeout, a VT's .finished handler) captures the
    // token in force when it was scheduled and checks it before acting
    // -- a superseded continuation firing late (View Transition promises
    // can't be cancelled, only reacted to) becomes a silent no-op
    // instead of stepping on whatever transition replaced it.
    let transitionToken = 0
    // Fallback-only (no View Transitions support): crossfades the
    // "Albums" label against the docked header, the same "unhide, one
    // rAF later start the opacity transition, hide the other side once
    // its own fade-out timeout fires" shape used elsewhere on this
    // page for a hidden-toggled, opacity-faded element.
    let topSlotFadeRafId: number | null = null
    let topSlotFadeTimeoutId: number | null = null

    const mobileQuery = window.matchMedia(MOBILE_BREAKPOINT)
    const reducedMotionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    )

    function isMobileMode() {
      return mobileQuery.matches
    }
    function prefersReducedMotion() {
      return reducedMotionQuery.matches
    }
    function isFormField(target: EventTarget | null) {
      const el = target as HTMLElement | null
      const tag = el?.tagName
      return (
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        tag === "BUTTON" ||
        el?.isContentEditable
      )
    }
    function pluralTracks(n: number) {
      return `${n} track${n === 1 ? "" : "s"}`
    }
    function folderYearLabel(folder: FolderItem) {
      return folder.year && folder.year !== folder.title ? folder.year : ""
    }
    function getFolder(id: string | null): FolderItem | undefined {
      const item = id ? itemsById[id] : undefined
      return item?.kind === "folder" ? item : undefined
    }

    // ---------- current-level item list ----------
    function currentLevelEntries(): VisibleEntry[] {
      if (view === "albums") {
        return topLevelFolderIds.map((id, i) => ({
          item: itemsById[id],
          posinset: i + 1,
          setsize: topLevelFolderIds.length,
        }))
      }
      const album = getFolder(selectedAlbumId)
      if (!album) return []
      return album.trackIds.map((id, i) => ({
        item: itemsById[id],
        posinset: i + 1,
        setsize: album.trackCount,
      }))
    }

    function currentViewLabel(): string {
      if (view === "albums") return "Albums"
      const album = getFolder(selectedAlbumId)
      return album ? `${album.title}, ${pluralTracks(album.trackCount)}` : "Album"
    }

    // ---------- wheel geometry (shared by desktop + mobile) ----------
    let currentRadius = 900
    let currentCenterProtrusion = 96
    // Additional, view-dependent vertical shift applied on top of the
    // arc's own d*ROW_HEIGHT math. Desktop (wheel mode) only -- mobile
    // (list mode) has no per-row transform at all. Zero in albums
    // view; negative (shifts up) in album view.
    let currentCenterYOffset = 0

    // Desktop (wheel mode) only: computes the arc geometry and syncs
    // row/docked-header width and offset from the measured container.
    // Mobile (list mode) is pure CSS -- full-width rows, no per-row
    // JS sizing at all -- so this clears rather than sets those same
    // inline properties there, in case a prior desktop pass left them
    // behind after a resize across the breakpoint.
    function recomputeGeometry() {
      if (isMobileMode()) {
        rowEls.forEach((row) => {
          row.style.width = ""
        })
        if (dockedHeaderEl) {
          dockedHeaderEl.style.width = ""
          dockedHeaderEl.style.marginLeft = ""
        }
        return
      }

      const containerWidth = wheelEl!.clientWidth || 600
      const containerHeight = wheelEl!.clientHeight || 600
      const rowWidth = Math.max(280, containerWidth * DESKTOP_ROW_WIDTH_RATIO)
      currentCenterProtrusion = Math.max(0, containerWidth - rowWidth - EDGE_PADDING)
      currentRadius = containerWidth * DESKTOP_RADIUS_RATIO

      rowEls.forEach((row) => {
        row.style.width = `${rowWidth}px`
      })
      if (dockedHeaderEl) dockedHeaderEl.style.width = `${rowWidth}px`

      currentCenterYOffset =
        view === "album" ? containerHeight * (ALBUM_CENTER_Y_RATIO - 0.5) : 0

      // The docked header's left edge tracks the row shape language's
      // own anchor point: the center slot's rendered left edge
      // (translateX(currentCenterProtrusion), where the selected row
      // sits at d=0) -- the same resting position the row it morphed
      // from already sits at, so the View Transition has no
      // width/position snap to paper over.
      if (dockedHeaderEl) {
        dockedHeaderEl.style.marginLeft = `${Math.max(0, currentCenterProtrusion)}px`
      }
    }

    function computeRowTransform(d: number) {
      const y = d * ROW_HEIGHT
      const protrusion = Math.sqrt(
        Math.max(currentRadius * currentRadius - y * y, 0),
      )
      const x = Math.max(0, protrusion - currentRadius + currentCenterProtrusion)
      const absD = Math.abs(d)
      const scale = Math.max(1 - absD * SCALE_FALLOFF, SCALE_FLOOR)
      const opacity = Math.max(1 - absD * OPACITY_FALLOFF, OPACITY_FLOOR)
      return { x, scale, opacity }
    }

    // Desktop (wheel mode) only -- mobile (list mode) lays rows out in
    // normal document flow with no per-row transform/opacity at all,
    // so it has no equivalent of this function.
    function applyDesktopFrame() {
      for (let i = 0; i < rowEls.length; i++) {
        const row = rowEls[i]
        const d = i - wheelPosition
        if (Math.abs(d) > RENDER_WINDOW) {
          row.style.opacity = "0"
          row.style.pointerEvents = "none"
          continue
        }
        const { x, scale, opacity } = computeRowTransform(d)
        const y = d * ROW_HEIGHT + currentCenterYOffset
        row.style.transform = `translate(${x}px, ${y}px) scale(${scale})`
        row.style.opacity = String(opacity)
        row.style.pointerEvents = "auto"
        row.style.zIndex = String(1000 - Math.round(Math.abs(d)))
      }
    }

    // ---------- desktop animation loop (time-based easing, in-place nav only) ----------
    function tickAnimation(now: number) {
      const dt = Math.min((now - lastFrameTime) / 1000, 0.1)
      lastFrameTime = now
      const t = prefersReducedMotion()
        ? 1
        : 1 - Math.exp(-EASE_DECAY_RATE * dt)
      wheelPosition += (targetIndex - wheelPosition) * t
      if (Math.abs(targetIndex - wheelPosition) < SNAP_EPSILON) {
        wheelPosition = targetIndex
        applyDesktopFrame()
        animating = false
        return
      }
      applyDesktopFrame()
      requestAnimationFrame(tickAnimation)
    }

    function startDesktopAnimation() {
      if (animating) return
      animating = true
      lastFrameTime = performance.now()
      requestAnimationFrame(tickAnimation)
    }

    // ---------- fixed-duration sweep (level transitions only) ----------
    function cancelSweep() {
      if (sweepRafId !== null) {
        cancelAnimationFrame(sweepRafId)
        sweepRafId = null
      }
    }

    function animateSweep(
      from: number,
      to: number,
      durationMs: number,
      onDone: () => void,
    ) {
      cancelSweep()
      const start = performance.now()
      function frame(now: number) {
        const t = Math.min((now - start) / durationMs, 1)
        const eased = 1 - Math.pow(1 - t, 3)
        wheelPosition = from + (to - from) * eased
        applyDesktopFrame()
        if (t < 1) {
          sweepRafId = requestAnimationFrame(frame)
        } else {
          sweepRafId = null
          onDone()
        }
      }
      sweepRafId = requestAnimationFrame(frame)
    }

    // Desktop only: selectIndex() (and so this) is never reached on
    // mobile anymore -- taps play directly, scrolling no longer
    // selects anything, and arrow keys are ignored in list mode.
    function syncVisualPosition() {
      startDesktopAnimation()
    }

    // ---------- Web Audio ----------
    let audioCtx: AudioContext | null = null

    function ensureAudioContext(): AudioContext | null {
      const AC = window.AudioContext
      if (!AC) return null
      if (!audioCtx) audioCtx = new AC()
      return audioCtx
    }

    function resumeAudioContext() {
      ensureAudioContext()?.resume().catch(() => {})
    }
    document.addEventListener("click", resumeAudioContext, { once: true })
    document.addEventListener("keydown", resumeAudioContext, { once: true })

    function isSfxMuted(): boolean {
      try {
        return localStorage.getItem("concept-sfx-muted") === "true"
      } catch {
        return false
      }
    }
    function setSfxMuted(muted: boolean) {
      try {
        localStorage.setItem("concept-sfx-muted", String(muted))
      } catch {
        // private mode / storage disabled -- ignore, just won't persist
      }
    }

    function playTick() {
      if (isSfxMuted()) return
      const ctx = audioCtx
      if (!ctx || ctx.state !== "running") return // e.g. first-ever gesture was a scroll; no-op gracefully
      const now = ctx.currentTime
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()
      osc.type = "triangle"
      osc.frequency.setValueAtTime(700, now)
      osc.frequency.exponentialRampToValueAtTime(1000, now + 0.015)
      gain.gain.setValueAtTime(0.0001, now)
      gain.gain.exponentialRampToValueAtTime(0.16, now + 0.002)
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.08)
      osc.connect(gain)
      gain.connect(ctx.destination)
      osc.start(now)
      osc.stop(now + 0.09)
    }

    function playLevelSound(kind: "open" | "close") {
      if (isSfxMuted()) return
      const ctx = audioCtx
      if (!ctx || ctx.state !== "running") return
      const now = ctx.currentTime
      const freqs = kind === "open" ? [600, 900] : [900, 600]
      freqs.forEach((freq, i) => {
        const osc = ctx.createOscillator()
        const gain = ctx.createGain()
        osc.type = "triangle"
        const t0 = now + i * 0.045
        osc.frequency.setValueAtTime(freq, t0)
        gain.gain.setValueAtTime(0.0001, t0)
        gain.gain.exponentialRampToValueAtTime(0.14, t0 + 0.004)
        gain.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.07)
        osc.connect(gain)
        gain.connect(ctx.destination)
        osc.start(t0)
        osc.stop(t0 + 0.08)
      })
    }

    function updateSfxToggleLabel() {
      if (sfxToggleState) sfxToggleState.textContent = isSfxMuted() ? "Off" : "On"
    }
    updateSfxToggleLabel()
    sfxToggleBtn?.addEventListener("click", () => {
      setSfxMuted(!isSfxMuted())
      updateSfxToggleLabel()
    })

    // ---------- playback ----------
    function currentItem(): WheelItem | undefined {
      return visibleEntries[selectedIndex]?.item
    }

    // Whatever's actually loaded, independent of any cursor -- mobile
    // has no cursor to compare against, so its highlight/aria-current/
    // status-icon state all key off this instead of currentItem().
    function findActiveTrack(): TrackItem | undefined {
      if (!activeAudioUrl) return undefined
      return Object.values(itemsById).find(
        (i) => i.kind === "track" && i.audioUrl === activeAudioUrl,
      ) as TrackItem | undefined
    }

    function isFolderPlaying(folder: FolderItem): boolean {
      return (
        activePlaying &&
        !!activeAudioUrl &&
        folder.trackIds.some(
          (id) => (itemsById[id] as TrackItem).audioUrl === activeAudioUrl,
        )
      )
    }

    // Index (within the CURRENT view's visibleEntries) of whatever's
    // playing -- the track itself in album view, or the folder that
    // contains it in albums view (rows there are folders, not tracks).
    // Used to re-derive desktop's cursor after a mobile->desktop
    // crossing, and to know what to scroll into view on mobile
    // (entering an album, or crossing desktop->mobile).
    function findActiveEntryIndex(): number {
      if (!activeAudioUrl) return -1
      if (view === "albums") {
        const playingTrack = findActiveTrack()
        if (!playingTrack) return -1
        return visibleEntries.findIndex(
          (e) => e.item.id === playingTrack.parentFolderId,
        )
      }
      return visibleEntries.findIndex(
        (e) => e.item.kind === "track" && e.item.audioUrl === activeAudioUrl,
      )
    }

    function getSelectedPlaybackState(): "idle" | "playing" | "paused" {
      if (isMobileMode()) {
        if (!activeAudioUrl) return "idle"
        return activePlaying ? "playing" : "paused"
      }
      const item = currentItem()
      if (!item || item.kind !== "track" || item.audioUrl !== activeAudioUrl)
        return "idle"
      return activePlaying ? "playing" : "paused"
    }

    function buildFolderQueue(folder: FolderItem): QueueTrack[] {
      return folder.trackIds.map((id) => {
        const t = itemsById[id] as TrackItem
        return {
          title: t.title,
          album: t.album,
          albumId: t.albumId,
          audioUrl: t.audioUrl,
        }
      })
    }

    function playTrack(track: TrackItem) {
      if (track.audioUrl === activeAudioUrl) {
        document.dispatchEvent(new CustomEvent("player:toggle"))
        return
      }
      const folder = itemsById[track.parentFolderId] as FolderItem | undefined
      if (!folder) return
      const queue = buildFolderQueue(folder)
      const index = folder.trackIds.indexOf(track.id)
      document.dispatchEvent(
        new CustomEvent("player:play", {
          detail: { queue, index: Math.max(0, index) },
        }),
      )
    }

    function playAlbum(folder: FolderItem, startIndex = 0) {
      const queue = buildFolderQueue(folder)
      document.dispatchEvent(
        new CustomEvent("player:play", { detail: { queue, index: startIndex } }),
      )
    }

    function playCurrent() {
      const item = currentItem()
      if (!item) return
      if (item.kind === "track") {
        playTrack(item)
      } else if (view === "albums") {
        playAlbum(item, 0)
      }
    }

    // Shared by the mini player's next button and the expanded
    // player's prev/next buttons (and, in spirit, Media Session's
    // handlers -- those live in PlayerBar.astro itself and mirror
    // this same non-wrapping/restart shape independently, since this
    // page never touches #player-audio to share the logic directly).
    // player:seek requests a restart (time 0) rather than this page
    // setting currentTime itself -- it never touches the audio
    // element, per the source-of-truth boundary for this task.
    function handleNextClick() {
      if (!activeAudioUrl) return
      if (!hasNext) {
        document.dispatchEvent(
          new CustomEvent("player:seek", { detail: { time: 0 } }),
        )
        return
      }
      document.dispatchEvent(new CustomEvent("player:next"))
    }

    function handlePrevClick() {
      if (!activeAudioUrl) return
      if (lastKnownCurrentTime > 3 || !hasPrevious) {
        document.dispatchEvent(
          new CustomEvent("player:seek", { detail: { time: 0 } }),
        )
        return
      }
      document.dispatchEvent(new CustomEvent("player:prev"))
    }

    // Fires in albums view (desktop and mobile) and, on mobile only,
    // in album view too -- the folder-summary hero is reused there
    // (see updateHero()) rather than showing the per-track hero.
    // Toggles rather than restarts if this album is already playing.
    albumsHeroPlayBtn?.addEventListener("click", () => {
      const showingFolderHero =
        view === "albums" || (isMobileMode() && view === "album")
      if (!showingFolderHero) return
      const folder = getFolder(selectedAlbumId)
      if (!folder) return
      if (isFolderPlaying(folder)) {
        document.dispatchEvent(new CustomEvent("player:toggle"))
      } else {
        playAlbum(folder, 0)
      }
    })
    trackHeroPlayBtn?.addEventListener("click", playCurrent)

    // Mini player (mobile only in practice -- hidden on desktop by its
    // own CSS, but the logic doesn't need to care about platform: it's
    // always gated on activeAudioUrl existing).
    miniPlayerPlayBtn?.addEventListener("click", () => {
      if (activeAudioUrl) document.dispatchEvent(new CustomEvent("player:toggle"))
    })
    miniPlayerNextBtn?.addEventListener("click", handleNextClick)
    miniPlayerEl?.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("button")) return
      if (!activeAudioUrl) return
      openExpandedPlayer()
    })

    function refreshPlaybackUI() {
      const mobile = isMobileMode()

      // Track rows (album view): icon reflects the actually-loaded/
      // playing state for that exact audioUrl. On mobile, this exact
      // same match also drives the row's highlight/aria-current/
      // accessible name -- there's no cursor there, so "selected"
      // means "playing," not "focused."
      rowEls.forEach((row) => {
        const icon = row.querySelector<HTMLSpanElement>(".ic-track-icon")
        const isActiveAudio =
          !!activeAudioUrl && row.dataset.audioUrl === activeAudioUrl
        const isPlayingHere = isActiveAudio && activePlaying
        row.classList.toggle("is-active-audio", isActiveAudio)
        if (icon) {
          icon.className =
            "ic-track-icon " + (isPlayingHere ? "ic-pause-mini" : "ic-play-mini")
        }
        if (mobile && row.dataset.audioUrl) {
          row.classList.toggle("is-selected", isActiveAudio)
          if (isActiveAudio) row.setAttribute("aria-current", "true")
          else row.removeAttribute("aria-current")
          const title = row.querySelector<HTMLElement>(".row-title")?.textContent ?? ""
          row.setAttribute("aria-label", isPlayingHere ? `Pause ${title}` : `Play ${title}`)
        }
      })

      // Album rows (albums view): a quiet indicator on whichever album
      // contains the actively PLAYING (not merely loaded/paused) track.
      if (view === "albums") {
        const playingTrack = activePlaying ? findActiveTrack() : undefined
        rowEls.forEach((row) => {
          const dot = row.querySelector<HTMLElement>(".row-playing-dot")
          if (!dot) return
          dot.hidden = !(playingTrack && row.dataset.id === playingTrack.parentFolderId)
        })
      }

      const state = getSelectedPlaybackState()
      const isPlaying = state === "playing"

      // Folder-summary hero's play button: shown in albums view
      // always, and in album view on mobile too (see updateHero()).
      const showingFolderHero = view === "albums" || (mobile && view === "album")
      if (showingFolderHero) {
        const folder = getFolder(selectedAlbumId)
        const folderPlaying = folder ? isFolderPlaying(folder) : false
        if (albumsHeroPlayIcon)
          albumsHeroPlayIcon.className =
            "ic-hero-icon " + (folderPlaying ? "ic-pause-mini" : "ic-play-mini")
        albumsHeroPlayBtn?.setAttribute(
          "aria-label",
          folderPlaying ? "Pause album" : "Play album",
        )
      }

      if (trackHeroPlayIcon)
        trackHeroPlayIcon.className =
          "ic-hero-icon " + (isPlaying ? "ic-pause-mini" : "ic-play-mini")
      trackHeroPlayBtn?.setAttribute("aria-label", isPlaying ? "Pause" : "Play")

      // Mini player + expanded player: only ever visible once
      // something has actually loaded -- never show a button that
      // would do nothing yet. Only ever visible on mobile in practice
      // (desktop's own CSS keeps .mini-player hidden regardless), but
      // this logic doesn't need to care -- it's always gated on
      // activeAudioUrl existing, same as the rest of this function.
      const activeTrack = findActiveTrack()
      if (miniPlayerEl) miniPlayerEl.hidden = !activeAudioUrl
      if (activeTrack) {
        if (miniPlayerTitle) miniPlayerTitle.textContent = activeTrack.title
        if (miniPlayerAlbum) miniPlayerAlbum.textContent = activeTrack.album ?? ""
      }
      if (miniPlayerPlayIcon) {
        miniPlayerPlayIcon.className =
          "ic-mini-player-icon " + (isPlaying ? "ic-pause-mini" : "ic-play-mini")
      }
      miniPlayerPlayBtn?.setAttribute("aria-label", isPlaying ? "Pause" : "Play")
      // Still clickable when there's no next track (it restarts
      // instead of advancing, see handleNextClick()) -- dimmed, not
      // disabled.
      miniPlayerNextBtn?.classList.toggle("is-inactive", !hasNext)

      updateExpandedPlayerContent()
      if (expandedPlayIcon) {
        expandedPlayIcon.className =
          "ic-expanded-play-icon " + (isPlaying ? "ic-pause-mini" : "ic-play-mini")
      }
      expandedPlayBtn?.setAttribute("aria-label", isPlaying ? "Pause" : "Play")
      expandedPrevBtn?.classList.toggle("is-inactive", !hasPrevious && lastKnownCurrentTime <= 3)
      expandedNextBtn?.classList.toggle("is-inactive", !hasNext)
    }

    // Keeps the expanded player's static content (title/meta/source
    // label) in sync with whatever's playing regardless of whether
    // it's currently open, so it's already correct the moment it does
    // open. Time-based content (elapsed/remaining/seek position) is
    // handled separately by the player:progress listener.
    function updateExpandedPlayerContent() {
      const track = findActiveTrack()
      if (!track) return
      if (expandedSourceLabel) {
        expandedSourceLabel.textContent = track.album ? `Playing from ${track.album}` : ""
      }
      if (expandedTitle) expandedTitle.textContent = track.title
      if (expandedSubtitle) {
        const parts = [track.album, track.trackNumber ? `Track ${track.trackNumber}` : null]
        expandedSubtitle.textContent = parts.filter(Boolean).join(" · ")
      }
      if (expandedPlayerEl) expandedPlayerEl.setAttribute("aria-label", track.title)
    }

    // ---------- expanded player: modal dialog behavior ----------
    // Everything outside #expanded-player while it's open -- the
    // fixed top row and the scrolling hero/list/mini-player content.
    // Marked inert (removed from the a11y tree and from hit-testing)
    // for the duration; .mini-player is included since it's a fixed
    // sibling that would otherwise still be reachable/tappable
    // underneath the overlay.
    function setInertOutsideExpanded(makeInert: boolean) {
      ;[topRowEl, wheelGridEl, miniPlayerEl].forEach((el) => {
        if (!el) return
        if (makeInert) el.setAttribute("inert", "")
        else el.removeAttribute("inert")
      })
    }

    function getFocusableInExpanded(): HTMLElement[] {
      if (!expandedPlayerEl) return []
      return Array.from(
        expandedPlayerEl.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
        ),
      ).filter((el) => !el.hasAttribute("hidden"))
    }

    // Capturing so it runs before the target's own Tab handling --
    // only ever registered while the dialog is open (added in
    // showExpandedPlayerUI(), removed in hideExpandedPlayerUI()).
    function trapExpandedFocus(event: KeyboardEvent) {
      if (event.key !== "Tab") return
      const focusable = getFocusableInExpanded()
      if (focusable.length === 0) return
      const first = focusable[0]
      const last = focusable[focusable.length - 1]
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault()
        last.focus()
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault()
        first.focus()
      }
    }

    function showExpandedPlayerUI() {
      if (!expandedPlayerEl) return
      lastFocusedBeforeExpand = document.activeElement as HTMLElement | null
      updateExpandedPlayerContent()
      updateProgressUI()
      expandedPlayerEl.hidden = false
      setInertOutsideExpanded(true)
      document.addEventListener("keydown", trapExpandedFocus, true)
      const reveal = () => {
        expandedPlayerEl!.classList.add("is-open")
        expandedCloseBtn?.focus()
      }
      if (prefersReducedMotion()) reveal()
      else requestAnimationFrame(reveal)
    }

    function hideExpandedPlayerUI() {
      if (!expandedPlayerEl) return
      expandedPlayerOpen = false
      expandedPlayerEl.classList.remove("is-open")
      expandedPlayerEl.style.transform = ""
      setInertOutsideExpanded(false)
      document.removeEventListener("keydown", trapExpandedFocus, true)
      const finish = () => {
        if (expandedPlayerEl) expandedPlayerEl.hidden = true
        ;(lastFocusedBeforeExpand ?? miniPlayerEl)?.focus()
        lastFocusedBeforeExpand = null
      }
      if (prefersReducedMotion()) finish()
      else window.setTimeout(finish, EXPANDED_PLAYER_TRANSITION_MS)
    }

    // Opens by pushing a history entry on the CURRENT url (no ?player=
    // param -- see the merge-debt/history note at the top of this
    // script) so the phone back gesture closes the player instead of
    // leaving the album. Preserves whatever's already in history.state
    // (the album drill-down's own albumId/pushedByApp) so back, after
    // closing the player, lands exactly where it already was.
    function openExpandedPlayer() {
      if (!expandedPlayerEl || expandedPlayerOpen || !activeAudioUrl) return
      expandedPlayerOpen = true
      const baseState = (history.state as Record<string, unknown> | null) ?? {}
      history.pushState({ ...baseState, player: true, pushedByApp: true }, "", location.href)
      showExpandedPlayerUI()
    }

    // The one path every user-initiated close (chevron, swipe,
    // Escape) goes through -- always closes via history.back() so the
    // stack stays consistent with however it was opened; popstate
    // does the actual hideExpandedPlayerUI(). Falls back to a direct
    // hide only if history.state somehow doesn't have the player flag
    // (shouldn't happen in normal use).
    function closeExpandedPlayerViaHistory() {
      if (!expandedPlayerOpen) return
      if ((history.state as { player?: boolean } | null)?.player) {
        history.back()
      } else {
        hideExpandedPlayerUI()
      }
    }

    expandedCloseBtn?.addEventListener("click", closeExpandedPlayerViaHistory)
    expandedPrevBtn?.addEventListener("click", handlePrevClick)
    expandedPlayBtn?.addEventListener("click", () => {
      if (activeAudioUrl) document.dispatchEvent(new CustomEvent("player:toggle"))
    })
    expandedNextBtn?.addEventListener("click", handleNextClick)

    // While dragging, update the labels/thumb position live but only
    // commit a seek (player:seek) on release -- incoming
    // player:progress updates are ignored for the same span
    // (expandedSeekDragging), so the drag never fights a stray
    // progress tick landing mid-gesture.
    expandedSeek?.addEventListener("input", () => {
      expandedSeekDragging = true
      const seconds = Number(expandedSeek!.value) / 1000
      if (expandedElapsed) expandedElapsed.textContent = formatTime(seconds)
      if (expandedRemaining) {
        const remaining = Math.max(0, lastKnownDuration - seconds)
        expandedRemaining.textContent = `-${formatTime(remaining)}`
      }
      setExpandedSeekProgress()
    })
    expandedSeek?.addEventListener("change", () => {
      const seconds = Number(expandedSeek!.value) / 1000
      document.dispatchEvent(new CustomEvent("player:seek", { detail: { time: seconds } }))
      expandedSeekDragging = false
    })

    // Swipe-down-to-close: ignores gestures starting on the seek
    // slider or a button (their own interactions take priority), lets
    // the overlay follow the finger live, and either commits to
    // closing (past SWIPE_CLOSE_THRESHOLD) or snaps back on release.
    let swipeActive = false
    let swipeStartY = 0
    let swipeCurrentY = 0

    expandedPlayerEl?.addEventListener("pointerdown", (event) => {
      const target = event.target as HTMLElement
      if (target.closest("input, button, a")) return
      swipeActive = true
      swipeStartY = event.clientY
      swipeCurrentY = event.clientY
      expandedPlayerEl.style.transition = "none"
    })
    expandedPlayerEl?.addEventListener("pointermove", (event) => {
      if (!swipeActive || !expandedPlayerEl) return
      swipeCurrentY = event.clientY
      const dy = Math.max(0, swipeCurrentY - swipeStartY)
      expandedPlayerEl.style.transform = `translateY(${dy}px)`
    })
    function endSwipe() {
      if (!swipeActive || !expandedPlayerEl) return
      swipeActive = false
      expandedPlayerEl.style.transition = ""
      const dy = swipeCurrentY - swipeStartY
      expandedPlayerEl.style.transform = ""
      if (dy > SWIPE_CLOSE_THRESHOLD) closeExpandedPlayerViaHistory()
    }
    expandedPlayerEl?.addEventListener("pointerup", endSwipe)
    expandedPlayerEl?.addEventListener("pointercancel", endSwipe)

    document.addEventListener("player:state", ((event: CustomEvent) => {
      const detail = event.detail ?? {}
      activeAudioUrl = detail.audioUrl ?? null
      activePlaying = !!detail.playing
      hasPrevious = !!detail.hasPrevious
      hasNext = !!detail.hasNext
      refreshPlaybackUI()
    }) as EventListener)

    // The only source this page has for "current playback position" --
    // it never reads #player-audio directly. Drives the mini player's
    // progress line and (unless the user is actively dragging it) the
    // expanded player's seek position/time labels.
    document.addEventListener("player:progress", ((event: CustomEvent) => {
      const detail = event.detail ?? {}
      lastKnownCurrentTime =
        typeof detail.currentTime === "number" ? detail.currentTime : 0
      lastKnownDuration =
        typeof detail.duration === "number" && Number.isFinite(detail.duration)
          ? detail.duration
          : 0
      updateProgressUI()
    }) as EventListener)

    function formatTime(seconds: number) {
      if (!Number.isFinite(seconds) || seconds < 0) return "0:00"
      const m = Math.floor(seconds / 60)
      const s = Math.floor(seconds % 60)
      return `${m}:${s < 10 ? "0" : ""}${s}`
    }

    function setExpandedSeekProgress() {
      if (!expandedSeek) return
      const min = Number(expandedSeek.min) || 0
      const max = Number(expandedSeek.max) || 1
      const value = Number(expandedSeek.value)
      const pct = max > min ? ((value - min) / (max - min)) * 100 : 0
      expandedSeek.style.setProperty("--progress", `${pct}%`)
    }

    function updateProgressUI() {
      const pct =
        lastKnownDuration > 0 ? (lastKnownCurrentTime / lastKnownDuration) * 100 : 0
      if (miniPlayerProgress) miniPlayerProgress.style.width = `${pct}%`

      // The 3-second previous-track rule reads lastKnownCurrentTime
      // directly, but the inactive-state class needs refreshing on
      // every tick too, not just when player:state fires.
      expandedPrevBtn?.classList.toggle(
        "is-inactive",
        !hasPrevious && lastKnownCurrentTime <= 3,
      )

      if (expandedSeekDragging) return // never fight the user's drag
      if (expandedSeek) {
        expandedSeek.max = String(Math.max(1, Math.floor(lastKnownDuration * 1000)))
        expandedSeek.value = String(Math.floor(lastKnownCurrentTime * 1000))
        setExpandedSeekProgress()
      }
      if (expandedElapsed) expandedElapsed.textContent = formatTime(lastKnownCurrentTime)
      if (expandedRemaining) {
        const remaining = Math.max(0, lastKnownDuration - lastKnownCurrentTime)
        expandedRemaining.textContent = `-${formatTime(remaining)}`
      }
    }

    // ---------- hero / stats ----------
    function renderGenres(track: TrackItem) {
      if (!statsGenres) return
      statsGenres.innerHTML = ""
      if (track.genres && track.genres.length > 0) {
        track.genres.forEach((genre, i) => {
          const source = genreChipTemplate?.content.firstElementChild
          if (!source) return
          const chip = source.cloneNode(true) as HTMLSpanElement
          if (i === 0) chip.classList.add("is-primary")
          chip.textContent = genre
          statsGenres.appendChild(chip)
        })
      } else {
        const source = genreEmptyTemplate?.content.firstElementChild
        if (source) statsGenres.appendChild(source.cloneNode(true))
      }
    }

    // The folder-summary hero (title/year/count/duration/"Play album")
    // is shown in albums view on both platforms, AND reused in album
    // view on mobile -- selectedAlbumId already points at the right
    // folder either way (the browsing target, or the open album), so
    // no separate lookup is needed for the mobile case. Desktop's
    // per-track hero only ever shows in desktop's own album view.
    function updateHero() {
      const mobile = isMobileMode()
      // Mobile: folder-summary hero only in album view (merged with
      // the back button into one header there); nothing at all in
      // albums view ("no hero card... just a small 'Albums' label,
      // then the list"). Desktop: unchanged, folder hero in albums
      // view, per-track hero in album view.
      const showFolderHero = mobile ? view === "album" : view === "albums"
      const showTrackHero = view === "album" && !mobile

      // .left-col itself (not just its two hero-view children) is
      // hidden in mobile albums view -- otherwise .hero's own
      // padding/background still renders as an empty box even with
      // both children hidden.
      if (leftCol) leftCol.hidden = mobile && view === "albums"
      if (heroAlbumsView) heroAlbumsView.hidden = !showFolderHero
      if (heroAlbumView) heroAlbumView.hidden = !showTrackHero
      if (statsEl) statsEl.hidden = !showTrackHero
      if (mobileHeroBack) mobileHeroBack.hidden = !(mobile && view === "album")

      if (showFolderHero) {
        const folder = getFolder(selectedAlbumId)
        if (folder) {
          if (albumsHeroTitle) albumsHeroTitle.textContent = folder.title
          if (albumsHeroYear) {
            // Hidden (not just emptied) when there's no year -- an
            // empty-but-present flex item still claims a gap before
            // the next one, which read as the meta row being indented.
            const yearLabel = folderYearLabel(folder)
            albumsHeroYear.textContent = yearLabel
            albumsHeroYear.hidden = !yearLabel
          }
          if (albumsHeroCount)
            albumsHeroCount.textContent = pluralTracks(folder.trackCount)
          if (albumsHeroDuration)
            albumsHeroDuration.textContent = folder.totalDuration ?? "—"
        }
      }
      if (showTrackHero) {
        const track = selectedTrackId
          ? (itemsById[selectedTrackId] as TrackItem | undefined)
          : undefined
        if (track) {
          if (trackHeroTitle) trackHeroTitle.textContent = track.title
          if (trackHeroNumber)
            trackHeroNumber.textContent = track.trackNumber
              ? String(track.trackNumber)
              : "—"
          if (trackHeroDuration) trackHeroDuration.textContent = track.duration ?? "—"
          if (statsBpm) {
            const hasBpm = track.bpm != null
            statsBpm.textContent = hasBpm ? String(track.bpm) : "—"
            statsBpm.classList.toggle("is-empty", !hasBpm)
          }
          renderGenres(track)
        }
      }

      refreshPlaybackUI()
    }

    // Same slug-safety net as folder/track item ids -- album ids come
    // straight from content-collection slugs, which should already be
    // identifier-safe, but view-transition-name is a CSS custom-ident
    // and this keeps it that way regardless.
    function albumMorphName(albumId: string) {
      return `album-header-${albumId.replace(/[^a-zA-Z0-9_-]/g, "-")}`
    }

    function updateDockedHeader(folder: FolderItem) {
      if (!dockedHeaderEl) return
      const titleEl = dockedHeaderEl.querySelector<HTMLElement>(".row-title")
      const metaEl = dockedHeaderEl.querySelector<HTMLElement>(".row-album")
      if (titleEl) titleEl.textContent = folder.title
      if (metaEl) {
        metaEl.textContent = [
          folderYearLabel(folder),
          pluralTracks(folder.trackCount),
          folder.totalDuration,
        ]
          .filter(Boolean)
          .join(" · ")
      }
      dockedHeaderEl.setAttribute(
        "aria-label",
        `Back to albums, ${folder.title}, ${pluralTracks(folder.trackCount)}`,
      )
    }

    function cancelTopSlotFade() {
      if (topSlotFadeRafId !== null) {
        cancelAnimationFrame(topSlotFadeRafId)
        topSlotFadeRafId = null
      }
      if (topSlotFadeTimeoutId !== null) {
        window.clearTimeout(topSlotFadeTimeoutId)
        topSlotFadeTimeoutId = null
      }
    }

    // Fallback only (no View Transitions support, motion allowed): a
    // plain opacity crossfade between the "Albums" label and the
    // docked header, since there's no morph animation to carry the
    // handoff instead. Same "unhide, one rAF later start the fade,
    // hide the other side once its own timeout fires" shape as the
    // rest of this page's hidden+opacity elements.
    function crossfadeTopSlot(target: "albums" | "album") {
      const incoming = target === "album" ? dockedHeaderEl : wheelTopLabel
      const outgoing = target === "album" ? wheelTopLabel : dockedHeaderEl
      if (!incoming || !outgoing) return

      cancelTopSlotFade()
      incoming.hidden = false
      topSlotFadeRafId = requestAnimationFrame(() => {
        topSlotFadeRafId = null
        incoming.classList.add("is-active")
        outgoing.classList.remove("is-active")
        topSlotFadeTimeoutId = window.setTimeout(() => {
          topSlotFadeTimeoutId = null
          outgoing.hidden = true
        }, TOP_SLOT_FADE_MS)
      })
    }

    // Non-animated hide/show for the label vs. docked header -- used
    // both under prefers-reduced-motion and inside a View Transition
    // callback, where the morph itself (or the reduced-motion instant
    // cut) is the only visible change; a CSS opacity fade layered on
    // top would either be invisible (VT freezes the live DOM for its
    // duration) or actively wrong (reduced motion).
    function applyTopSlotVisibility(target: "albums" | "album") {
      cancelTopSlotFade()
      if (wheelTopLabel) {
        wheelTopLabel.hidden = target !== "albums"
        wheelTopLabel.classList.toggle("is-active", target === "albums")
      }
      if (dockedHeaderEl) {
        dockedHeaderEl.hidden = target !== "album"
        dockedHeaderEl.classList.toggle("is-active", target === "album")
      }
    }

    // Mobile only: the docked header (row<->header View Transition
    // morph) is a desktop-only concept now -- its mobile equivalent is
    // the merged album-summary hero + back button instead (see
    // updateHero()), so this only ever shows the "Albums" label, and
    // only in albums view; nothing shows in the top slot at all in
    // album view (avoiding a stray gap from an otherwise-empty slot).
    // Called from rebuildForCurrentView() so it's correct after every
    // entry path -- level transitions on both directions, and the
    // deep-link/popstate initial-paint case that never goes through
    // runLevelTransition() at all.
    function applyMobileTopSlot() {
      if (!isMobileMode()) return
      if (wheelTopLabel) wheelTopLabel.hidden = view !== "albums"
      if (dockedHeaderEl) dockedHeaderEl.hidden = true
      if (wheelTopSlot) wheelTopSlot.hidden = view !== "albums"
    }

    // Wraps a doSwap in a View Transition when supported, tagging
    // morph.oldEl (captured before the callback runs) and whatever
    // morph.getNewEl() resolves to once doSwap has rebuilt the DOM
    // (captured after) with the same view-transition-name, so the
    // browser morphs position/size/content between them instead of a
    // plain cut. Falls back to calling doSwap directly, synchronously,
    // when the API is unsupported.
    function startMorphTransition(
      token: number,
      doSwap: () => void,
      morph: MorphSpec,
      onComplete: () => void,
    ) {
      const startViewTransition = (
        document as unknown as {
          startViewTransition?: (cb: () => void) => ViewTransitionLike
        }
      ).startViewTransition
      if (!startViewTransition) {
        doSwap()
        onComplete()
        return
      }
      if (morph.oldEl) morph.oldEl.style.viewTransitionName = morph.name
      let newEl: HTMLElement | null = null
      const vt = startViewTransition.call(document, () => {
        doSwap()
        newEl = morph.getNewEl()
        if (newEl) newEl.style.viewTransitionName = morph.name
      })
      activeViewTransition = vt
      vt.finished.finally(() => {
        if (morph.oldEl) morph.oldEl.style.viewTransitionName = ""
        if (newEl) (newEl as HTMLElement).style.viewTransitionName = ""
        if (activeViewTransition === vt) activeViewTransition = null
        if (token === transitionToken) onComplete()
      })
    }

    // Desktop only: the cursor's aria-activedescendant/aria-selected/
    // .is-selected. Mobile has no cursor, so its equivalent (aria-current/
    // .is-selected, driven by what's actually playing) lives in
    // refreshPlaybackUI() instead, reacting to playback rather than a
    // selection event -- this just clears the desktop-only attribute
    // there so it can't linger stale.
    function updateAriaSelected() {
      if (isMobileMode()) {
        wheelEl!.removeAttribute("aria-activedescendant")
        return
      }
      const entry = visibleEntries[selectedIndex]
      wheelEl!.setAttribute(
        "aria-activedescendant",
        entry ? `wheel-item-${entry.item.id}` : "",
      )
      rowEls.forEach((row, i) => {
        const isSelected = i === selectedIndex
        row.setAttribute("aria-selected", isSelected ? "true" : "false")
        row.classList.toggle("is-selected", isSelected)
      })
    }

    // Sets the wheel/list container's and each row's role for the
    // current mode, plus the static (non-playback-dependent) half of
    // mobile's per-row accessible name -- folder rows' "Open {title}"
    // never changes, so it's set here rather than in
    // refreshPlaybackUI(), which only ever touches track rows.
    // Called after any (re)build of rowEls, and again when crossing
    // the breakpoint re-tags the existing rows in place.
    function applyModeRoles() {
      const mobile = isMobileMode()
      wheelEl!.setAttribute("role", mobile ? "list" : "listbox")
      rowEls.forEach((row, i) => {
        const entry = visibleEntries[i]
        row.setAttribute("role", mobile ? "listitem" : "option")
        if (mobile) {
          row.removeAttribute("aria-selected")
          if (entry?.item.kind === "folder") {
            row.setAttribute("aria-label", `Open ${entry.item.title}`)
          }
          // Track rows' aria-label (Play/Pause + title) and
          // aria-current are set reactively by refreshPlaybackUI(),
          // called right after this wherever this function is.
        } else {
          row.removeAttribute("aria-current")
          row.removeAttribute("aria-label")
        }
      })
    }

    // Mobile only: the top/bottom feather masks on the unified scroll
    // container only show once there's actually somewhere to scroll
    // to/from -- not at rest, and not tied to distance from a
    // selection (there isn't one). Driven by CSS custom properties on
    // .wheel-grid (see the mobile media query) so this never touches
    // row styles directly, just two classes on the scroll container
    // itself, rAF-throttled so a scroll event never re-triggers style
    // work more than once per frame.
    let scrollMaskRafPending = false
    function updateScrollMasks() {
      scrollMaskRafPending = false
      if (!wheelGridEl || !isMobileMode()) return
      const { scrollTop, scrollHeight, clientHeight } = wheelGridEl
      wheelGridEl.classList.toggle("show-top-fade", scrollTop > 0)
      wheelGridEl.classList.toggle(
        "show-bottom-fade",
        scrollTop + clientHeight < scrollHeight - 1,
      )
    }
    wheelGridEl?.addEventListener(
      "scroll",
      () => {
        if (scrollMaskRafPending) return
        scrollMaskRafPending = true
        requestAnimationFrame(updateScrollMasks)
      },
      { passive: true },
    )

    function announceSelection() {
      const entry = visibleEntries[selectedIndex]
      if (!entry || !announcer) return
      announcer.textContent = `${entry.item.title}, ${
        view === "albums" ? "album" : "track"
      } ${entry.posinset} of ${entry.setsize}`
    }

    function announceLevelChange() {
      if (!announcer) return
      announcer.textContent = currentViewLabel()
    }

    // ---------- row DOM ----------
    function createRowElement(entry: VisibleEntry): HTMLLIElement | null {
      const { item, posinset, setsize } = entry
      const template = item.kind === "folder" ? folderRowTemplate : trackRowTemplate
      const source = template?.content.firstElementChild
      if (!source) return null
      const li = source.cloneNode(true) as HTMLLIElement

      li.id = `wheel-item-${item.id}`
      li.setAttribute("aria-setsize", String(setsize))
      li.setAttribute("aria-posinset", String(posinset))
      li.dataset.id = item.id

      const titleEl = li.querySelector<HTMLSpanElement>(".row-title")
      const subEl = li.querySelector<HTMLSpanElement>(".row-album")
      const durEl = li.querySelector<HTMLSpanElement>(".row-duration")

      if (item.kind === "folder") {
        if (titleEl) titleEl.textContent = item.title
        if (subEl) subEl.textContent = folderYearLabel(item)
        if (durEl) durEl.textContent = pluralTracks(item.trackCount)
      } else {
        li.dataset.audioUrl = item.audioUrl
        if (titleEl) titleEl.textContent = item.title
        if (subEl) subEl.textContent = item.album ?? ""
        if (durEl) durEl.textContent = item.duration ?? ""
      }

      return li
    }

    function attachRowListeners() {
      rowEls.forEach((row, i) => {
        row.addEventListener("click", () => {
          if (transitionPhase !== "idle") return
          const entry = visibleEntries[i]
          if (!entry) return
          if (entry.item.kind === "folder") {
            beginEnterAlbum(entry.item.id)
          } else if (isMobileMode()) {
            // Direct play, no cursor/hero/tick/scroll side effects --
            // mobile has nothing for selectIndex() to drive.
            playTrack(entry.item)
          } else {
            selectIndex(i, { playNow: true })
          }
        })
      })
    }

    // ---------- rebuild: rebuilds the DOM/visible list for the current view ----------
    function rebuildForCurrentView() {
      const built = currentLevelEntries()
        .map((entry) => ({ entry, row: createRowElement(entry) }))
        .filter(
          (b): b is { entry: VisibleEntry; row: HTMLLIElement } =>
            b.row !== null,
        )
      visibleEntries = built.map((b) => b.entry)
      rowEls = built.map((b) => b.row)

      wheelEl!.innerHTML = ""
      rowEls.forEach((row) => wheelEl!.appendChild(row))

      const targetId = view === "albums" ? selectedAlbumId : selectedTrackId
      const newIndex = visibleEntries.findIndex((e) => e.item.id === targetId)
      selectedIndex = newIndex !== -1 ? newIndex : 0
      if (view === "albums") {
        selectedAlbumId = visibleEntries[selectedIndex]?.item.id ?? null
      } else {
        selectedTrackId = visibleEntries[selectedIndex]?.item.id ?? null
      }

      wheelPosition = selectedIndex
      targetIndex = selectedIndex

      recomputeGeometry()
      if (isMobileMode()) {
        // Entering (or deep-linking into) an album: reveal the
        // playing track if it's in here, instantly, no centering --
        // otherwise start at the top. Going back to albums: restore
        // the exact scroll position saved on the way in, rather than
        // scrolling to anything. Scrolls the unified scroll container
        // (.wheel-grid, hero+list together), not #wheel -- it's no
        // longer independently scrollable.
        if (view === "album") {
          const idx = findActiveEntryIndex()
          if (idx !== -1) {
            rowEls[idx]?.scrollIntoView({ block: "center", behavior: "auto" })
          } else if (wheelGridEl) {
            wheelGridEl.scrollTop = 0
          }
        } else if (wheelGridEl) {
          wheelGridEl.scrollTop = savedAlbumsScrollTop
        }
      } else {
        applyDesktopFrame()
      }

      wheelEl!.setAttribute("aria-label", currentViewLabel())
      applyModeRoles()
      applyMobileTopSlot()
      updateHero() // also calls refreshPlaybackUI(), which fills in
      // the dynamic half (track rows' Play/Pause label, aria-current)
      // of what applyModeRoles() just set the static half of
      updateAriaSelected()
      updateScrollMasks()

      attachRowListeners()
    }

    // ---------- URL / history ----------
    function updateUrlForAlbum(
      albumId: string | null,
      opts: { replace?: boolean } = {},
    ) {
      const url = new URL(location.href)
      if (albumId) url.searchParams.set("album", albumId)
      else url.searchParams.delete("album")
      const state = { albumId, pushedByApp: true }
      if (opts.replace) history.replaceState(state, "", url)
      else history.pushState(state, "", url)
    }

    // ---------- level transitions ----------
    // transitionPhase tracks how far the CURRENT transition has gotten,
    // independent of platform: "pre-swap" (old content still showing,
    // easing/fading out) -> "morphing" (doSwap has run, view/DOM
    // already reflect the new level, a View Transition may still be
    // animating the docked-header morph) -> "post-swap" (new content
    // showing, easing/fading in). transitionDirection tracks which
    // way: entering an album (+1) or going back (-1). Desktop drives
    // the sweep legs with animateSweep()/sweepRafId; mobile with a
    // plain opacity crossfade on a timer (mobileFadeTimeoutId); the
    // "morphing" leg (both platforms) with startMorphTransition()/
    // activeViewTransition. All three are cancelled together, and
    // transitionToken is bumped, so reversing mid-transition can never
    // leave a stale timer/rAF/VT-promise to fire later and collide
    // with whatever starts next.
    function cancelActiveTransition() {
      transitionToken++
      cancelSweep()
      if (mobileFadeTimeoutId !== null) {
        window.clearTimeout(mobileFadeTimeoutId)
        mobileFadeTimeoutId = null
      }
      if (activeViewTransition) {
        activeViewTransition.skipTransition()
        activeViewTransition = null
      }
    }

    function runLevelTransition(
      direction: 1 | -1,
      doSwap: () => void,
      morph: MorphSpec,
    ) {
      cancelActiveTransition()
      const token = transitionToken
      transitionDirection = direction

      if (prefersReducedMotion()) {
        doSwap() // rebuildForCurrentView() inside doSwap calls
        // applyMobileTopSlot(), so mobile needs nothing further here
        if (!isMobileMode()) {
          const targetView: "albums" | "album" = direction === 1 ? "album" : "albums"
          applyTopSlotVisibility(targetView)
        }
        transitionPhase = "idle"
        return
      }

      if (isMobileMode()) {
        // No docked-header morph on mobile at all -- that's a
        // desktop-only concept now (see applyMobileTopSlot(), always
        // called from doSwap's rebuildForCurrentView()). Just a plain
        // crossfade of the WHOLE scroll content (hero + top slot +
        // rows together, via wheelGridEl -- they all change together
        // now that they share one scroll container), never a View
        // Transition.
        transitionPhase = "pre-swap"
        if (wheelGridEl) wheelGridEl.style.opacity = "0"
        mobileFadeTimeoutId = window.setTimeout(() => {
          if (token !== transitionToken) return
          mobileFadeTimeoutId = null
          transitionPhase = "morphing"
          doSwap()
          transitionPhase = "post-swap"
          mobileFadeTimeoutId = window.setTimeout(() => {
            if (token !== transitionToken) return
            mobileFadeTimeoutId = null
            if (wheelGridEl) wheelGridEl.style.opacity = "1"
            transitionPhase = "idle"
          }, 20)
        }, MOBILE_FADE_MS)
        return
      }

      const supportsViewTransitions =
        typeof (document as unknown as { startViewTransition?: unknown })
          .startViewTransition === "function"
      const targetView: "albums" | "album" = direction === 1 ? "album" : "albums"

      transitionPhase = "pre-swap"
      const startPos = wheelPosition
      animateSweep(startPos, startPos + direction * SWEEP_OFFSET, SWEEP_LEG_MS, () => {
        if (token !== transitionToken) return
        transitionPhase = "morphing"
        let finalIndex = 0
        const wrappedSwap = () => {
          doSwap()
          finalIndex = selectedIndex
          wheelPosition = finalIndex + direction * SWEEP_OFFSET
          applyDesktopFrame()
        }
        const finish = () => {
          if (token !== transitionToken) return
          transitionPhase = "post-swap"
          animateSweep(wheelPosition, finalIndex, SWEEP_LEG_MS, () => {
            if (token !== transitionToken) return
            wheelPosition = finalIndex
            targetIndex = finalIndex
            transitionPhase = "idle"
          })
        }
        if (supportsViewTransitions) {
          startMorphTransition(
            token,
            () => {
              wrappedSwap()
              applyTopSlotVisibility(targetView)
            },
            morph,
            finish,
          )
        } else {
          wrappedSwap()
          crossfadeTopSlot(targetView)
          finish()
        }
      })
    }

    function beginEnterAlbum(
      albumId: string,
      opts: { fromHistory?: boolean } = {},
    ) {
      const folder = getFolder(albumId)
      if (!folder) return

      // Entering an album that already contains the playing track
      // selects that track, not always the first one.
      const activeInThisAlbum = activeAudioUrl
        ? folder.trackIds
            .map((id) => itemsById[id] as TrackItem)
            .find((t) => t.audioUrl === activeAudioUrl)
        : undefined
      selectedTrackId = activeInThisAlbum?.id ?? folder.trackIds[0] ?? null
      selectedAlbumId = albumId

      // Only meaningful coming from a genuine albums-list scroll
      // position (not a deep-link/popstate landing straight in an
      // album) -- restored exactly by rebuildForCurrentView() on the
      // way back out, rather than centering/scrolling anything.
      if (isMobileMode() && view === "albums" && wheelGridEl) {
        savedAlbumsScrollTop = wheelGridEl.scrollTop
      }

      playLevelSound("open")
      announceLevelChange()

      // The clicked row -- morph's "old" element -- only exists to
      // find if we're actually leaving the albums list right now (a
      // deep-link/popstate entry with no prior albums view in the DOM
      // has none, and the morph just degrades to the named element
      // "appearing" from nothing).
      const sourceRow =
        view === "albums"
          ? (rowEls[visibleEntries.findIndex((e) => e.item.id === albumId)] ??
            null)
          : null

      runLevelTransition(
        1,
        () => {
          view = "album"
          if (!opts.fromHistory) updateUrlForAlbum(albumId)
          rebuildForCurrentView()
          updateDockedHeader(folder)
        },
        {
          oldEl: sourceRow,
          getNewEl: () => dockedHeaderEl,
          name: albumMorphName(albumId),
        },
      )
    }

    function beginExitAlbum(opts: { fromHistory?: boolean } = {}) {
      playLevelSound("close")
      announceLevelChange()

      const albumId = selectedAlbumId

      runLevelTransition(
        -1,
        () => {
          view = "albums"
          if (!opts.fromHistory) updateUrlForAlbum(null)
          rebuildForCurrentView()
        },
        {
          oldEl: dockedHeaderEl,
          getNewEl: () =>
            albumId
              ? (rowEls[visibleEntries.findIndex((e) => e.item.id === albumId)] ??
                null)
              : null,
          name: albumId ? albumMorphName(albumId) : "album-header-exit",
        },
      )
    }

    function performBackNavigation() {
      if ((history.state as { pushedByApp?: boolean } | null)?.pushedByApp) {
        // popstate handler runs the actual exit transition
        history.back()
      } else {
        // Directly-loaded/refreshed ?album= URL -- nothing of ours
        // behind it in the stack, so history.back() would leave the
        // site. Replace this entry instead and transition ourselves
        // (replaceState doesn't fire popstate).
        updateUrlForAlbum(null, { replace: true })
        beginExitAlbum({ fromHistory: true })
      }
    }

    function requestBack() {
      // During an enter transition's pre-swap leg, `view` is still
      // "albums" -- it only flips to "album" inside doSwap(), which
      // runs later. Allow back to interrupt that leg too, not just
      // once view has already flipped, otherwise the exact moment
      // reversal needs to work is when this guard would block it.
      const midEnterTransition = transitionPhase !== "idle" && transitionDirection === 1
      if (view !== "album" && !midEnterTransition) return

      if (transitionPhase === "idle") {
        performBackNavigation()
        return
      }

      if (transitionDirection !== 1) {
        // Already exiting -- already doing what was asked; ignore a
        // redundant back press rather than restarting/overlapping it.
        return
      }

      // Mid an ENTER transition -- reverse cleanly from here, on
      // whichever platform's mechanism (or in-flight View Transition)
      // is actually running. cancelActiveTransition() bumps the token,
      // so this call's own token is captured fresh right after.
      cancelActiveTransition()
      const myToken = transitionToken

      if (transitionPhase === "pre-swap") {
        // DOM not yet swapped -- nothing was ever entered, so there's
        // nothing to undo beyond the in-flight visual.
        if (isMobileMode()) {
          if (wheelGridEl) wheelGridEl.style.opacity = "1"
          transitionPhase = "idle"
        } else {
          const restIndex = selectedIndex
          transitionDirection = -1
          transitionPhase = "post-swap"
          animateSweep(wheelPosition, restIndex, SWEEP_LEG_MS, () => {
            if (myToken !== transitionToken) return
            wheelPosition = restIndex
            targetIndex = restIndex
            transitionPhase = "idle"
          })
        }
        return
      }

      // "morphing" (the VT already applied the swap; view/DOM already
      // reflect the album, but the header morph may still be
      // animating -- skipTransition() above already jumped it to its
      // end state) or "post-swap" (VT long finished, rows already
      // sweeping in) -- both mean the album view is already fully
      // showing, so redirect straight into a real exit rather than
      // trying to reverse the row-morph mid-flight.
      if (isMobileMode() && wheelGridEl) wheelGridEl.style.opacity = "1"
      transitionPhase = "idle"
      performBackNavigation()
    }

    dockedHeaderEl?.addEventListener("click", requestBack)
    mobileHeroBack?.addEventListener("click", requestBack)

    window.addEventListener("popstate", () => {
      // The expanded player never changes the URL (see openExpandedPlayer()),
      // just history.state -- checked independently of the album
      // params below, since the two layers are orthogonal (an
      // expanded-player pop never touches ?album=, and vice versa).
      const state = history.state as { player?: boolean } | null
      if (expandedPlayerOpen && !state?.player) {
        hideExpandedPlayerUI()
      }

      const params = new URLSearchParams(location.search)
      const albumId = params.get("album")
      if (albumId && getFolder(albumId)) {
        if (view !== "album" || selectedAlbumId !== albumId) {
          beginEnterAlbum(albumId, { fromHistory: true })
        }
      } else if (view !== "albums") {
        beginExitAlbum({ fromHistory: true })
      }
    })

    // ---------- central selection entry point (in-place nav only, no level change) ----------
    function selectIndex(index: number, opts: { playNow?: boolean } = {}) {
      const clamped = Math.max(0, Math.min(visibleEntries.length - 1, index))
      const entry = visibleEntries[clamped]
      if (!entry) return
      const changed = clamped !== selectedIndex
      selectedIndex = clamped
      if (view === "albums") selectedAlbumId = entry.item.id
      else selectedTrackId = entry.item.id
      targetIndex = clamped

      syncVisualPosition()
      updateHero()
      updateAriaSelected()

      if (changed) {
        playTick()
        announceSelection()
      }
      if (opts.playNow) playCurrent()
    }

    // ---------- input: keyboard ----------
    document.addEventListener("keydown", (event) => {
      // Checked before isFormField below (not after) -- focus starts
      // on the close button when the dialog opens, and could land on
      // the seek slider too, both of which isFormField would
      // otherwise treat as "ignore this keydown entirely," silently
      // swallowing Escape while the modal is open. Every other key is
      // swallowed here too (Tab is handled separately by the
      // capturing trapExpandedFocus listener registered alongside
      // this modal).
      if (expandedPlayerOpen) {
        if (event.key === "Escape") {
          event.preventDefault()
          closeExpandedPlayerViaHistory()
        }
        return
      }

      if (isFormField(event.target)) return

      if (event.key === "Escape" || event.key === "ArrowLeft") {
        // Going back is always allowed, including mid-transition --
        // it's how a transition gets reversed. Deliberately no
        // view === "album" gate here: requestBack() already contains
        // the correct combined check (including the exit-leg-of-enter
        // window where `view` hasn't flipped to "album" yet) and
        // safely no-ops on its own when there's nothing to go back to.
        // Unaffected by list mode below -- back is a distinct action,
        // not a cursor movement.
        event.preventDefault()
        requestBack()
        return
      }

      // List mode has no cursor for Up/Down/Right/Enter to move or
      // act on -- ignore them rather than silently mutating
      // selectedIndex where nothing on screen reflects it. Also
      // deliberately not calling preventDefault() here, so a screen
      // reader's own browse-mode arrow-key handling (over role="list"/
      // "listitem") still works natively.
      if (isMobileMode()) return

      if (transitionPhase !== "idle") return // ignore other nav input mid-transition

      if (event.key === "ArrowUp") {
        event.preventDefault()
        selectIndex(selectedIndex - 1)
      } else if (event.key === "ArrowDown") {
        event.preventDefault()
        selectIndex(selectedIndex + 1)
      } else if (event.key === "ArrowRight") {
        const item = currentItem()
        if (view === "albums" && item?.kind === "folder") {
          event.preventDefault()
          beginEnterAlbum(item.id)
        }
      } else if (event.key === "Enter") {
        event.preventDefault()
        const item = currentItem()
        if (view === "albums" && item?.kind === "folder") {
          beginEnterAlbum(item.id)
        } else {
          playCurrent()
        }
      }
    })

    // ---------- input: wheel/trackpad ----------
    // One step per gesture. After a step fires we lock further steps
    // until either (a) no wheel events arrive for ~150ms, or (b) a new
    // event's magnitude isn't smaller than the previous one -- which
    // covers both a genuinely new, bigger flick AND a run of same-
    // strength deliberate mouse-wheel notches (neither of those decays
    // the way an inertia tail smoothly does), so both unlock
    // immediately instead of waiting out the whole tail.
    let wheelAccumulator = 0
    let wheelLocked = false
    let wheelLastAbsDelta = 0
    let wheelSilenceTimer: number | undefined

    function normalizeWheelDeltaY(e: WheelEvent) {
      if (e.deltaMode === 1) return e.deltaY * 16 // DOM_DELTA_LINE (Firefox)
      if (e.deltaMode === 2) return e.deltaY * 800 // DOM_DELTA_PAGE (rare)
      return e.deltaY
    }

    wheelEl.addEventListener(
      "wheel",
      (event) => {
        // Mobile is a plain freely-scrolling list; scrolling selects
        // nothing there, so never engage the desktop wheel-math (and
        // never block native scrolling on a hybrid touch/trackpad
        // device).
        if (isMobileMode()) return
        event.preventDefault()
        if (transitionPhase !== "idle") return

        window.clearTimeout(wheelSilenceTimer)
        wheelSilenceTimer = window.setTimeout(() => {
          wheelLocked = false
          wheelAccumulator = 0
          wheelLastAbsDelta = 0
        }, WHEEL_LOCK_SILENCE_MS)

        const delta = normalizeWheelDeltaY(event)
        const absDelta = Math.abs(delta)

        if (wheelLocked) {
          const isDecaying = absDelta < wheelLastAbsDelta * WHEEL_DECAY_TOLERANCE
          wheelLastAbsDelta = absDelta
          if (isDecaying) return
          wheelLocked = false
          wheelAccumulator = 0
        }

        wheelAccumulator += delta
        wheelLastAbsDelta = absDelta

        if (Math.abs(wheelAccumulator) >= WHEEL_STEP_THRESHOLD) {
          const step = wheelAccumulator > 0 ? 1 : -1
          selectIndex(selectedIndex + step)
          wheelLocked = true
          wheelAccumulator = 0
        }
      },
      { passive: false },
    )

    // ---------- keep selection in sync across the mobile/desktop breakpoint ----------
    // Switches between "wheel mode" (desktop, arced/transformed rows,
    // cursor-driven) and "list mode" (mobile, plain document flow,
    // playback-driven) -- clears any inline transform/opacity/zIndex/
    // pointerEvents a prior wheel-mode pass may have left on the rows
    // regardless of which way we're switching (a no-op in list mode,
    // which never sets them); recomputeGeometry() itself handles
    // clearing/(re)setting width and the docked header's offset for
    // whichever mode is now active.
    mobileQuery.addEventListener("change", () => {
      rowEls.forEach((row) => {
        row.style.transform = ""
        row.style.opacity = ""
        row.style.zIndex = ""
        row.style.pointerEvents = ""
      })
      recomputeGeometry()
      applyModeRoles()

      if (isMobileMode()) {
        // Desktop -> mobile: the folder-summary hero / per-track hero
        // split depends on platform, and the docked header needs to
        // give way to the merged mobile header -- both are otherwise
        // only refreshed on a rebuild, which a bare resize never
        // triggers.
        applyMobileTopSlot()
        updateHero()
        // No cursor to carry over, just make sure whatever's actually
        // playing (if part of the current list) is still visible.
        const idx = findActiveEntryIndex()
        if (idx !== -1) {
          requestAnimationFrame(() => {
            rowEls[idx]?.scrollIntoView({ block: "center", behavior: "auto" })
          })
        }
        updateScrollMasks()
      } else {
        // Mobile -> desktop: list mode never maintained a cursor, so
        // re-derive one from whatever's playing (the track itself in
        // album view, or the folder containing it in albums view),
        // falling back to the first item if nothing is.
        const idx = findActiveEntryIndex()
        selectedIndex = idx !== -1 ? idx : 0
        const entry = visibleEntries[selectedIndex]
        if (entry) {
          if (view === "albums") selectedAlbumId = entry.item.id
          else selectedTrackId = entry.item.id
        }
        wheelPosition = selectedIndex
        targetIndex = selectedIndex
        applyDesktopFrame()
        updateHero()
        updateAriaSelected()
      }
    })

    // ---------- keep geometry correct as the panel is resized ----------
    let resizeRafId: number | null = null
    window.addEventListener("resize", () => {
      if (resizeRafId !== null) return
      resizeRafId = requestAnimationFrame(() => {
        resizeRafId = null
        recomputeGeometry()
        if (isMobileMode()) updateScrollMasks()
        else applyDesktopFrame()
      })
    })

    // ---------- initial paint ----------
    const initialParams = new URLSearchParams(location.search)
    const initialAlbumId = initialParams.get("album")
    if (initialAlbumId && getFolder(initialAlbumId)) {
      view = "album"
      selectedAlbumId = initialAlbumId
      const folder = getFolder(initialAlbumId)!
      selectedTrackId = folder.trackIds[0] ?? null
      // Mark this entry as "not ours to history.back() out of" -- if
      // the user landed here directly (deep link / refresh), there's
      // nothing of ours behind it in the stack.
      history.replaceState({ albumId: initialAlbumId, pushedByApp: false }, "", location.href)
    }
    rebuildForCurrentView()

    // If something from this catalog is already playing (e.g.
    // persisted across a navigation from another page) and we're on
    // the plain albums view, refresh the playing-indicator dot --
    // deep-linked album loads already resolve their own selection above.
    document.addEventListener(
      "player:state",
      ((event: CustomEvent) => {
        activeAudioUrl = event.detail?.audioUrl ?? null
        activePlaying = !!event.detail?.playing
        hasPrevious = !!event.detail?.hasPrevious
        hasNext = !!event.detail?.hasNext
        refreshPlaybackUI()
      }) as EventListener,
      { once: true },
    )
    document.dispatchEvent(new CustomEvent("player:query"))
  }

  document.addEventListener("astro:page-load", initWheel)
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Page-scoped: an author display:* rule always beats the UA
     [hidden]{display:none} rule at equal specificity, so any element
     on this page that both sets its own `display` AND gets toggled
     via the hidden attribute would silently ignore it without this.
     !important makes that impossible to reintroduce by accident. */
  [hidden] {
    display: none !important;
  }

  .wheel-page {
    position: relative;
    height: 100dvh;
    overflow: hidden;
    padding: 24px 28px 28px;
    display: flex;
    flex-direction: column;
  }
  /* This page owns a fixed, non-scrolling viewport (the wheel is the
     only scroll container) -- neutralize the sitewide reserved
     PlayerBar padding-bottom (global.css) only while this page is
     mounted, via :global() rather than editing that shared file. */
  :global(body) {
    padding-bottom: 0 !important;
  }
  /* Single-point perspective floor grid, tilted back via rotateX with
     the transform-origin standing in for the vanishing point (roughly
     behind where the wheel's center sits) -- kept very low-opacity so
     it never competes with text. */
  .wheel-page::before {
    content: "";
    position: absolute;
    inset: -60% -20% 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.1;
    background-image:
      repeating-linear-gradient(0deg, var(--line) 0 1px, transparent 1px 56px),
      repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px 56px);
    transform: perspective(700px) rotateX(62deg);
    transform-origin: 65% 0%;
    animation: grid-drift 18s linear infinite;
  }
  @keyframes grid-drift {
    from {
      background-position: 0 0;
    }
    to {
      background-position: 0 56px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wheel-page::before {
      animation: none;
    }
  }

  .top-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--dusk);
    text-decoration: none;
    border-bottom: 1px solid var(--dusk);
    padding-bottom: 2px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .back:hover {
    color: var(--flare);
    border-color: var(--flare);
  }
  .sfx-toggle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ash);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 12px;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .sfx-toggle:hover {
    color: var(--bone);
    border-color: var(--ash-dim);
  }

  .wheel-grid {
    position: relative;
    z-index: 1;
    flex: 1;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(260px, 340px) 1fr;
    grid-template-rows: minmax(0, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .left-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .hero {
    background: var(--static);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .ic-collapse {
    width: 7px;
    height: 7px;
    display: block;
    border-left: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
  }
  /* Mobile only (JS-hidden everywhere else, same pattern as the
     mobile status icon elsewhere on this page): the merged header's
     back control, standing in for the desktop-only docked header. */
  .mobile-hero-back {
    align-self: flex-start;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    margin-bottom: 8px;
    padding: 0;
    color: var(--ash);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s;
  }
  .mobile-hero-back .ic-collapse {
    width: 10px;
    height: 10px;
  }
  .mobile-hero-back:hover {
    color: var(--flare);
  }
  .mobile-hero-back:focus-visible {
    outline: 2px solid var(--dusk);
    outline-offset: 2px;
  }
  .hero-top {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .hero-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    line-height: 1.15;
    color: var(--bone);
  }
  .hero-play {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--dusk);
    background: var(--dusk);
    color: var(--void);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      transform 0.08s;
  }
  .hero-play:hover {
    background: var(--flare);
    border-color: var(--flare);
  }
  .hero-play:active {
    transform: scale(0.94);
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash);
  }
  .hero-meta b {
    color: var(--bone);
    font-weight: 600;
  }

  .stats {
    background: var(--static);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 18px 20px;
  }
  .stats-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash-dim);
  }
  .bpm-row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-top: 10px;
  }
  .bpm-value {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--bone);
    font-variant-numeric: tabular-nums;
  }
  .bpm-value.is-empty {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--ash-dim);
  }
  .bpm-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .genres {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .genre-chip {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 4px 10px;
  }
  .genre-chip.is-primary {
    color: var(--bone);
    border-color: var(--ash-dim);
    font-weight: 600;
  }
  .genre-empty {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ash-dim);
    font-style: italic;
  }

  .wheel-area {
    position: relative;
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  /* Top slot for the wheel column: the "Albums" label and the docked
     header share one grid cell so the fallback crossfade (no View
     Transitions support) can overlap them; under a morph, only one is
     ever unhidden at a time so the shared cell is just spare capacity. */
  .wheel-top-slot {
    position: relative;
    z-index: 1;
    flex: none;
    display: grid;
    margin: 0 0 14px;
  }
  .wheel-top-label,
  .docked-header {
    grid-column: 1;
    grid-row: 1;
  }
  .wheel-top-label {
    align-self: center;
    padding: 0 4px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash-dim);
  }
  /* The docked header IS the clicked album row, morphed in place --
     reuses .wheel-row's shape/surface/border/radius wholesale, then
     overrides everything about its own arc-row positioning (it's a
     normal-flow element here, not absolutely arced) and compresses
     the height slightly (DOCKED_HEADER_HEIGHT: ~44px via padding,
     vs. a normal row's ~56px). Width is kept in sync with row width
     by JS (recomputeGeometry) rather than a CSS percentage, so a
     View Transition morph never has to paper over a width snap. */
  .docked-header {
    position: relative;
    top: auto;
    left: auto;
    align-self: flex-start;
    margin-top: 0;
    padding: 8px 18px 8px 14px;
    gap: 10px;
    transform: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .docked-chevron {
    flex: none;
    color: var(--ash);
  }
  .docked-header:hover .docked-chevron,
  .docked-header:hover .row-title {
    color: var(--flare);
  }
  .docked-header:focus-visible {
    outline: 2px solid var(--dusk);
    outline-offset: 2px;
  }
  /* Always shown as "open" (like DDR's open-folder glow), not tied to
     .is-selected -- the docked header isn't a wheel row and never
     gets that class. */
  .docked-header .ic-album-cursor-ring {
    stroke: var(--dusk);
  }
  /* Fallback only (no View Transitions support): plain opacity
     crossfade between the label and the docked header. Under a real
     morph, doSwap toggles `hidden` directly with no animation class,
     so this transition never fires (VT freezes the live DOM for its
     own duration regardless). */
  .wheel-top-label,
  .docked-header {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .wheel-top-label.is-active,
  .docked-header.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .wheel-top-label,
    .docked-header {
      transition: none;
    }
  }

  /* Suppress the View Transition API's default whole-page crossfade
     (the "root" pair) -- only the docked-header<->row morph (its own
     named group, default animation left intact) should visibly
     animate; everything else just cuts over, which lines up with how
     the incoming tracks are already pre-positioned off-screen the
     instant doSwap runs. :global() since these pseudo-elements aren't
     scoped to any actual DOM element for Astro to attach its scoping
     attribute to. */
  :global(::view-transition-group(*)) {
    animation-duration: 220ms;
  }
  :global(::view-transition-old(*)),
  :global(::view-transition-new(*)) {
    animation-duration: 220ms;
  }
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
  }

  .wheel {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    overscroll-behavior: contain;
    list-style: none;
    margin: 0;
    padding: 0;
    outline: none;
    /* Rows are hard-clipped at the wheel's own edge (overflow:hidden
       above); this softens that clip right below the top slot so a
       row fades out rather than getting cut off mid-shape as it nears
       it -- taller than a single-line label's worth since album view
       packs rows more densely above the raised center slot. */
    mask-image: linear-gradient(to bottom, transparent, black 56px);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 56px);
  }
  .wheel:focus,
  .wheel:focus-visible {
    outline: none;
  }

  .wheel-row {
    position: absolute;
    top: 50%;
    left: 0;
    width: 62%; /* fallback; JS sets the real width from the measured container */
    margin-top: -28px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 18px;
    background: var(--static);
    border: 1px solid var(--line);
    border-radius: 999px 32px 32px 999px;
    cursor: pointer;
    transform-origin: left center;
  }
  .wheel-row.is-folder {
    border-width: 2px;
    font-weight: 600;
  }
  .wheel-row.is-selected {
    border-color: var(--dusk);
    box-shadow:
      0 0 0 1px var(--dusk),
      0 8px 24px -8px rgb(0 0 0 / 0.6);
  }
  /* Keyboard focus indicator lives on the selected row itself (the
     aria-activedescendant pattern), not on the wheel container -- a
     soft glow on the existing frame rather than a second ring, since
     the wheel holds focus for most of the interaction and a full
     double outline reads as too heavy that often. Only shows for
     keyboard focus (:focus-visible on the listbox), never after a
     mouse click. */
  .wheel:focus-visible .wheel-row.is-selected {
    box-shadow:
      0 0 0 1px var(--dusk),
      0 0 14px 3px color-mix(in srgb, var(--dusk) 55%, transparent),
      0 8px 24px -8px rgb(0 0 0 / 0.6);
  }
  .row-icon {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--void);
    color: var(--ash);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Track rows' play/pause glyph uses currentColor and reads well on
     a coral circular backdrop when selected. Album rows' cursor-ring
     SVG below has its own dedicated selected treatment (the ring
     stroke itself turns --dusk), so it's excluded here -- giving the
     row-icon circle a dusk background behind it too would just add
     an unintended ring-behind-the-ring. */
  .wheel-row.is-selected:not(.is-folder) .row-icon {
    background: var(--dusk);
    color: var(--void);
  }
  /* DDR-style player-cursor ring, replacing the play triangle on
     album rows (they open a drill-down, they don't play). Outer ring
     is neutral by default, --dusk once the row is selected; the inner
     disc/ring are static. */
  .ic-album-cursor-ring {
    stroke: var(--ash-dim);
  }
  .wheel-row.is-selected .ic-album-cursor-ring {
    stroke: var(--dusk);
  }
  .row-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .row-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .row-title {
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--bone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-playing-dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--dusk);
  }
  .wheel-row.is-folder .row-title {
    font-weight: 700;
  }
  .wheel-row.is-selected .row-title {
    color: var(--dusk);
  }
  .row-album {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .row-duration {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash);
  }

  .ic-play-mini {
    width: 0;
    height: 0;
    margin-left: 1px;
    border-style: solid;
    border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent currentColor;
  }
  .ic-pause-mini {
    width: 8px;
    height: 10px;
    background-image: linear-gradient(
      90deg,
      currentColor 0 35%,
      transparent 35% 65%,
      currentColor 65% 100%
    );
  }
  .ic-hero-icon.ic-play-mini {
    border-width: 6px 0 6px 10px;
  }
  .ic-hero-icon.ic-pause-mini {
    width: 9px;
    height: 11px;
  }

  /* Docked mini player -- replaces the old status icon/now-playing
     pill. Hidden on desktop entirely (below); on mobile, hidden via
     the `hidden` attribute until a track loads. --mobile-status-offset/
     -size are defined on .wheel-page inside the mobile media query
     below (one named source of truth shared with .wheel-grid's own
     bottom padding, which needs to clear this bar's actual height).
     The fallbacks here just keep this rule meaningful in isolation. */
  .mini-player {
    display: none;
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(
      var(--mobile-status-offset, 16px) + env(safe-area-inset-bottom)
    );
    z-index: 90;
    align-items: center;
    gap: 12px;
    min-height: var(--mobile-mini-player-height, 64px);
    padding: 10px 14px;
    background: var(--static);
    border: 1px solid var(--line);
    border-radius: 16px;
    box-shadow: 0 8px 24px -8px rgb(0 0 0 / 0.6);
    cursor: pointer;
    overflow: hidden; /* clips the progress line to the rounded corners */
  }
  .mini-player-progress-track {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--line);
  }
  .mini-player-progress {
    height: 100%;
    width: 0%;
    background: var(--dusk);
  }
  .mini-player-info {
    flex: 1;
    min-width: 0;
  }
  .mini-player-title {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--bone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini-player-album {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ash-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini-player-controls {
    flex: none;
    display: flex;
    align-items: center;
    gap: 2px;
  }
  /* Neutral, not coral -- these shouldn't compete with the playing
     row's own coral frame back in the list. */
  .mini-player-btn {
    flex: none;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--bone);
    cursor: pointer;
    padding: 0;
  }
  .mini-player-btn.is-inactive {
    opacity: 0.4;
  }
  .ic-skip-mini {
    width: 11px;
    height: 10px;
    position: relative;
    display: block;
  }
  .ic-skip-mini::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 5px 0 5px 7px;
    border-color: transparent transparent transparent currentColor;
  }
  .ic-skip-mini::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 2px;
    height: 10px;
    background: currentColor;
  }
  .ic-skip-mini.prev {
    transform: scaleX(-1);
  }

  /* Expanded player -- a page-scoped modal, not PlayerBar's own
     #player-drawer (see the merge-debt note at the top of this
     page's script). display:none unconditionally here (desktop never
     triggers it -- .mini-player, its only open-trigger, is already
     display:none there); the mobile media query below switches it to
     flex once unhidden. Slides up from the mini bar via transform/
     opacity only. */
  .expanded-player {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    flex-direction: column;
    padding: 16px 20px calc(24px + env(safe-area-inset-bottom));
    background: var(--void);
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .expanded-player.is-open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .expanded-player {
      transition: none;
    }
  }
  .expanded-top {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36px;
  }
  .expanded-close {
    position: absolute;
    left: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--bone);
    cursor: pointer;
    padding: 0;
  }
  .ic-expanded-chevron-down {
    width: 10px;
    height: 10px;
    display: block;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }
  .expanded-source {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash-dim);
    text-align: center;
  }
  /* Empty, subtly outlined placeholder -- not a visualizer yet. */
  .expanded-visualizer {
    flex: none;
    height: 33vh;
    margin-top: 20px;
    border: 1px solid var(--line);
    border-radius: 16px;
  }
  .expanded-meta-block {
    flex: none;
    margin-top: 28px;
  }
  .expanded-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 6vw, 2rem);
    line-height: 1.2;
    color: var(--bone);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .expanded-subtitle {
    margin: 8px 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash);
  }
  .expanded-scrub {
    flex: none;
    margin-top: 24px;
  }
  .expanded-seek {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(
      to right,
      var(--dusk) 0%,
      var(--dusk) var(--progress, 0%),
      var(--line) var(--progress, 0%),
      var(--line) 100%
    );
    cursor: pointer;
  }
  .expanded-seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bone);
    border: none;
  }
  .expanded-seek::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bone);
    border: none;
  }
  .expanded-seek::-moz-range-track {
    height: 4px;
    background: transparent;
  }
  .expanded-times {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
  }
  .expanded-time {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash-dim);
    font-variant-numeric: tabular-nums;
  }
  .expanded-controls {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }
  /* Neutral, not coral -- coral is reserved for the single primary
     play/pause control below. */
  .expanded-tbtn {
    flex: none;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--bone);
    cursor: pointer;
    padding: 0;
  }
  .expanded-tbtn.is-inactive {
    opacity: 0.4;
  }
  .expanded-tbtn.expanded-play {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--dusk);
    color: var(--void);
  }
  .expanded-tbtn.expanded-play:active {
    transform: scale(0.94);
  }
  .expanded-tbtn.expanded-play .ic-play-mini,
  .expanded-tbtn.expanded-play .ic-pause-mini {
    transform: scale(2);
  }

  @media (max-width: 780px) {
    .wheel-page {
      /* Horizontal gutter now lives on .top-row and on each piece of
         scrolled content individually (.left-col, .wheel-area) --
         .wheel-grid (the scroll container) stays flush to the screen
         edge instead of inheriting an inset here, which used to
         double up with .wheel-area's own padding and narrow the list
         more than intended. */
      padding: 16px 0;
      /* Single named source of truth for "how much space at the
         bottom needs to stay clear of the mini player" -- derived
         from its own height/offset rather than a second hardcoded
         number kept in sync by hand. .wheel-grid's own bottom padding
         uses this directly; a future reserved now-playing line above
         the mini player extends this same property instead of
         needing its own. Height (64px) matches the mini player's own
         rendered size: 44px buttons + 2*10px vertical padding. */
      --mobile-mini-player-height: 64px;
      --mobile-status-offset: 16px;
      --mobile-reserved-bottom: calc(
        var(--mobile-status-offset) + var(--mobile-mini-player-height) +
          env(safe-area-inset-bottom) + 16px
      );
    }
    .top-row {
      padding: 0 16px; /* needs its own gutter now that .wheel-page's is gone */
    }
    /* Spotify-style: the header (hero or "Albums" label) and the row
       list scroll together as one unit -- only .top-row above and the
       docked mini player below (both position:fixed) stay put. */
    .wheel-grid {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overflow-anchor: none;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
      transition: opacity 0.15s ease;
      padding-bottom: var(--mobile-reserved-bottom, 96px);
      /* Feather masks only show once there's actually somewhere to
         scroll to/from -- not at rest. --top-fade/--bottom-fade
         default to 0 (no fade) and are only pushed out to 56px by the
         .show-*-fade classes, toggled by a scroll listener
         (updateScrollMasks()) rather than restyling rows. */
      --top-fade: 0px;
      --bottom-fade: 0px;
      mask-image: linear-gradient(
        to bottom,
        transparent,
        black var(--top-fade),
        black calc(100% - var(--bottom-fade)),
        transparent
      );
      -webkit-mask-image: linear-gradient(
        to bottom,
        transparent,
        black var(--top-fade),
        black calc(100% - var(--bottom-fade)),
        transparent
      );
    }
    .wheel-grid.show-top-fade {
      --top-fade: 56px;
    }
    .wheel-grid.show-bottom-fade {
      --bottom-fade: 56px;
    }
    .left-col {
      flex: none;
      padding: 0 16px; /* own gutter, matching .wheel-area's below */
      margin-bottom: 24px; /* breathing room before the first row */
    }
    /* The merged header (album view) drops the card treatment
       entirely -- "one header," not "one card." Albums view never
       shows this at all (see updateHero()'s leftCol.hidden). */
    .hero {
      background: none;
      border: none;
      border-radius: 0;
      padding: 0;
    }
    .hero-albums-view,
    .hero-album-view {
      display: flex;
      flex-direction: column;
      width: 100%;
    }
    .hero-meta {
      margin-top: 8px;
    }
    .hero-top {
      min-width: 0; /* lets .hero-title actually shrink to truncate below */
    }
    .hero-album-view .hero-title {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      min-width: 0;
    }
    #track-hero-play-btn {
      display: none;
    }
    .stats {
      display: none;
    }
    .wheel-area {
      /* Cancels the unconditional (desktop) height:100% -- .wheel-area
         is no longer its own fixed-height flex region here, just
         normal content-sized flow within .wheel-grid's scroll content
         (forcing it to 100% of the scroll viewport regardless of how
         many rows there are would also throw off updateScrollMasks()'s
         scrollHeight/clientHeight comparison). */
      height: auto;
      /* Own gutter, matching .left-col's -- .wheel-grid itself (the
         actual scroll container) stays flush to the screen edge. */
      padding: 0 16px;
    }
    /* Overrides the unconditional (desktop) 14px -- breathing room
       before the first row in albums view, matching .left-col's own
       margin-bottom for the album-view case above. */
    .wheel-top-slot {
      margin: 0 0 24px;
    }
    /* Cancels the unconditional (desktop) overflow:hidden/mask/flex
       sizing -- #wheel is no longer its own clipped/masked/scroll-sized
       region here; .wheel-grid (the actual scroll container) owns the
       scrolling and the feather mask now, and #wheel just flows to its
       natural content height within it. Without this, the desktop
       rule's own top-only mask would double up with .wheel-grid's. */
    .wheel {
      flex: none;
      min-height: auto;
      overflow: visible;
      mask-image: none;
      -webkit-mask-image: none;
    }
    /* List mode: straight vertical stack, full width of the padded
       .wheel-area box, no arc -- no x-offset, no per-row scale, no
       rotation/skew, and no distance-based opacity falloff (JS never
       sets transform/opacity/zIndex here at all; recomputeGeometry()
       clears width/marginLeft rather than computing them), and no
       scroll-snap (plain momentum scrolling; scrolling changes
       nothing about selection here). The 10px vertical margin reuses
       the same spacing already used for this in wheel mode. */
    .wheel-row {
      position: relative;
      top: auto;
