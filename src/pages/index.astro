---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Socials from "../components/Socials.astro"
---

<Layout>
  <Nav />

  <section class="hero">
    <div class="hero-echo" aria-hidden="true">
      <span>SUSHIBOt</span>
      <span>SUSHIBOt</span>
      <span>SUSHIBOt</span>
    </div>
    <div class="hero-image" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1 class="wordmark" data-text="SUSHIBOt">SUSHIB<span class="accent">O</span>t</h1>
      <p class="tagline">
			Genres: Electronic, Big Room, Liquid DnB, Hardstyle, Techno, IDM, ???, no AI generated music slop.
      </p>
      <a class="cta" href="/albums/">[ Access the archive → ]</a>
    </div>
    <div class="divider" aria-hidden="true"></div>
  </section>

  <section class="about">
    <div class="about-content">
      <h2 class="about-title">ABOUT</h2>
      <p class="bio">
        Howzit bah. Glad you found me. I've been making music for over a
        decade now, and this website holds almost my entire catalog of stuff
        I've done over the years.<br> <br> I swing between a ton of different genres:
        Electronic, Big Room, Liquid DnB, Hardstyle, Techno, IDM, etc. Some
        of my biggest artist inspirations include: Deadmau5 (bro is
        literally the reason why I started doing this in the first place),
        Kill The Noise, Feed Me, Noisia, Skrillex, Fre4knc, ISOXO, and
        Knock2, just to name a few. Aside from my music production, I'm also
        a self taught pianist and I've been playing ever since I was 10
        years old. <br> <br> Anyway, each album represents the year of all the music I
        created, but did not post anywhere. You may find a bunch of
        redundant songs or re-used themes everywhere. Thanks for visiting
        and I hope you enjoy!
      </p>
    </div>
  </section>

  <footer class="site-footer">
    <Socials />
  </footer>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 96px 28px 72px;
    overflow: hidden;
    background: var(--void);
    min-height: 100vh;
    display: flex;
    align-items: center;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/album-art/sushibot.jpg");
    background-repeat: no-repeat;
    background-position: right center;
    background-size: contain;
    filter: grayscale(1) brightness(0.6) contrast(0.9);
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 48%,
      black 90%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 48%,
      black 90%
    );
  }
  @media (max-width: 640px) {
    .hero-image {
      display: none;
    }
  }
  /* repeated ghost wordmark — sits above the portrait so it reads across it, not hidden behind it */
  .hero-echo {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.5rem, 3vw, 1.5rem);
    overflow: hidden;
    white-space: nowrap;
  }
  .hero-echo span {
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: clamp(5rem, 19vw, 15rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(231, 230, 226, 0.08);
    text-stroke: 1px rgba(231, 230, 226, 0.08);
  }
  .hero-inner {
    position: relative;
    z-index: 2;
  }
  .hero .wordmark {
    font-family: var(--font-hero);
    font-weight: 800;
    font-size: clamp(4rem, 16vw, 13rem);
    line-height: 0.9;
  }
  .hero .wordmark .accent {
    color: var(--dusk);
  }
  .tagline {
    margin-top: 16px;
    max-width: 48ch;
    color: var(--ash);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bone);
    text-decoration: none;
    border: 1px solid var(--line);
    padding: 11px 18px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .cta:hover {
    color: var(--flare);
    border-color: var(--flare);
  }

  /* angular cut between the hero and the about section — cyberpunk.net cue */
  .divider {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 28px;
    background: var(--static-2);
    clip-path: polygon(0 100%, 100% 0%, 100% 100%);
  }

  .about {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    background: var(--void);
  }
  .about::before {
    content: "";
    position: absolute;
    inset: -50%;
    background-image: repeating-linear-gradient(
      115deg,
      rgba(241, 106, 91, 0.14) 0 2px,
      transparent 2px 60px
    );
    animation: about-streak 2.6s linear infinite;
  }
  @keyframes about-streak {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(120px, -120px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about::before {
      animation: none;
    }
  }
  .about-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    padding: 0 28px;
  }
  .about-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--bone);
  }
  .about-content .bio {
    margin-top: 20px;
    line-height: 1.7;
    color: var(--ash);
  }

  .site-footer {
    padding: 32px 28px;
    background: var(--static);
  }
</style>
