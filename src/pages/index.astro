  /* ---- about: same background as the hero, outlined viz behind the copy ---- */
  .about {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(180deg, #0a0f1c, var(--void) 60%);
  }
  #viz {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.34));
  }
  .about-in {
    flex: 1;
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 56px 12px 72px;
    display: grid;
    gap: 2px;
    grid-template-columns: 1fr;
    align-content: center;
  }
  .about-main {
    position: relative;
    padding: 8px 0 28px;
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .about-main::before {
    content: "";
    position: absolute;
    inset: -20px -20px -8px -20px;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(10, 15, 28, 0.62),
      rgba(10, 15, 28, 0.38) 55%,
      transparent
    );
  }
  .about h2 {
    position: relative;
    margin: 0;
    font: 700 clamp(32px, 6vw, 52px) / 1 var(--font-display);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .about h2::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: -6%;
    top: 50%;
    width: min(112%, 720px);
    height: 300%;
    transform: translateY(-50%);
    pointer-events: none;
    opacity: 0.75;
    background: radial-gradient(
      closest-side,
      var(--glow-soft),
      rgba(34, 211, 238, 0.12) 55%,
      transparent 80%
    );
    filter: blur(10px);
  }
  .copy {
    max-width: 62ch;
    text-shadow:
      0 0 14px rgba(10, 15, 28, 0.9),
      0 0 3px rgba(10, 15, 28, 0.8);
  }
  .copy p {
    margin: 0 0 1.1em;
    font-size: 17px;
    line-height: 1.65;
  }
  .copy p:last-child {
    margin: 0;
  }
  .astats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .stat {
    padding: 14px 16px;
    min-height: 104px;
    flex-direction: column;
    justify-content: space-between;
    background: var(--void);
  }
  .stat strong {
    font: 700 clamp(34px, 9vw, 48px) / 1 var(--font-display);
  }
  .stat small {
    font: 400 12px/1.35 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .stat.red {
    background: var(--scarlet);
  }
  .stat.red small {
    color: var(--bone);
  }
  .stat.pap {
    background: var(--paper);
    color: var(--paper-ink);
    grid-column: 1 / -1;
  }
  .stat.pap small {
    color: var(--paper-ink);
  }
  .stat.pap strong {
    font-size: 26px;
    white-space: nowrap;
  }
  @media (min-width: 900px) {
    .about-in {
      grid-template-columns: 1fr 208px;
      column-gap: 40px;
    }
    .astats {
      grid-template-columns: 1fr;
    }
    .stat {
      min-height: 0;
    }
    .stat.pap {
      min-height: 132px;
    }
  }

  /* ---- hero art: oversized "wash" that fills the right side of the
     screen, fading in from the left behind the type (option D) ---- */
  :root {
    --gutR: calc(max(0px, (100vw - var(--maxw)) / 2) + 12px);
  }
  .enter {
    position: relative;
    z-index: 2;
  }
  .main {
    overflow: visible;
  }
  .char {
    right: calc(-1 * var(--gutR) - 4%);
    height: 150%;
    bottom: -34%;
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 38%);
    mask-image: linear-gradient(90deg, transparent 0, #000 38%);
  }
  @media (min-width: 900px) {
    .herofx {
      left: calc(100% + var(--gutR) - 420px);
      width: calc((100% - 210px) * 1.1);
    }
  }
</style>

<script>
  /* Outlined spectrum behind About (simulated, no audio on the home page).
     Peak caps hold 650 ms then fall; the top 16% goes red. Runs only
     while the section is on screen (IntersectionObserver);
     prefers-reduced-motion renders one static frame instead. Re-runs on
     every client-side navigation since #about isn't transition:persist
     and is a fresh DOM node each time. */
  function initSpectrum() {
    const cv = document.getElementById("viz") as HTMLCanvasElement | null
    const sec = document.getElementById("about")
    if (!cv || !sec) return
    const ctx = cv.getContext("2d")
    if (!ctx) return

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
    let W = 0,
      H = 0,
      dpr = 1,
      n = 0
    const pitch = 30,
      gap = 8,
      HOLD = 0.65,
      FALL = 2.4,
      BPM = 118
    let base = 0,
      maxH = 0
    let lvl: number[] = [],
      peak: number[] = [],
      hold: number[] = []

    function layout() {
      dpr = Math.min(devicePixelRatio || 1, 2)
      const b = sec!.getBoundingClientRect()
      W = b.width
      H = b.height
      cv!.width = Math.round(W * dpr)
      cv!.height = Math.round(H * dpr)
      n = Math.max(12, Math.round(W / pitch))
      base = H
      maxH = Math.max(120, (H - 48) * 0.55)
      lvl = []
      peak = []
      hold = []
      for (let i = 0; i < n; i++) {
        lvl.push(0)
        peak.push(0)
        hold.push(0)
      }
    }

    function target(i: number, t: number) {
      const x = i / (n - 1)
      const beat = (t * BPM) / 60
      const ph = beat % 1
      const kick = Math.pow(Math.max(0, 1 - ph * 2.2), 2.2)
      const env = Math.pow(1 - x, 1.35) * 0.62 + 0.14
      const wob =
        0.5 +
        0.5 * Math.sin(t * 1.7 + i * 0.9) * Math.sin(t * 0.63 + i * 0.37)
      const snare =
        (Math.floor(beat) % 2 === 1 ? Math.pow(Math.max(0, 1 - ph * 3), 2) : 0) *
        (x > 0.25 && x < 0.8 ? 0.35 : 0)
      const hat =
        Math.pow(Math.max(0, 1 - ((beat * 2) % 1) * 3.5), 2) *
        (x > 0.55 ? 0.28 : 0)
      return Math.max(
        0.04,
        Math.min(1, env * (0.45 + 0.55 * wob) + kick * (1 - x) * 0.55 + snare + hat),
      )
    }

    let last = 0
    const t0 = performance.now()
    let vis = true
    let running = false

    function draw(now: number) {
      const dt = Math.min(0.05, (now - last) / 1000 || 0.016)
      last = now
      const t = (now - t0) / 1000
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx!.clearRect(0, 0, W, H)
      const bw = pitch - gap
      for (let i = 0; i < n; i++) {
        const tg = target(i, t)
        lvl[i] =
          tg > lvl[i]
            ? lvl[i] + (tg - lvl[i]) * Math.min(1, dt * 18)
            : Math.max(tg, lvl[i] - FALL * dt * 0.6)
        if (lvl[i] >= peak[i]) {
          peak[i] = lvl[i]
          hold[i] = HOLD
        } else if (hold[i] > 0) {
          hold[i] -= dt
        } else {
          peak[i] = Math.max(lvl[i], peak[i] - FALL * dt)
        }
        const x = Math.round(i * pitch + (W - n * pitch + gap) / 2) + 0.5
        const h = Math.round(lvl[i] * maxH)
        const y = base - h
        ctx!.strokeStyle = "rgba(239,230,204,.4)"
        ctx!.lineWidth = 1.5
        ctx!.beginPath()
        ctx!.moveTo(x, base)
        ctx!.lineTo(x, y)
        ctx!.lineTo(x + bw, y)
        ctx!.lineTo(x + bw, base)
        ctx!.stroke()
        ctx!.strokeStyle = "rgba(239,230,204,.09)"
        ctx!.lineWidth = 1
        ctx!.beginPath()
        for (let yy = base - 9; yy > y; yy -= 9) {
          ctx!.moveTo(x, Math.round(yy) + 0.5)
          ctx!.lineTo(x + bw, Math.round(yy) + 0.5)
        }
        ctx!.stroke()
        const py = base - Math.round(peak[i] * maxH)
        ctx!.strokeStyle = peak[i] > 0.84 ? "#E5472F" : "rgba(239,230,204,.9)"
        ctx!.lineWidth = 2
        ctx!.beginPath()
        ctx!.moveTo(x, py - 5.5)
        ctx!.lineTo(x + bw, py - 5.5)
        ctx!.stroke()
      }
      if (!reduce && vis) requestAnimationFrame(draw)
      else running = false
    }

    function kick() {
      if (!running && !reduce) {
        running = true
        requestAnimationFrame(draw)
      }
    }

    new IntersectionObserver((entries) => {
      vis = entries[0].isIntersecting
      if (vis) kick()
    }).observe(sec)
    new ResizeObserver(() => layout()).observe(sec)
    layout()
    if (reduce) {
      for (let k = 0; k < 40; k++) draw(performance.now() + k * 40)
    } else {
      kick()
    }
  }
  if (!(window as any).__spectrumWired) {
    ;(window as any).__spectrumWired = true
    document.addEventListener("astro:page-load", initSpectrum)
  }
</script>
