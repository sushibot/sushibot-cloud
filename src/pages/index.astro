---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"

const albums = (await getCollection("albums")).sort((a, b) => {
  const aReleaseDate = a.data.releaseDate?.valueOf() ?? 0
  const bReleaseDate = b.data.releaseDate?.valueOf() ?? 0

  return bReleaseDate - aReleaseDate
})

const latest = albums[0]

const allTracks = await getCollection("tracks")
const trackCountByAlbum = new Map<string, number>()
for (const track of allTracks) {
  const albumId = track.data.album.id
  trackCountByAlbum.set(albumId, (trackCountByAlbum.get(albumId) ?? 0) + 1)
}

function releaseMeta(album: CollectionEntry<"albums">) {
  const dateStr = album.data.releaseDate
    ? album.data.releaseDate.toLocaleDateString("en-US", { timeZone: "UTC" })
    : null
  const count = trackCountByAlbum.get(album.id) ?? 0
  const countStr = count > 0 ? `${count} track${count === 1 ? "" : "s"}` : null

  return [dateStr, countStr].filter(Boolean).join(" — ")
}

const latestMeta = latest ? releaseMeta(latest) : ""
---

<Layout title="Music Library">
  <Nav />

  <section class="hero">
    <div class="hero-echo" aria-hidden="true">
      <span>SUSHIBOT</span>
      <span>SUSHIBOT</span>
      <span>SUSHIBOT</span>
    </div>
    <div class="hero-image" aria-hidden="true"></div>
    <div class="hero-inner">
      <h1 class="wordmark" data-text="SUSHIBOT">SUSHIBOT</h1>
      <p class="tagline">
        A decade of Electronic, Big Room, Liquid DnB, Hardstyle, Techno, and
        everything in between.
      </p>
      {
        latest && (
          <a class="cta" href={`/albums/${latest.id}/`}>
            [ Listen to {latest.data.title} → ]
          </a>
        )
      }
    </div>
  </section>

  <div class="divider" aria-hidden="true"></div>

  {
    latest && (
      <section class="latest">
        <div class="meta">
          <div class="title">{latest.data.title}</div>
          <div class="by">{latestMeta}</div>
        </div>
        <a class="view" href={`/albums/${latest.id}/`}>
          View release →
        </a>
      </section>
    )
  }

  <section class="discography">
    <div class="album-grid">
      {
        albums.slice(1).map((album) => (
          <a class="album-card" href={`/albums/${album.id}/`}>
            <div class="meta">
              <div class="t">{album.data.title}</div>
              <div class="a">{releaseMeta(album)}</div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="about">
    <div class="about-content">
      <h2 class="about-title">ABOUT</h2>
      <p class="bio">
        Howzit bah. Glad you found me. I've been making music for over a
        decade now, and this website holds almost my entire catalog of stuff
        I've done over the years. I swing between a ton of different genres:
        Electronic, Big Room, Liquid DnB, Hardstyle, Techno, IDM, etc. Some
        of my biggest artist inspirations include: Deadmau5 (bro is
        literally the reason why I started doing this in the first place),
        Kill The Noise, Feed Me, Noisia, Skrillex, Fre4knc, ISOXO, and
        Knock2, just to name a few. Aside from my music production, I'm also
        a self taught pianist and I've been playing ever since I was 10
        years old. Each album represents the year of all the music I
        created, but did not post anywhere. You may find a bunch of
        redundant songs or re-used themes everywhere. Thanks for visiting
        and I hope you enjoy!
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    padding: 96px 28px 72px;
    overflow: hidden;
    background: var(--void);
    min-height: 420px;
    display: flex;
    align-items: center;
  }
  /* repeated ghost wordmark — near-invisible typographic texture behind the hero */
  .hero-echo {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.5rem, 3vw, 1.5rem);
    overflow: hidden;
    white-space: nowrap;
  }
  .hero-echo span {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(3.5rem, 15vw, 10rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(231, 230, 226, 0.05);
    text-stroke: 1px rgba(231, 230, 226, 0.05);
  }

  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url("/album-art/sushibot.jpg");
    background-repeat: no-repeat;
    background-position: right center;
    background-size: contain;
    filter: grayscale(1) brightness(0.6) contrast(0.9);
    opacity: 0.6;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 48%,
      black 90%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      transparent 48%,
      black 90%
    );
  }
  @media (max-width: 640px) {
    .hero-image {
      display: none;
    }
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 560px;
  }
  .hero .wordmark {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    line-height: 0.94;
  }
  .tagline {
    margin-top: 16px;
    max-width: 48ch;
    color: var(--ash);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bone);
    text-decoration: none;
    border: 1px solid var(--line);
    padding: 11px 18px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .cta:hover {
    color: var(--flare);
    border-color: var(--flare);
  }

  /* angular cut between the hero and the latest-release strip — cyberpunk.net cue */
  .divider {
    height: 28px;
    background: var(--static-2);
    clip-path: polygon(0 100%, 100% 0%, 100% 100%);
  }

  .latest {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 26px 28px;
    background: var(--static);
    border-bottom: 1px solid var(--line);
  }
  .latest .title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
  }
  .latest .by {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash);
    margin-top: 4px;
  }
  .latest .view {
    margin-left: auto;
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--dusk);
    text-decoration: none;
    border-bottom: 1px solid var(--dusk);
    padding-bottom: 2px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .latest .view:hover {
    color: var(--flare);
    border-color: var(--flare);
  }
  @media (max-width: 560px) {
    .latest {
      flex-direction: column;
      align-items: flex-start;
    }
    .latest .view {
      margin-left: 0;
    }
  }

  /* dusk/flare — the accent quarantined for Neon Summer in the mood board, reused here
     to set the full discography apart from the signal-cyan hero/featured module above */
  .discography {
    padding: 48px 28px 72px;
  }
  .discography h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
  }
  .album-grid {
    margin-top: 20px;
    border-top: 1px solid var(--line);
  }
  .album-card {
    display: block;
    padding: 14px 2px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s;
  }
  .album-card:hover {
    border-color: var(--dusk);
  }
  .album-card .t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    transition: color 0.15s;
  }
  .album-card:hover .t {
    color: var(--dusk);
  }
  .album-card .a {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ash);
    margin-top: 4px;
    transition: color 0.15s;
  }
  .album-card:hover .a {
    color: var(--flare);
  }

  .about {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    background: var(--void);
  }
  .about::before {
    content: "";
    position: absolute;
    inset: -50%;
    background-image: repeating-linear-gradient(
      115deg,
      rgba(241, 106, 91, 0.14) 0 2px,
      transparent 2px 60px
    );
    animation: about-streak 2.6s linear infinite;
  }
  @keyframes about-streak {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(120px, -120px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .about::before {
      animation: none;
    }
  }
  .about-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    padding: 0 28px;
  }
  .about-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--bone);
  }
  .about-content .bio {
    margin-top: 20px;
    line-height: 1.7;
    color: var(--ash);
  }
</style>
