---
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import Socials from "../components/Socials.astro"
import { getCollection } from "astro:content"
import { getYearRange, formatArchiveIndex } from "../lib/archive"

const albums = await getCollection("albums")
const yearRange = getYearRange(albums)
const idxLabel = formatArchiveIndex(yearRange)
const minYear = yearRange?.min
const maxYear = yearRange?.max
const maxYY = maxYear !== undefined ? String(maxYear).slice(-2) : undefined
const buildYY = String(new Date().getUTCFullYear()).slice(-2)

const archiveSpan = minYear !== undefined ? `${minYear} – now` : "—"
const serieSpan =
  minYear !== undefined && maxYY !== undefined
    ? `${minYear}–${maxYY}`
    : "—"
// end year is the current build year, not the latest release -- the
// copyright line covers "this site has existed since X", not "the
// catalog's newest track is from Y"
const copyrightSpan =
  minYear !== undefined ? `${minYear}–${buildYY}` : new Date().getUTCFullYear()
---

<Layout>
  <Nav />

  <main id="top">
    <h1 class="vh">
      SushiCloud, a personal music archive{minYear !== undefined ? ` from ${minYear} to now` : ""}
    </h1>
    <section class="screen s1">
      <div class="wrap">
        <div class="hero" role="region" aria-label="SushiCloud home">
          <div class="herofx" aria-hidden="true"></div>
          <div class="side">
            <div class="cell yr">
              <strong>{maxYear ?? "—"}</strong>
              <small>Archive<br />{archiveSpan}</small>
            </div>
            <div class="cell code">
              <small>Originals<br />Works in progress<br />Live visualizer</small>
              <span class="chips" aria-hidden="true">
                <i style="--c:var(--era-2012)"></i>
                <i style="--c:var(--era-2015)"></i>
                <i style="--c:var(--era-2018)"></i>
                <i style="--c:var(--era-2021)"></i>
                <i style="--c:var(--era-2024)"></i>
              </span>
            </div>
            <div class="cell stamp">
              <small>Index no.</small>
              <span class="bc" data-barcode="stamp" aria-hidden="true"></span>
              <span class="decal" aria-hidden="true">Archive</span>
            </div>
          </div>
          <div class="cell main">
            <div class="rails" aria-hidden="true">
              <div class="st"></div>
              <div class="ln"></div>
              <div class="bc" data-barcode="hero"></div>
            </div>
            <p class="spec l" aria-hidden="true">Originals<br />Works in progress</p>
            <p class="spec r" aria-hidden="true">Serie : {serieSpan}<br />Format : audio</p>
            <p class="big a" aria-hidden="true">Sushi</p>
            <img
              class="char"
              src="/character-outline.svg"
              alt="Line drawing of the SushiCloud character"
              width="965"
              height="928"
            />
            <p class="big b" aria-hidden="true">Cloud</p>
          </div>
        </div>
      </div>

      <section class="enter" aria-label="Enter the archive">
        <div class="enter-in">
          <div class="meta">
            <div class="row1">
              <span class="mono">Index no. {idxLabel}</span>
              <span class="bc" data-barcode="enter" aria-hidden="true"></span>
            </div>
            <div class="chips" aria-hidden="true">
              <i style="--c:var(--era-2012)"></i>
              <i style="--c:var(--era-2015)"></i>
              <i style="--c:var(--era-2018)"></i>
              <i style="--c:var(--era-2021)"></i>
              <i style="--c:var(--era-2024)"></i>
            </div>
            <span class="mono sub">Originals &middot; Works in progress &middot; {archiveSpan}</span>
          </div>
          <a class="cta" href="/albums/">
            Enter the archive
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <path d="M4 12h15M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </section>
    </section>

    <section class="about screen" id="about" aria-labelledby="about-h">
      <canvas id="viz" aria-hidden="true"></canvas>
      <div class="about-in">
        <div class="about-main" id="about-main">
          <h2 id="about-h">About the maker</h2>
          <div class="copy">
            <p>
              Howzit bah. Glad you found me. I've been making music for over
              a decade now, and this website holds almost my entire catalog
              of stuff I've done over the years.
            </p>
            <p>
              I swing between a ton of different genres: Electronic, Big
              Room, Liquid DnB, Hardstyle, Techno, IDM, etc. Some of my
              biggest artist inspirations include: Deadmau5 (bro is
              literally the reason why I started doing this in the first
              place), Kill The Noise, Feed Me, Noisia, Skrillex, Fre4knc,
              ISOXO, and Knock2, just to name a few. Aside from my music
              production, I'm also a self taught pianist and I've been
              playing ever since I was 10 years old.
            </p>
            <p>
              Anyway, each album represents the year of all the music I
              created, but did not post anywhere. You may find a bunch of
              redundant songs or re-used themes everywhere. Thanks for
              visiting and I hope you enjoy!
            </p>
          </div>
        </div>
        <div class="astats">
          <div class="cell stat red">
            <strong>10+</strong>
            <small>Years making<br />music</small>
          </div>
          <div class="cell stat">
            <strong>10</strong>
            <small>Age I started<br />on piano</small>
          </div>
          <div class="cell stat pap">
            <small>Index no.</small>
            <strong>{idxLabel}</strong>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="foot-in">
      <div class="foot-id">
        <b>SushiCloud</b>
        <small>&copy; {copyrightSpan} &middot; sushibot.cloud</small>
      </div>
      <Socials />
    </div>
  </footer>
</Layout>

<style>
  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .cell {
    position: relative;
    min-width: 0;
    display: flex;
  }

  /* ---- hero ---- */
  .screen {
    min-height: calc(100svh - var(--navh));
    display: flex;
    flex-direction: column;
  }
  .s1 {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(180deg, #0a0f1c, var(--void) 60%);
  }
  .wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 16px 12px 0;
  }
  .hero {
    position: relative;
    flex: 1 1 auto;
    max-height: 760px;
    display: grid;
    gap: 2px;
    grid-template-columns: 1fr;
  }
  /* the glow lives on the background layer behind the cell, so it fades
     out past the cell edge instead of being cropped by it */
  .herofx {
    position: absolute;
    z-index: -1;
    left: 72%;
    bottom: -10%;
    width: 90%;
    aspect-ratio: 1;
    transform: translateX(-50%);
    opacity: 0.7;
    pointer-events: none;
    background: radial-gradient(
      closest-side,
      var(--glow-soft),
      rgba(34, 211, 238, 0.12) 55%,
      transparent 80%
    );
    filter: blur(10px);
  }
  .main {
    overflow: hidden;
    container-type: inline-size;
    isolation: isolate;
    min-height: calc((100vw - 24px) * 1.25);
    display: block;
  }
  .spec {
    position: absolute;
    top: 14px;
    font: 400 12px/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bone);
    z-index: 3;
    margin: 0;
  }
  .spec.l {
    left: 16px;
  }
  .spec.r {
    right: 16px;
    text-align: right;
  }
  @media (max-width: 899px) {
    .spec {
      display: none;
    }
  }
  .big {
    position: absolute;
    left: 3cqw;
    margin: 0;
    font: 700 22cqw/0.8 var(--font-display);
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .big.a {
    top: 11%;
    color: rgba(239, 230, 204, 0.9);
    z-index: 2;
    text-shadow: 0 0 0.1em var(--glow-soft);
  }
  .big.b {
    top: calc(11% + 19.5cqw);
    color: var(--pop);
    z-index: 2;
    text-shadow: 0 0.03em 0 var(--void);
  }
  .rails {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .rails .st {
    position: absolute;
    left: 3cqw;
    right: 3cqw;
    top: 52%;
    height: 8%;
    background: repeating-linear-gradient(
      115deg,
      var(--bone) 0 7cqw,
      transparent 7cqw 11cqw
    );
    opacity: 0.9;
  }
  .rails .ln {
    position: absolute;
    left: 3cqw;
    right: 3cqw;
    top: 63%;
    height: 2px;
    background: var(--bone);
  }
  .rails .bc {
    position: absolute;
    left: 3cqw;
    right: 3cqw;
    top: 67%;
    height: 14%;
    color: var(--bone);
  }
  .rails :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .char {
    position: absolute;
    right: -3%;
    bottom: -4%;
    height: 108%;
    width: auto;
    max-width: none;
    z-index: 1;
    filter: drop-shadow(0 0 8px var(--glow-soft));
  }
  .side {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }
  .side .cell {
    min-height: 104px;
    padding: 12px 14px;
    flex-direction: column;
    justify-content: space-between;
  }
  .yr {
    background: var(--era-2024);
    color: var(--bone);
  }
  .yr strong {
    font: 700 clamp(40px, 12vw, 56px) / 1 var(--font-display);
    letter-spacing: 0.02em;
  }
  .yr small,
  .code small,
  .stamp small {
    font: 400 12px/1.35 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .code {
    background: var(--void);
    color: var(--ash);
  }
  .chips {
    display: flex;
    gap: 4px;
  }
  .chips i {
    flex: 1;
    height: 28px;
    background: var(--c);
  }
  .stamp {
    background: var(--bone);
    color: var(--void);
    overflow: hidden;
  }
  .stamp .bc {
    height: 30px;
    color: var(--void);
  }
  .decal {
    background: var(--hazard);
    color: var(--void);
    font: 700 12px/1 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 9px 16px 9px 12px;
    clip-path: polygon(
      0 0,
      calc(100% - 9px) 0,
      100% 9px,
      100% 100%,
      9px 100%,
      0 calc(100% - 9px)
    );
  }
  .stamp .decal {
    position: absolute;
    right: -8px;
    bottom: 12px;
    transform: rotate(-3deg);
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 208px 1fr;
    }
    .side {
      display: grid;
      grid-template-columns: 1fr;
    }
    .stamp {
      min-height: 132px;
    }
    .main {
      min-height: 600px;
    }
    .big.a {
      top: 15%;
    }
    .big.b {
      top: auto;
      bottom: 5%;
    }
    .rails .st {
      top: 49%;
    }
    .rails .ln {
      top: 60%;
    }
    .rails .bc {
      top: 64%;
      height: 16%;
    }
    .herofx {
      left: calc(210px + (100% - 210px) * 0.72);
      width: calc((100% - 210px) * 0.9);
    }
  }

  /* ---- the divider: label strip with the one CTA button ---- */
  .enter {
    margin-top: 16px;
    background: var(--paper);
    color: var(--paper-ink);
  }
  .enter-in {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 26px 12px;
    display: grid;
    gap: 18px;
    align-items: center;
  }
  .enter .meta {
    display: grid;
    gap: 10px;
  }
  .enter .row1 {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .enter .mono {
    font: 400 12px/1.5 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .enter .bc {
    display: block;
    width: 140px;
    height: 26px;
    color: var(--paper-ink);
  }
  .enter .chips {
    display: flex;
    gap: 4px;
    max-width: 260px;
  }
  .enter .chips i {
    flex: 1;
    height: 14px;
    background: var(--c);
  }
  .enter .sub {
    opacity: 0.75;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 0 24px;
    background: var(--void);
    color: var(--bone);
    text-decoration: none;
    font: 600 16px/1 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.2s;
  }
  .cta:hover {
    background: var(--scarlet);
  }
  .cta svg {
    width: 18px;
    height: 18px;
    flex: none;
  }
  @media (max-width: 819px) {
    .enter .bc,
    .enter .sub {
      display: none;
    }
  }
  @media (min-width: 820px) {
    .enter-in {
      grid-template-columns: 1fr auto;
      gap: 40px;
    }
  }

  /* ---- footer: quiet, same ink bar and underline language as the nav ---- */
  .foot {
    background: var(--void);
    border-top: 1px solid var(--line);
  }
  .foot-in {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0 12px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  .foot-id {
    display: grid;
    gap: 6px;
    padding: 22px 0 18px;
  }
  .foot-id b {
    font: 700 16px/1 var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .foot-id small {
    font: 400 12px/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
  }
  @media (min-width: 900px) {
    .foot-in {
      grid-template-columns: auto 1fr;
      align-items: stretch;
      min-height: 88px;
    }
    .foot-id {
      align-content: center;
      padding: 0 40px 0 0;
    }
