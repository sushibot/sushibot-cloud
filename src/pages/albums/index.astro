---
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { eraOf } from "../../lib/archive"

const albumEntries = await getCollection("albums")
const allTracks = await getCollection("tracks", ({ data }) => data.display)

const tracksByAlbum = new Map<string, CollectionEntry<"tracks">[]>()
for (const track of allTracks) {
  const list = tracksByAlbum.get(track.data.album.id) ?? []
  list.push(track)
  tracksByAlbum.set(track.data.album.id, list)
}

const currentYear = new Date().getUTCFullYear()

const rows = albumEntries
  .map((album) => {
    const tracks = (tracksByAlbum.get(album.id) ?? []).sort(
      (a, b) => a.data.trackNumber - b.data.trackNumber,
    )
    // falls back to the current year if an album has no releaseDate (the
    // field is optional in the schema) so era bucketing never crashes --
    // flagged in the step report, not a value we're confident in
    const year = album.data.releaseDate?.getUTCFullYear() ?? currentYear
    const era = eraOf(year)
    return { album, tracks, year, era }
  })
  .sort((a, b) => a.year - b.year)

const totalTracks = rows.reduce((sum, r) => sum + r.tracks.length, 0)
const countText = `${rows.length} album${rows.length === 1 ? "" : "s"} · ${totalTracks} track${totalTracks === 1 ? "" : "s"}`

// one rail button per era actually present in the catalog, in era order,
// each jumping to that era's first (oldest) album row
const eraOrder = ["--era-2012", "--era-2015", "--era-2018", "--era-2021", "--era-2024"]
const rail = eraOrder
  .map((token) => ({ token, index: rows.findIndex((r) => r.era.token === token) }))
  .filter((e) => e.index !== -1)
  .map((e) => ({ ...e, year: rows[e.index].year }))
---

<Layout>
  <Nav />

  <section class="archives" aria-label="Archives">
   <div class="col">
    <header class="phead">
      <h1>Archives</h1>
      <p class="count" id="count">{countText}</p>
    </header>

    <div class="wheel" id="wAlbums">
      <ol id="olAlbums" aria-label="Albums">
        {
          rows.map(({ album, tracks, year, era }, i) => {
            const isSingle = tracks.length <= 1
            const track = tracks[0]
            const metaText = isSingle
              ? "Single"
              : `${tracks.length} track${tracks.length === 1 ? "" : "s"}`
            const label = `${album.data.title}, ${year}, ${isSingle ? "single" : `${tracks.length} tracks`}`
            const trackTitle = track
              ? (track.data.displayTitle ?? track.data.title)
              : undefined
            const discStyle = `--c:${era.bg};--cf:${era.fg}`
            return (
              <li class="row" data-i={i} data-era={era.token}>
                <div class="rowx">
                  {isSingle ? (
                    <button
                      type="button"
                      class="rowbtn"
                      tabindex="-1"
                      aria-label={label}
                      data-audio-url={track?.data.audioUrl}
                      data-track-title={trackTitle}
                      data-album-title={album.data.title}
                      data-album-id={album.id}
                      data-year={year}
                      data-era-bg={era.bg}
                      data-era-fg={era.fg}
                      data-code={`A${String(i + 1).padStart(2, "0")}-T${String(track?.data.trackNumber ?? 1).padStart(2, "0")}`}
                    >
                      <span class="disc" style={discStyle}>
                        <span class="yr">{year}</span>
                        <span class="bc bars" data-barcode={album.id} aria-hidden="true" />
                      </span>
                      <span class="txt">
                        <span class="name">{album.data.title}</span>
                        <span class="meta">{metaText}</span>
                      </span>
                      <span class="eq" aria-hidden="true">
                        <i /><i /><i /><i /><i />
                      </span>
                      <span class="tagf">
                        <b>A{String(i + 1).padStart(2, "0")}</b>
                        <span class="bc bars" data-barcode={`${album.id}-tag`} aria-hidden="true" />
                      </span>
                      <span class="cta cta-ico">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M7 4.5v15l13-7.5z" />
                        </svg>
                      </span>
                      <span class="rprog" aria-hidden="true">
                        <i />
                      </span>
                    </button>
                  ) : (
                    <a class="rowbtn" tabindex="-1" aria-label={label} href={`/albums/${album.id}/`} data-navigate>
                      <span class="disc" style={discStyle}>
                        <span class="yr">{year}</span>
                        <span class="bc bars" data-barcode={album.id} aria-hidden="true" />
                      </span>
                      <span class="txt">
                        <span class="name">{album.data.title}</span>
                        <span class="meta">{metaText}</span>
                      </span>
                      <span class="eq" aria-hidden="true">
                        <i /><i /><i /><i /><i />
                      </span>
                      <span class="tagf">
                        <b>A{String(i + 1).padStart(2, "0")}</b>
                        <span class="bc bars" data-barcode={`${album.id}-tag`} aria-hidden="true" />
                      </span>
                      <span class="cta">Open</span>
                      <span class="rprog" aria-hidden="true">
                        <i />
                      </span>
                    </a>
                  )}
                </div>
              </li>
            )
          })
        }
      </ol>
    </div>

    <nav class="rail" id="rail" aria-label="Jump to year">
      {
        rail.map((e) => (
          <button
            type="button"
            data-index={e.index}
            data-era={e.token}
            style={`--c:var(${e.token})`}
            aria-label={`Jump to ${e.year} onward`}
            aria-current="false"
          >
            <span>&rsquo;{String(e.year).slice(-2)}</span>
          </button>
        ))
      }
    </nav>
   </div>
  </section>
</Layout>

<style>
  /* ---- Archives section: the album wheel, sized to the viewport below
     the nav instead of the POC's fixed-height, no-page-scroll .frame/
     .shell app shell -- that model assumes the whole document is one
     self-contained SPA view, which doesn't fit a multi-page site with a
     normally-scrolling home page sitting right next to this one. ---- */
  .archives {
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--navh));
    min-height: 0;
    background: var(--void);
  }

  .phead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 12px;
    padding: 24px 16px 12px;
  }
  .phead h1 {
    margin: 0;
    font: 700 clamp(32px, 9vw, 44px) / 1.02 var(--font-display);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .count {
    font: 400 12px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash);
    margin: 0;
  }

  /* ---- rail: jump to era ---- */
  .rail {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
  }
  .rail button {
    position: relative;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 8px;
    gap: 6px;
    background: none;
    border: 0;
    cursor: pointer;
    font: 500 12px var(--font-mono);
    color: var(--ash);
  }
  .rail button::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 0;
    background: var(--c);
  }
  .rail button[aria-current="true"] {
    color: var(--bone);
  }
  .rail button[aria-current="true"]::before {
    box-shadow: 0 0 0 3px rgba(34, 211, 238, 0.35);
  }
  .rail span {
    order: -1;
  }
</style>

<script>
  import { createWheel } from "../../lib/wheel"

  /* The album wheel: shared scroll-snap mechanics (src/lib/wheel.ts),
     plus jump-to-era rail buttons and the single-track-plays /
     multi-track-navigates split described in the step instructions. */
  function initAlbumsWheel() {
    const ol = document.getElementById("olAlbums")
    const scroller = document.getElementById("wAlbums") as HTMLElement | null
    const rail = document.getElementById("rail")
    if (!ol || !scroller || !rail) return

    const deskMql = matchMedia("(min-width: 980px)")
    const rows = Array.from(ol.children) as HTMLElement[]
    let activeAudioUrl: string | null = null

    function playRow(li: HTMLElement) {
      const btn = li.querySelector(".rowbtn") as HTMLElement | null
      const audioUrl = btn?.dataset.audioUrl
      if (!btn || !audioUrl) return
      if (audioUrl === activeAudioUrl) {
        // Desktop: re-picking the already-playing row opens the stage,
        // no restart/toggle. Phones: unchanged, toggles play/pause.
        if (deskMql.matches) {
          document.dispatchEvent(new CustomEvent("player:open-stage"))
        } else {
          document.dispatchEvent(new CustomEvent("player:toggle"))
        }
        return
      }
      document.dispatchEvent(
        new CustomEvent("player:play", {
          detail: {
            queue: [
              {
                title: btn.dataset.trackTitle,
                album: btn.dataset.albumTitle,
                albumId: btn.dataset.albumId,
                audioUrl,
                code: btn.dataset.code,
                year: btn.dataset.year ? Number(btn.dataset.year) : undefined,
                trackNum: 1,
                trackTotal: 1,
                eraBg: btn.dataset.eraBg,
                eraFg: btn.dataset.eraFg,
              },
            ],
            index: 0,
            openStage: deskMql.matches,
          },
        }),
      )
    }

    const wheel = createWheel(scroller, ol, {
      onFocus: (i) => {
        const era = rows[i]?.dataset.era
        rail.querySelectorAll("button").forEach((b) => {
          b.setAttribute("aria-current", String((b as HTMLElement).dataset.era === era))
        })
      },
      onActivate: (i) => {
        if (rows[i]) playRow(rows[i])
      },
    })

    rail.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button") as HTMLButtonElement | null
      if (!b) return
      wheel.goTo(Number(b.dataset.index), true, true)
    })

    function markCurrent() {
      rows.forEach((li) => {
        const btn = li.querySelector(".rowbtn") as HTMLElement | null
        const isCurrent = !!btn?.dataset.audioUrl && btn.dataset.audioUrl === activeAudioUrl
        li.classList.toggle("is-current", isCurrent)
      })
    }

    document.addEventListener("player:state", ((event: CustomEvent) => {
      const detail = event.detail ?? {}
      activeAudioUrl = detail.audioUrl ?? null
      markCurrent()
    }) as EventListener)
    document.dispatchEvent(new CustomEvent("player:query"))

    // default focus: the most recent album, not the oldest
    wheel.goTo(rows.length - 1, false)
  }

  // Not transition:persist -- re-runs fresh on every visit to this page,
  // but the outer astro:page-load registration is guarded once so repeat
  // visits don't pile up listeners on the persistent `document`.
  if (!(window as any).__albumsWheelWired) {
    ;(window as any).__albumsWheelWired = true
    document.addEventListener("astro:page-load", initAlbumsWheel)
  }
</script>
