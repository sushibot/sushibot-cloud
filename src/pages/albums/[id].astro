---
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { eraOf, displayTrackNumber } from "../../lib/archive"

export async function getStaticPaths() {
  const albums = await getCollection("albums")

  return albums.map((album) => ({
    params: { id: album.id },
    props: { album },
  }))
}

type Props = {
  album: CollectionEntry<"albums">
}

const { album } = Astro.props
const currentYear = new Date().getUTCFullYear()

// Same "A0{n}" index tag already used as decorative chrome on the
// archives wheel -- reused here, not a new pattern, computed from this
// album's position in the same year-sorted list.
const allAlbums = await getCollection("albums")
const sortedAlbums = allAlbums
  .map((a) => ({
    id: a.id,
    year: a.data.releaseDate?.getUTCFullYear() ?? currentYear,
  }))
  .sort((a, b) => a.year - b.year)
const albumIndex = sortedAlbums.findIndex((a) => a.id === album.id)
const albumCode = `A${String(albumIndex + 1).padStart(2, "0")}`

const year = album.data.releaseDate?.getUTCFullYear() ?? currentYear
const era = eraOf(year)
const discStyle = `--c:${era.bg};--cf:${era.fg}`

const tracks = (
  await getCollection(
    "tracks",
    ({ data }) => data.album.id === album.id && data.display,
  )
).sort((a, b) => a.data.trackNumber - b.data.trackNumber)

const bpms = tracks
  .map((t) => t.data.bpm)
  .filter((b): b is number => typeof b === "number")
const metaParts = [
  `${tracks.length} track${tracks.length === 1 ? "" : "s"}`,
  bpms.length > 0 ? `${Math.min(...bpms)}–${Math.max(...bpms)} BPM` : null,
].filter(Boolean)
const metaText = metaParts.join(" · ")

// queueIndex is this track's position among only the audio-having
// tracks -- the client-side `queue` array (built below from this same
// filter) is compacted to just those, so a row's data-index has to
// match that compacted position, not its position in the full list
// (`i`, used for the visible track number instead). A disabled
// no-audio row never sets data-index, so queueIndex is never read for
// those.
let qi = 0
const trackRows = tracks.map((track, i) => ({
  track,
  i,
  queueIndex: track.data.audioUrl ? qi++ : -1,
}))
---

<Layout>
  <Nav />

  <section class="track-page" aria-label={album.data.title}>
    <div class="col">
      <!-- the album header stays put on every screen; it never collapses -->
      <header class="thead" id="thead">
        <div class="thead-full">
        <div class="thead-full-in">
        <div class="thead-row">
          <a class="back" href="/albums/">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M15 5l-7 7 7 7" />
            </svg>
            Archives
          </a>
          <p class="dim">{metaText}</p>
        </div>
        <!-- the same "A0{n}" index the archives wheel uses, on an
             era-colored tile matching this album's track number tiles -->
        <div class="thead-title">
          <span class="album-tile" style={discStyle} aria-hidden="true">{albumCode}</span>
          <h2>{album.data.title}</h2>
        </div>
        </div>
        </div>
      </header>

      {
        tracks.length > 0 ? (
          <div class="wheel" id="wTracks">
            <ol id="olTracks" aria-label="Tracks">
              {trackRows.map(({ track, i, queueIndex }) => {
                const displayTitle = track.data.displayTitle ?? track.data.title
                const hasAudio = !!track.data.audioUrl
                const label = `${displayTitle}${track.data.bpm != null ? `, ${track.data.bpm} BPM` : ""}`
                const num = String(displayTrackNumber(track, i)).padStart(2, "0")
                return (
                  <li class="row" data-i={i} data-era={era.token}>
                    <div class="rowx">
                      {hasAudio ? (
                        <a
                          class="rowbtn track-play"
                          tabindex="-1"
                          href={track.data.audioUrl}
                          aria-label={label}
                          data-index={queueIndex}
                          data-audio-url={track.data.audioUrl}
                        >
                          <!-- the whole row is the play control; the loaded
                               track swaps its number for EQ bars -->
                          <span class="disc" style={discStyle}>
                            <span class="num">{num}</span>
                            <span class="tile-eq" aria-hidden="true">
                              <i /><i /><i /><i />
                            </span>
                          </span>
                          <span class="txt">
                            <span class="name">{displayTitle}</span>
                            {(track.data.bpm != null || track.data.key) && (
                              <span class="meta">
                                {track.data.bpm != null ? `${track.data.bpm} BPM` : ""}
                                {track.data.bpm != null && track.data.key ? " · " : ""}
                                {track.data.key && <span class="key">{track.data.key}</span>}
                              </span>
                            )}
                          </span>
                          {track.data.duration && <span class="dur">{track.data.duration}</span>}
                        </a>
                      ) : (
                        <div
                          class="rowbtn rowbtn-disabled"
                          tabindex="-1"
                          aria-label={`${displayTitle} (no audio available)`}
                        >
                          <span class="disc" style={discStyle}>
                            <span class="num">{num}</span>
                          </span>
                          <span class="txt">
                            <span class="name">{displayTitle}</span>
                            {(track.data.bpm != null || track.data.key) && (
                              <span class="meta">
                                {track.data.bpm != null ? `${track.data.bpm} BPM` : ""}
                                {track.data.bpm != null && track.data.key ? " · " : ""}
                                {track.data.key && <span class="key">{track.data.key}</span>}
                              </span>
                            )}
                          </span>
                        </div>
                      )}
                    </div>
                  </li>
                )
              })}
            </ol>
          </div>
        ) : (
          <p class="empty">No tracks found.</p>
        )
      }
    </div>
  </section>

  <script
    type="application/json"
    id="album-queue"
    set:html={JSON.stringify(
      trackRows
        .filter(({ track }) => track.data.audioUrl)
        .map(({ track, i }) => ({
          id: track.id.split("/").pop(),
          title: track.data.displayTitle ?? track.data.title,
          album: album.data.title,
          albumId: album.id,
          audioUrl: track.data.audioUrl,
          bpm: track.data.bpm,
          key: track.data.key,
          code: `${albumCode}-T${String(displayTrackNumber(track, i)).padStart(2, "0")}`,
          year,
          trackNum: displayTrackNumber(track, i),
          trackTotal: tracks.length,
          eraBg: era.bg,
          eraFg: era.fg,
          eraToken: era.token,
        })),
    )}
  />
</Layout>

<script>
  import { createWheel } from "../../lib/wheel"

  function initTrackWheel() {
    const ol = document.getElementById("olTracks")
    const scroller = document.getElementById("wTracks") as HTMLElement | null
    const queueEl = document.getElementById("album-queue")
    if (!ol || !scroller || !queueEl || ol.dataset.initialized === "true") return
    ol.dataset.initialized = "true"

    let queue: {
      id?: string
      title: string
      album?: string
      albumId?: string
      audioUrl: string
      bpm?: number
      key?: string
      code?: string
      year?: number
      trackNum?: number
      trackTotal?: number
      eraBg?: string
      eraFg?: string
    }[] = []
    try {
      queue = JSON.parse(queueEl.textContent ?? "[]")
    } catch {
      queue = []
    }

    let activeAudioUrl: string | null = null
    const rows = Array.from(ol.children) as HTMLElement[]

    // every copy of a row, clones included, so the looping wheel's
    // repeats light up too
    // .is-current marks the loaded track; .is-playing additionally
    // animates its EQ bars (paused leaves them frozen)
    function markCurrent() {
      ;(Array.from(ol!.children) as HTMLElement[]).forEach((li) => {
        const btn = li.querySelector(".rowbtn") as HTMLElement | null
        const isCurrent = !!btn?.dataset.audioUrl && btn.dataset.audioUrl === activeAudioUrl
        li.classList.toggle("is-current", isCurrent)
        li.classList.toggle("is-playing", isCurrent && isPlaying)
      })
    }

    let isPlaying = false
    document.addEventListener("player:state", ((event: CustomEvent) => {
      const detail = event.detail ?? {}
      activeAudioUrl = detail.audioUrl ?? null
      isPlaying = !!detail.playing
      markCurrent()
    }) as EventListener)
    document.dispatchEvent(new CustomEvent("player:query"))

    // A row click only plays/toggles -- it never opens the stage, on
    // any screen size. The stage opens only via the bar's info area,
    // its expand button, or the mobile mini bar.
    function playRow(li: HTMLElement) {
      const link = li.querySelector(".rowbtn.track-play") as HTMLElement | null
      const audioUrl = link?.dataset.audioUrl
      if (!link || !audioUrl) return
      if (audioUrl === activeAudioUrl) {
        document.dispatchEvent(new CustomEvent("player:toggle"))
        return
      }
      const index = Number(link.dataset.index)
      const trackId = queue[index]?.id
      if (trackId) {
        const url = new URL(location.href)
        url.searchParams.set("track", trackId)
        history.replaceState(null, "", url)
      }
      document.dispatchEvent(
        new CustomEvent("player:play", {
          detail: { queue, index },
        }),
      )
    }

    // Same wheel mechanics as the archives wheel (src/lib/wheel.ts): a
    // looping wheel with the selection centered, like DDR's.
    const wheel = createWheel(scroller, ol, {
      onActivate: (i) => {
        if (rows[i]) playRow(rows[i])
      },
    })

    // Deep link support: ?track={slug} selects and loads that track into
    // the player (same "active" highlight as normal) without starting
    // playback, so a shared link previews rather than auto-plays, and
    // scrolls that row to the wheel's focus position.
    const urlTrackId = new URLSearchParams(location.search).get("track")
    if (urlTrackId) {
      const urlIndex = queue.findIndex((track) => track.id === urlTrackId)
      if (urlIndex !== -1) {
        document.dispatchEvent(
          new CustomEvent("player:play", {
            detail: { queue, index: urlIndex, autoplay: false },
          }),
        )
        wheel.goTo(urlIndex, false)
      }
    }

    // page-load entrance: spin in and land on track 01 (or the
    // deep-linked track)
    wheel.spinIn()
  }

  document.addEventListener("astro:page-load", initTrackWheel)
</script>

<style>
  .track-page {
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--navh) - var(--bar-space));
    min-height: 0;
    background: var(--void);
  }
  .thead {
    position: relative;
    z-index: 1;
    padding: 0 16px;
  }
  .thead-full-in {
    display: grid;
    gap: 10px;
    padding-bottom: 14px;
  }
  .thead-title {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  /* same chamfered, era-colored tile as the track number discs */
  .album-tile {
    flex: none;
    background: var(--c);
    color: var(--cf);
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
    box-shadow: inset 0 0 0 2px rgba(0, 0, 0, 0.18);
  }
  .album-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    font: 700 16px/1 var(--font-display);
  }
  /* Phones: rows fade out under the header instead of cutting off on
     a hard line */
  @media (max-width: 899px) {
    .thead::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      height: 24px;
      background: linear-gradient(var(--void), transparent);
      pointer-events: none;
    }
  }
  .thead h2 {
    margin: 0;
    font: 700 clamp(30px, 8.5vw, 44px) / 1.02 var(--font-display);
    text-wrap: balance;
  }
  .thead-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    width: fit-content;
    margin-left: -8px;
    padding: 0 10px 0 6px;
    background: none;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    font: 600 15px var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash);
    transition: color 0.15s;
  }
  .back:hover {
    color: var(--bone);
  }
  .dim {
    font: 400 12px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash);
    margin: 0;
  }
  .empty {
    padding: 0 16px;
    color: var(--ash);
  }
  .rowbtn-disabled {
    cursor: default;
    opacity: 0.55;
  }

  /* ---- track rows: the whole row is the play control (no play box).
     The focused row and the loaded track show the duration; the loaded
     track's EQ-bar tile lives in global.css (shared with the archives
     wheel). ---- */
  .dur {
    display: none;
    flex: none;
    margin-left: auto;
    font: 400 13px/1 var(--font-mono);
    letter-spacing: 0.06em;
    color: rgba(26, 23, 16, 0.6);
    font-variant-numeric: tabular-nums;
  }
  .row.is-focus .dur,
  .row.is-current .dur {
    display: block;
  }
  /* on a dark (unfocused) row, e.g. the playing track scrolled away */
  .row:not(.is-focus) .dur {
    color: var(--ash);
  }
</style>
