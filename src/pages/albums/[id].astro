---
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"
import { eraOf, displayTrackNumber } from "../../lib/archive"

export async function getStaticPaths() {
  const albums = await getCollection("albums")

  return albums.map((album) => ({
    params: { id: album.id },
    props: { album },
  }))
}

type Props = {
  album: CollectionEntry<"albums">
}

const { album } = Astro.props
const currentYear = new Date().getUTCFullYear()

// Same "A0{n}" index tag already used as decorative chrome on the
// archives wheel -- reused here, not a new pattern, computed from this
// album's position in the same year-sorted list.
const allAlbums = await getCollection("albums")
const sortedAlbums = allAlbums
  .map((a) => ({
    id: a.id,
    year: a.data.releaseDate?.getUTCFullYear() ?? currentYear,
  }))
  .sort((a, b) => a.year - b.year)
const albumIndex = sortedAlbums.findIndex((a) => a.id === album.id)

const year = album.data.releaseDate?.getUTCFullYear() ?? currentYear
const era = eraOf(year)
const discStyle = `--c:${era.bg};--cf:${era.fg}`

const tracks = (
  await getCollection(
    "tracks",
    ({ data }) => data.album.id === album.id && data.display,
  )
).sort((a, b) => a.data.trackNumber - b.data.trackNumber)

const bpms = tracks
  .map((t) => t.data.bpm)
  .filter((b): b is number => typeof b === "number")
const metaParts = [
  `${tracks.length} track${tracks.length === 1 ? "" : "s"}`,
  bpms.length > 0 ? `${Math.min(...bpms)}–${Math.max(...bpms)} BPM` : null,
].filter(Boolean)
const metaText = metaParts.join(" · ")

// queueIndex is this track's position among only the audio-having
// tracks -- the client-side `queue` array (built below from this same
// filter) is compacted to just those, so a row's data-index has to
// match that compacted position, not its position in the full list
// (`i`, used for the visible track number instead). A disabled
// no-audio row never sets data-index, so queueIndex is never read for
// those.
let qi = 0
const trackRows = tracks.map((track, i) => ({
  track,
  i,
  queueIndex: track.data.audioUrl ? qi++ : -1,
}))
---

<Layout>
  <Nav />

  <section class="track-page" aria-label={album.data.title}>
    <div class="col">
      <header class="thead">
        <a class="back" href="/albums/">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 5l-7 7 7 7" />
          </svg>
          Archives
        </a>
        <p class="eyebrow">A{String(albumIndex + 1).padStart(2, "0")} &middot; {year}</p>
        <h2>{album.data.title}</h2>
        <div class="thead-row">
          <p class="dim">{metaText}</p>
        </div>
      </header>

      {
        tracks.length > 0 ? (
          <div class="wheel" id="wTracks">
            <ol id="olTracks" aria-label="Tracks">
              {trackRows.map(({ track, i, queueIndex }) => {
                const displayTitle = track.data.displayTitle ?? track.data.title
                const hasAudio = !!track.data.audioUrl
                const label = `${displayTitle}${track.data.bpm != null ? `, ${track.data.bpm} BPM` : ""}`
                const num = String(displayTrackNumber(track, i)).padStart(2, "0")
                return (
                  <li class="row" data-i={i} data-era={era.token}>
                    <div class="rowx">
                      {hasAudio ? (
                        <a
                          class="rowbtn track-play"
                          tabindex="-1"
                          href={track.data.audioUrl}
                          aria-label={label}
                          data-index={queueIndex}
                          data-audio-url={track.data.audioUrl}
                        >
                          <span class="disc" style={discStyle}>
                            <span class="num">{num}</span>
                          </span>
                          <span class="txt">
                            <span class="name">{displayTitle}</span>
                            {(track.data.bpm != null || track.data.key) && (
                              <span class="meta">
                                {track.data.bpm != null ? `${track.data.bpm} BPM` : ""}
                                {track.data.bpm != null && track.data.key ? " · " : ""}
                                {track.data.key && <span class="key">{track.data.key}</span>}
                              </span>
                            )}
                          </span>
                          <span class="eq" aria-hidden="true">
                            <i /><i /><i /><i /><i />
                          </span>
                          <span class="rprog" aria-hidden="true">
                            <i />
                          </span>
                          <span class="cta cta-ico">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                              <path d="M7 4.5v15l13-7.5z" />
                            </svg>
                          </span>
                        </a>
                      ) : (
                        <div
                          class="rowbtn rowbtn-disabled"
                          tabindex="-1"
                          aria-label={`${displayTitle} (no audio available)`}
                        >
                          <span class="disc" style={discStyle}>
                            <span class="num">{num}</span>
                          </span>
                          <span class="txt">
                            <span class="name">{displayTitle}</span>
                            {(track.data.bpm != null || track.data.key) && (
                              <span class="meta">
                                {track.data.bpm != null ? `${track.data.bpm} BPM` : ""}
                                {track.data.bpm != null && track.data.key ? " · " : ""}
                                {track.data.key && <span class="key">{track.data.key}</span>}
                              </span>
                            )}
                          </span>
                        </div>
                      )}
                    </div>
                  </li>
                )
              })}
            </ol>
          </div>
        ) : (
          <p class="empty">No tracks found.</p>
        )
      }
    </div>
  </section>

  <script
    type="application/json"
    id="album-queue"
    set:html={JSON.stringify(
      trackRows
        .filter(({ track }) => track.data.audioUrl)
        .map(({ track, i }) => ({
          id: track.id.split("/").pop(),
          title: track.data.displayTitle ?? track.data.title,
          album: album.data.title,
          albumId: album.id,
          audioUrl: track.data.audioUrl,
          bpm: track.data.bpm,
          key: track.data.key,
          code: `A${String(albumIndex + 1).padStart(2, "0")}-T${String(displayTrackNumber(track, i)).padStart(2, "0")}`,
          year,
          trackNum: displayTrackNumber(track, i),
          trackTotal: tracks.length,
          eraBg: era.bg,
          eraFg: era.fg,
        })),
    )}
  />
</Layout>

<script>
  import { createWheel } from "../../lib/wheel"

  function initTrackWheel() {
    const ol = document.getElementById("olTracks")
    const scroller = document.getElementById("wTracks") as HTMLElement | null
    const queueEl = document.getElementById("album-queue")
    if (!ol || !scroller || !queueEl || ol.dataset.initialized === "true") return
    ol.dataset.initialized = "true"

    let queue: {
      id?: string
      title: string
      album?: string
      albumId?: string
      audioUrl: string
      bpm?: number
      key?: string
      code?: string
      year?: number
      trackNum?: number
      trackTotal?: number
      eraBg?: string
      eraFg?: string
    }[] = []
    try {
      queue = JSON.parse(queueEl.textContent ?? "[]")
    } catch {
      queue = []
    }

    let activeAudioUrl: string | null = null
    const rows = Array.from(ol.children) as HTMLElement[]

    function markCurrent() {
      rows.forEach((li) => {
        const btn = li.querySelector(".rowbtn") as HTMLElement | null
        const isCurrent = !!btn?.dataset.audioUrl && btn.dataset.audioUrl === activeAudioUrl
        li.classList.toggle("is-current", isCurrent)
      })
    }

    document.addEventListener("player:state", ((event: CustomEvent) => {
      const detail = event.detail ?? {}
      activeAudioUrl = detail.audioUrl ?? null
      markCurrent()
    }) as EventListener)
    document.dispatchEvent(new CustomEvent("player:query"))

    // Same breakpoint the POC's desk.matches uses for "play also opens
    // the stage".
    const deskMql = window.matchMedia("(min-width: 980px)")

    function playRow(li: HTMLElement) {
      const link = li.querySelector(".rowbtn.track-play") as HTMLElement | null
      const audioUrl = link?.dataset.audioUrl
      if (!link || !audioUrl) return
      if (audioUrl === activeAudioUrl) {
        // Desktop: re-picking the already-playing row opens the stage,
        // no restart/toggle. Phones: unchanged, toggles play/pause.
        if (deskMql.matches) {
          document.dispatchEvent(new CustomEvent("player:open-stage"))
        } else {
          document.dispatchEvent(new CustomEvent("player:toggle"))
        }
        return
      }
      const index = Number(link.dataset.index)
      const trackId = queue[index]?.id
      if (trackId) {
        const url = new URL(location.href)
        url.searchParams.set("track", trackId)
        history.replaceState(null, "", url)
      }
      document.dispatchEvent(
        new CustomEvent("player:play", {
          detail: { queue, index, openStage: deskMql.matches },
        }),
      )
    }

    // Same wheel mechanics as the archives wheel (src/lib/wheel.ts), with
    // the POC's track-panel anchor (focus sits higher than center so the
    // list doesn't open with empty space above it).
    const wheel = createWheel(scroller, ol, {
      onActivate: (i) => {
        if (rows[i]) playRow(rows[i])
      },
      anchor: 0.34,
    })

    // Deep link support: ?track={slug} selects and loads that track into
    // the player (same "active" highlight as normal) without starting
    // playback, so a shared link previews rather than auto-plays, and
    // scrolls that row to the wheel's focus position.
    const urlTrackId = new URLSearchParams(location.search).get("track")
    if (urlTrackId) {
      const urlIndex = queue.findIndex((track) => track.id === urlTrackId)
      if (urlIndex !== -1) {
        document.dispatchEvent(
          new CustomEvent("player:play", {
            detail: { queue, index: urlIndex, autoplay: false },
          }),
        )
        wheel.goTo(urlIndex, false)
      }
    }
  }

  document.addEventListener("astro:page-load", initTrackWheel)
</script>

<style>
  .track-page {
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--navh));
    min-height: 0;
    background: var(--void);
  }
  .thead {
    display: grid;
    gap: 6px;
    padding: 0 16px 12px;
  }
  .thead h2 {
    margin: 0;
    font: 700 clamp(30px, 8.5vw, 44px) / 1.02 var(--font-display);
    text-wrap: balance;
  }
  .thead-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    width: fit-content;
    margin-left: -8px;
    padding: 0 10px 0 6px;
    background: none;
    border: 0;
    text-decoration: none;
    cursor: pointer;
    font: 600 15px var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash);
    transition: color 0.15s;
  }
  .back:hover {
    color: var(--bone);
  }
  .eyebrow {
    margin: 0;
    font: 500 12px/1.2 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
  }
  .dim {
    font: 400 12px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ash);
    margin: 0;
  }
  .empty {
    padding: 0 16px;
    color: var(--ash);
  }
  .rowbtn-disabled {
    cursor: default;
    opacity: 0.55;
  }
</style>
