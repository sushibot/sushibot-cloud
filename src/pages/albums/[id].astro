---
import Layout from "../../layouts/Layout.astro"
import Nav from "../../components/Nav.astro"
import { getCollection } from "astro:content"
import type { CollectionEntry } from "astro:content"

export async function getStaticPaths() {
  const albums = await getCollection("albums")

  return albums.map((album) => ({
    params: { id: album.id },
    props: { album },
  }))
}

type Props = {
  album: CollectionEntry<"albums">
}

const { album } = Astro.props
const tracks = (
  await getCollection(
    "tracks",
    ({ data }) => data.album.id === album.id && data.display,
  )
).sort((a, b) => a.data.trackNumber - b.data.trackNumber)
---

<Layout>
  <Nav />

  <section class="album-page">
    <a class="back" href="/albums/"> ← Back to albums </a>

    <h1 class="title">{album.data.title}</h1>
    <p class="byline">By {album.data.artist}</p>
    {
      album.data.releaseDate && (
        <p class="release-date">
          Released{" "}
          <time datetime={album.data.releaseDate.toISOString()}>
            {album.data.releaseDate.toLocaleDateString("en-US", {
              timeZone: "UTC",
            })}
          </time>
        </p>
      )
    }

    <h2 class="tracks-title">Tracks</h2>
    {
      tracks.length > 0 ? (
        <ol class="tracklist" id="tracklist">
          {tracks.map((track, i) => {
            const displayTitle = track.data.displayTitle ?? track.data.title
            return (
              <li class="track-row">
                <span class="track-index">
                  <span class="track-number">{track.data.trackNumber}</span>
                  {track.data.audioUrl && (
                    <a
                      class="track-play"
                      href={track.data.audioUrl}
                      data-index={i}
                      data-audio-url={track.data.audioUrl}
                      aria-label={`Play ${displayTitle}`}
                    >
                      <span class="ic-track-icon ic-play-mini" />
                    </a>
                  )}
                </span>
                <span class="track-title">{displayTitle}</span>
                {track.data.duration && (
                  <span class="track-duration">{track.data.duration}</span>
                )}
              </li>
            )
          })}
        </ol>
      ) : (
        <p class="empty">No tracks found.</p>
      )
    }
  </section>

  <script
    type="application/json"
    id="album-queue"
    set:html={JSON.stringify(
      tracks
        .filter((track) => track.data.audioUrl)
        .map((track) => ({
          id: track.id.split("/").pop(),
          title: track.data.displayTitle ?? track.data.title,
          album: album.data.title,
          albumId: album.id,
          audioUrl: track.data.audioUrl,
        })),
    )}
  />
</Layout>

<script>
  function initTracklist() {
    const list = document.getElementById("tracklist")
    const queueEl = document.getElementById("album-queue")
    if (!list || !queueEl || list.dataset.initialized === "true") return
    list.dataset.initialized = "true"

    let queue: {
      id?: string
      title: string
      album?: string
      albumId?: string
      audioUrl: string
    }[] = []
    try {
      queue = JSON.parse(queueEl.textContent ?? "[]")
    } catch {
      queue = []
    }

    let activeAudioUrl: string | null = null
    let activePlaying = false

    function applyState() {
      list?.querySelectorAll<HTMLLIElement>(".track-row").forEach((row) => {
        const link = row.querySelector<HTMLAnchorElement>(".track-play")
        const icon = row.querySelector<HTMLSpanElement>(".ic-track-icon")
        const isActive =
          !!activeAudioUrl && link?.dataset.audioUrl === activeAudioUrl

        row.classList.toggle("is-active", isActive)
        if (icon) {
          icon.className =
            isActive && activePlaying
              ? "ic-track-icon ic-pause-mini"
              : "ic-track-icon ic-play-mini"
        }
      })
    }

    document.addEventListener("player:state", ((event: CustomEvent) => {
      const detail = event.detail ?? {}
      activeAudioUrl = detail.audioUrl ?? null
      activePlaying = !!detail.playing
      applyState()
    }) as EventListener)

    document.dispatchEvent(new CustomEvent("player:query"))

    // Deep link support: ?track={slug} selects and loads that track
    // into the player (same "active" highlight as normal) without
    // starting playback, so a shared link previews rather than
    // auto-plays.
    const urlTrackId = new URLSearchParams(location.search).get("track")
    if (urlTrackId) {
      const urlIndex = queue.findIndex((track) => track.id === urlTrackId)
      if (urlIndex !== -1) {
        document.dispatchEvent(
          new CustomEvent("player:play", {
            detail: { queue, index: urlIndex, autoplay: false },
          }),
        )
      }
    }

    function isMobile() {
      return window.matchMedia("(max-width: 680px)").matches
    }

    function playRow(row: HTMLLIElement) {
      const link = row.querySelector<HTMLAnchorElement>(".track-play")
      if (!link) return
      if (link.dataset.audioUrl === activeAudioUrl) {
        document.dispatchEvent(new CustomEvent("player:toggle"))
        return
      }
      const index = Number(link.dataset.index)
      const trackId = queue[index]?.id
      if (trackId) {
        const url = new URL(location.href)
        url.searchParams.set("track", trackId)
        history.replaceState(null, "", url)
      }
      document.dispatchEvent(
        new CustomEvent("player:play", { detail: { queue, index } }),
      )
    }

    list.querySelectorAll<HTMLLIElement>(".track-row").forEach((row) => {
      row.addEventListener("click", (event) => {
        // Desktop only plays when the (hover-revealed) icon itself is
        // clicked, same as before. Mobile has no real hover state, so
        // the icon is never reachable there -- let a tap anywhere on
        // the row play/toggle that track instead.
        const onPlayIcon = !!(event.target as HTMLElement).closest(
          ".track-play",
        )
        if (!onPlayIcon && !isMobile()) return
        event.preventDefault()
        playRow(row)
      })
    })
  }

  document.addEventListener("astro:page-load", initTracklist)
</script>

<style>
  .album-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 56px 28px 80px;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--dusk);
    text-decoration: none;
    border-bottom: 1px solid var(--dusk);
    padding-bottom: 2px;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .back:hover {
    color: var(--flare);
    border-color: var(--flare);
  }
  .title {
    margin-top: 24px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .byline {
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ash);
  }
  .release-date {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ash-dim);
  }
  .tracks-title {
    margin-top: 40px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .empty {
    margin-top: 16px;
    color: var(--ash);
  }
  .tracklist {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .track-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 10px;
    margin: 0 -10px;
    border-bottom: 1px solid var(--line);
    border-radius: 2px;
    transition: background-color 0.15s;
  }
  .track-row:hover {
    background-color: var(--static);
  }
  .track-index {
    position: relative;
    width: 1.4em;
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .track-number {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ash-dim);
    font-variant-numeric: tabular-nums;
    transition: opacity 0.1s;
  }
  .track-play {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--bone);
    text-decoration: none;
  }
  .track-row:hover .track-number {
    opacity: 0;
  }
  .track-row:hover .track-play {
    display: flex;
  }
  .ic-play-mini {
    width: 0;
    height: 0;
    margin-left: 1px;
    border-style: solid;
    border-width: 5px 0 5px 8px;
    border-color: transparent transparent transparent currentColor;
  }
  .ic-pause-mini {
    width: 8px;
    height: 10px;
    background-image: linear-gradient(
      90deg,
      currentColor 0 35%,
      transparent 35% 65%,
      currentColor 65% 100%
    );
  }
  .track-row.is-active .track-number,
  .track-row.is-active .track-title {
    color: var(--dusk);
  }
  .track-row.is-active .track-number {
    opacity: 0;
  }
  .track-row.is-active .track-play {
    display: flex;
    color: var(--dusk);
  }
  .track-title {
    flex: 1;
  }
  .track-duration {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ash);
  }

  @media (max-width: 680px) {
    .track-row {
      cursor: pointer;
    }
  }
</style>
