---
// 16:9 "banner" for the focused song or year. Until a track has real
// art (`jacket` in its JSON), the frame shows a generated placeholder:
// two seeded hues + one of four patterns, set from JS via --hue,
// --hue2, --angle and data-pattern (see jacketSeed() in
// src/lib/track-stats.ts).
---

<figure class="jacket" id="ddr-jacket" data-pattern="0">
  <div class="art" aria-hidden="true"></div>
  <img class="img" id="ddr-jacket-img" alt="" hidden />
  <figcaption class="cap">
    <span class="no" id="ddr-jacket-no"></span>
    <span class="big" id="ddr-jacket-title"></span>
    <span class="pill" id="ddr-jacket-sub"></span>
  </figcaption>
  <span class="ph" id="ddr-jacket-ph" aria-hidden="true">16:9 ART</span>
  <div class="flash" id="ddr-jacket-flash" aria-hidden="true"></div>
</figure>

<style>
  .jacket {
    --hue: 80;
    --hue2: 190;
    --angle: 30deg;
    /* inner sizes scale with the jacket itself (440 design px wide),
       so the banner reads the same at any size */
    --j: calc(100cqi / 440);
    container-type: inline-size;
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: calc(4 * var(--u));
    border: calc(4 * var(--u)) solid #fbf8dc;
    outline: calc(3 * var(--u)) solid var(--ddr-olive-5);
    box-shadow: 0 calc(5 * var(--u)) 0 rgb(0 0 0 / 0.3);
    background: #111;
  }

  .art {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      var(--angle),
      hsl(var(--hue) 95% 52%),
      hsl(var(--hue2) 90% 45%)
    );
  }
  /* 0: racing stripes */
  .jacket[data-pattern="0"] .art {
    background:
      repeating-linear-gradient(
        var(--angle),
        rgb(255 255 255 / 0.22) 0 calc(10 * var(--j)),
        transparent calc(10 * var(--j)) calc(26 * var(--j))
      ),
      linear-gradient(
        var(--angle),
        hsl(var(--hue) 95% 52%),
        hsl(var(--hue2) 90% 42%)
      );
  }
  /* 1: halftone */
  .jacket[data-pattern="1"] .art {
    background:
      radial-gradient(circle, rgb(0 0 0 / 0.35) 32%, transparent 34%) 0 0 /
        calc(14 * var(--j)) calc(14 * var(--j)),
      radial-gradient(
        ellipse at 30% 30%,
        hsl(var(--hue) 100% 62%),
        hsl(var(--hue2) 90% 38%) 75%
      );
  }
  /* 2: synth grid floor */
  .jacket[data-pattern="2"] .art {
    background:
      linear-gradient(transparent 55%, rgb(0 0 0 / 0.35)),
      repeating-linear-gradient(
        90deg,
        rgb(255 255 255 / 0.35) 0 calc(2 * var(--j)),
        transparent calc(2 * var(--j)) calc(34 * var(--j))
      ),
      repeating-linear-gradient(
        0deg,
        rgb(255 255 255 / 0.3) 0 calc(2 * var(--j)),
        transparent calc(2 * var(--j)) calc(22 * var(--j))
      ),
      linear-gradient(180deg, hsl(var(--hue2) 85% 30%), hsl(var(--hue) 95% 55%));
  }
  /* 3: sunburst */
  .jacket[data-pattern="3"] .art {
    background:
      repeating-conic-gradient(
        from var(--angle) at 70% 60%,
        rgb(255 255 255 / 0.2) 0 8deg,
        transparent 8deg 20deg
      ),
      radial-gradient(
        circle at 70% 60%,
        hsl(var(--hue) 100% 65%),
        hsl(var(--hue2) 90% 35%) 80%
      );
  }

  .img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .img[hidden] {
    display: none;
  }

  .cap {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: calc(6 * var(--j));
    padding: calc(14 * var(--j)) calc(18 * var(--j));
    pointer-events: none;
  }
  .jacket.has-art .cap,
  .jacket.has-art .ph {
    display: none;
  }
  .no {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(12 * var(--j));
    letter-spacing: 0.16em;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    padding: calc(3 * var(--j)) calc(8 * var(--j));
    border-radius: calc(3 * var(--j));
  }
  .no:empty {
    display: none;
  }
  .big {
    max-width: 100%;
    font-family: var(--font-ddr-display);
    font-size: calc(46 * var(--j));
    line-height: 0.95;
    color: #fff;
    text-transform: uppercase;
    transform: skewX(-8deg);
    transform-origin: left center;
    overflow-wrap: anywhere;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow:
      calc(3 * var(--j)) 0 0 #111,
      calc(-3 * var(--j)) 0 0 #111,
      0 calc(3 * var(--j)) 0 #111,
      0 calc(-3 * var(--j)) 0 #111,
      calc(2 * var(--j)) calc(2 * var(--j)) 0 #111,
      calc(-2 * var(--j)) calc(-2 * var(--j)) 0 #111,
      calc(2 * var(--j)) calc(-2 * var(--j)) 0 #111,
      calc(-2 * var(--j)) calc(2 * var(--j)) 0 #111,
      calc(5 * var(--j)) calc(6 * var(--j)) 0 rgb(0 0 0 / 0.45);
  }
  .jacket.is-long .big {
    font-size: calc(32 * var(--j));
  }
  .pill {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(18 * var(--j));
    letter-spacing: 0.06em;
    color: #fff;
    background: linear-gradient(180deg, #ff5b45, #c8170a);
    border: calc(3 * var(--j)) solid #111;
    border-radius: 999px;
    padding: calc(3 * var(--j)) calc(22 * var(--j));
    text-shadow: 0 calc(2 * var(--j)) 0 rgb(0 0 0 / 0.5);
  }
  .pill:empty {
    display: none;
  }
  .ph {
    position: absolute;
    right: calc(8 * var(--j));
    bottom: calc(6 * var(--j));
    font-family: var(--font-ddr-title);
    font-weight: 700;
    font-size: calc(9 * var(--j));
    letter-spacing: 0.2em;
    color: rgb(255 255 255 / 0.75);
    background: rgb(0 0 0 / 0.35);
    padding: calc(2 * var(--j)) calc(6 * var(--j));
    border-radius: calc(2 * var(--j));
  }

  .flash {
    position: absolute;
    inset: 0;
    background: #fff;
    opacity: 0;
    pointer-events: none;
  }
  .flash.is-on {
    animation: jacket-flash 110ms steps(2, jump-none) 1;
  }
  @keyframes jacket-flash {
    0% {
      opacity: 0.95;
    }
    100% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flash.is-on {
      animation: none;
    }
  }
</style>
