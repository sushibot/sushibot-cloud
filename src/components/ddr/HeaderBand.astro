---
// "// Select Music" band + the 1P/2P lane strip beneath it.
---

<header class="hdr">
  <a class="exit" href="/" aria-label="Back to site">
    <span class="pad" aria-hidden="true">
      <i class="a up"></i><i class="a lt"></i><i class="a rt"></i><i
        class="a dn"></i>
    </span>
  </a>
  <h1 class="title">
    <span class="slashes" aria-hidden="true">//</span> Select Music
  </h1>
  <div class="toggles">
    <button class="tog" id="sfx-toggle" type="button">
      SFX <span id="sfx-toggle-state">ON</span>
    </button>
    <button class="tog" id="preview-toggle" type="button">
      PREVIEW <span id="preview-toggle-state">ON</span>
    </button>
  </div>
  <div class="counter" aria-label="Songs in this list">
    <span class="plus" aria-hidden="true"><i></i><i></i></span>
    <span class="counter-slash" aria-hidden="true">/</span>
    <span class="counter-num" id="ddr-stage-counter">00</span>
  </div>
</header>
<div class="lane">
  <span class="tag">1P</span>
  <button class="back-btn" id="ddr-back" type="button" hidden>
    <span aria-hidden="true">◀</span> BACK
  </button>
  <span class="ticks" aria-hidden="true"></span>
  <span class="tag p2">2P</span>
</div>

<style>
  .hdr {
    position: relative;
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    height: calc(80 * var(--u));
    padding: 0 calc(22 * var(--u)) 0 calc(16 * var(--u));
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.35), transparent 45%),
      linear-gradient(90deg, #dbe98a 0%, #c9dc5a 45%, #b8cb3e 100%);
    border-bottom: calc(3 * var(--u)) solid var(--ddr-olive-4);
    box-shadow: 0 calc(3 * var(--u)) 0 rgb(0 0 0 / 0.25);
  }

  .exit {
    display: grid;
    place-items: center;
    width: calc(74 * var(--u));
    height: calc(52 * var(--u));
    border-radius: calc(10 * var(--u));
    background: linear-gradient(180deg, #e9f1ff, #9fc0ff);
    border: calc(3 * var(--u)) solid #1f3f8a;
    box-shadow: inset 0 calc(-4 * var(--u)) 0 rgb(31 63 138 / 0.35);
    transition:
      transform 0.12s ease,
      filter 0.12s ease;
  }
  .exit:hover {
    filter: brightness(1.08);
  }
  .exit:active {
    transform: translateY(calc(2 * var(--u)));
  }
  .exit:focus-visible,
  .tog:focus-visible,
  .back-btn:focus-visible {
    outline: calc(3 * var(--u)) solid var(--ddr-magenta);
    outline-offset: calc(2 * var(--u));
  }
  .pad {
    position: relative;
    width: calc(34 * var(--u));
    height: calc(34 * var(--u));
  }
  .a {
    position: absolute;
    width: calc(12 * var(--u));
    height: calc(12 * var(--u));
    background: #ff4a36;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .a.up {
    left: 50%;
    top: 0;
    translate: -50% 0;
  }
  .a.dn {
    left: 50%;
    bottom: 0;
    translate: -50% 0;
    rotate: 180deg;
    background: #2f6bff;
  }
  .a.lt {
    left: 0;
    top: 50%;
    translate: 0 -50%;
    rotate: -90deg;
    background: #2f6bff;
  }
  .a.rt {
    right: 0;
    top: 50%;
    translate: 0 -50%;
    rotate: 90deg;
  }

  .title {
    margin: 0;
    font-family: var(--font-ddr-display);
    font-weight: 400;
    font-size: calc(40 * var(--u));
    letter-spacing: 0.02em;
    line-height: 1;
    color: var(--ddr-olive-5);
    text-shadow:
      0 calc(2 * var(--u)) 0 rgb(255 255 255 / 0.55),
      0 calc(-1 * var(--u)) 0 rgb(0 0 0 / 0.15);
    white-space: nowrap;
  }
  .slashes {
    color: var(--ddr-olive-3);
    letter-spacing: -0.08em;
    margin-right: 0.12em;
  }

  .toggles {
    display: flex;
    gap: calc(6 * var(--u));
    margin-left: auto;
  }
  .tog {
    font-family: var(--font-ddr-title);
    font-weight: 700;
    font-size: calc(10 * var(--u));
    letter-spacing: 0.12em;
    padding: calc(6 * var(--u)) calc(9 * var(--u));
    border-radius: calc(999 * var(--u));
    color: var(--ddr-cream);
    background: var(--ddr-olive-4);
    border: calc(2 * var(--u)) solid var(--ddr-olive-5);
    cursor: pointer;
  }
  .tog span {
    color: var(--ddr-lime);
  }
  .tog[aria-pressed="false"] span {
    color: #ff7a6b;
  }
  .tog:hover {
    background: var(--ddr-olive-3);
  }

  .counter {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    font-family: var(--font-ddr-outline);
    color: var(--ddr-olive-5);
    font-size: calc(44 * var(--u));
    line-height: 1;
  }
  .counter-slash {
    font-family: var(--font-ddr-display);
    font-size: calc(30 * var(--u));
    color: var(--ddr-olive-4);
  }
  .counter-num {
    min-width: 2ch;
    text-align: right;
  }
  .plus {
    display: flex;
    gap: calc(3 * var(--u));
  }
  .plus i {
    width: calc(20 * var(--u));
    height: calc(20 * var(--u));
    background: var(--ddr-cyan);
    clip-path: polygon(
      35% 0,
      65% 0,
      65% 35%,
      100% 35%,
      100% 65%,
      65% 65%,
      65% 100%,
      35% 100%,
      35% 65%,
      0 65%,
      0 35%,
      35% 35%
    );
    filter: drop-shadow(0 0 0 #0b4f63);
  }
  .plus i + i {
    background: #ffc53a;
  }

  .lane {
    display: flex;
    align-items: center;
    gap: calc(10 * var(--u));
    height: calc(24 * var(--u));
    padding: 0 calc(16 * var(--u));
    background: linear-gradient(180deg, #b8c94a, #98aa30);
    border-bottom: calc(2 * var(--u)) solid var(--ddr-olive-4);
  }
  .tag {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(12 * var(--u));
    color: var(--ddr-olive-5);
    letter-spacing: 0.08em;
    opacity: 0.8;
  }
  .ticks {
    flex: 1;
    align-self: stretch;
    background: repeating-linear-gradient(
      100deg,
      transparent 0 calc(74 * var(--u)),
      rgb(255 255 255 / 0.55) calc(74 * var(--u)) calc(77 * var(--u)),
      transparent calc(77 * var(--u)) calc(90 * var(--u))
    );
    opacity: 0.7;
  }
  .back-btn {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(11 * var(--u));
    letter-spacing: 0.14em;
    padding: calc(2 * var(--u)) calc(10 * var(--u));
    border-radius: calc(999 * var(--u));
    color: var(--ddr-lime-hot);
    background: var(--ddr-olive-5);
    border: calc(2 * var(--u)) solid var(--ddr-lime);
    cursor: pointer;
  }
  .back-btn:hover {
    background: var(--ddr-olive-4);
  }
  .back-btn[hidden] {
    display: none;
  }

  @media (max-width: 780px) {
    .hdr {
      height: calc(62 * var(--u));
      gap: calc(8 * var(--u));
      padding-top: env(safe-area-inset-top);
    }
    .exit {
      width: calc(48 * var(--u));
      height: calc(40 * var(--u));
    }
    .pad {
      width: calc(26 * var(--u));
      height: calc(26 * var(--u));
    }
    .a {
      width: calc(9 * var(--u));
      height: calc(9 * var(--u));
    }
    .title {
      font-size: calc(22 * var(--u));
    }
    .toggles {
      flex-direction: column;
      gap: calc(3 * var(--u));
    }
    .tog {
      font-size: calc(8 * var(--u));
      padding: calc(3 * var(--u)) calc(7 * var(--u));
    }
    .counter {
      font-size: calc(26 * var(--u));
      gap: calc(2 * var(--u));
    }
    .counter-slash {
      font-size: calc(16 * var(--u));
    }
    .plus {
      display: none;
    }
  }
</style>
