---
// Help line + "EVENT MODE" marquee band, with the transport strip
// (the page's only player UI -- the global PlayerBar is hidden here)
// sitting on top of the band.
const runs = Array.from({ length: 6 }, (_, i) => i)
---

<footer class="ftr">
  <div class="help">
    <span class="keys" aria-hidden="true">
      <span><b>▲▼</b>SELECT</span>
      <span><b>▶</b>OPEN</span>
      <span><b>◀</b>BACK</span>
      <span><b>⏎</b>DECIDE</span>
    </span>
    <span class="attract" id="ddr-attract">PRESS ANY KEY</span>
  </div>
  <div class="band">
    <div class="marquee" aria-hidden="true">
      <div class="run">{runs.map(() => <span>EVENT MODE</span>)}</div>
      <div class="run">{runs.map(() => <span>EVENT MODE</span>)}</div>
    </div>
    <div class="transport">
      <div class="btns">
        <button
          class="tb"
          id="ddr-prev"
          type="button"
          aria-label="Previous track"
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M6 5h2v14H6zM20 5v14L9 12z"></path></svg
          >
        </button>
        <button
          class="tb play"
          id="ddr-play"
          type="button"
          aria-label="Play"
          disabled
        >
          <svg class="ic-play" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M7 4v16l13-8z"></path></svg
          >
          <svg class="ic-pause" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M6 4h4v16H6zM14 4h4v16h-4z"></path></svg
          >
        </button>
        <button
          class="tb"
          id="ddr-next"
          type="button"
          aria-label="Next track"
          disabled
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M16 5h2v14h-2zM4 5v14l11-7z"></path></svg
          >
        </button>
      </div>
      <div class="np">
        <span class="np-label" id="ddr-np-label">NO DISC</span>
        <span class="np-title" id="ddr-np-title">Select a song</span>
      </div>
      <div
        class="progress"
        id="ddr-progress"
        role="slider"
        tabindex="0"
        aria-label="Seek"
        aria-valuemin="0"
        aria-valuemax="0"
        aria-valuenow="0"
      >
        <span class="progress-fill" id="ddr-progress-fill"></span>
      </div>
      <span class="time" id="ddr-np-time">0:00 / 0:00</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .help {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: calc(18 * var(--u));
    height: calc(22 * var(--u));
    font-family: var(--font-ddr-title);
    font-weight: 700;
    font-size: calc(10 * var(--u));
    letter-spacing: 0.16em;
    color: var(--ddr-cream);
    text-shadow: 0 1px 0 #1d2405;
  }
  .keys {
    display: flex;
    gap: calc(18 * var(--u));
  }
  .keys b {
    display: inline-block;
    margin-right: calc(5 * var(--u));
    padding: 0 calc(4 * var(--u));
    border-radius: calc(3 * var(--u));
    background: var(--ddr-blue);
    color: #fff;
    text-shadow: none;
  }
  .attract {
    color: var(--ddr-lime-hot);
  }
  .attract[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .attract {
      animation: blink 1.1s steps(2, jump-none) infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.15;
    }
  }

  .band {
    position: relative;
    flex: 1;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.25), transparent 30%),
      linear-gradient(90deg, #c6d956, #b2c63a 50%, #c6d956);
    border-top: calc(3 * var(--u)) solid var(--ddr-olive-4);
  }
  .marquee {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    width: max-content;
  }
  .run {
    display: flex;
    flex-shrink: 0;
  }
  .run span {
    padding: 0 calc(26 * var(--u));
    font-family: var(--font-ddr-outline);
    font-style: italic;
    font-size: calc(48 * var(--u));
    line-height: 1;
    color: rgb(29 36 5 / 0.35);
    transform: skewX(-10deg);
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: no-preference) {
    .marquee {
      animation: marquee 28s linear infinite;
    }
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .transport {
    position: absolute;
    inset: calc(10 * var(--u)) calc(16 * var(--u));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.1fr) auto;
    align-items: center;
    gap: calc(14 * var(--u));
    padding: 0 calc(14 * var(--u)) 0 calc(8 * var(--u));
    border-radius: 999px;
    background: rgb(20 25 4 / 0.82);
    border: calc(2 * var(--u)) solid var(--ddr-olive-5);
    box-shadow: inset 0 0 0 calc(1 * var(--u)) rgb(198 245 46 / 0.25);
  }
  .btns {
    display: flex;
    gap: calc(4 * var(--u));
  }
  .tb {
    display: grid;
    place-items: center;
    width: calc(34 * var(--u));
    height: calc(34 * var(--u));
    border-radius: 50%;
    border: calc(2 * var(--u)) solid var(--ddr-olive-3);
    background: #283008;
    color: var(--ddr-cream);
    cursor: pointer;
    transition:
      background-color 0.12s ease,
      transform 0.12s ease;
  }
  .tb svg {
    width: 52%;
    height: 52%;
    fill: currentColor;
  }
  .tb.play {
    width: calc(40 * var(--u));
    height: calc(40 * var(--u));
    background: var(--ddr-lime);
    border-color: var(--ddr-lime-hot);
    color: var(--ddr-ink);
  }
  .tb:hover:not(:disabled) {
    background: var(--ddr-olive-3);
  }
  .tb.play:hover:not(:disabled) {
    background: var(--ddr-lime-hot);
  }
  .tb:active:not(:disabled) {
    transform: scale(0.94);
  }
  .tb:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .tb:focus-visible,
  .progress:focus-visible {
    outline: calc(3 * var(--u)) solid var(--ddr-magenta);
    outline-offset: calc(2 * var(--u));
  }
  .ic-pause {
    display: none;
  }
  .tb.play.is-playing .ic-play {
    display: none;
  }
  .tb.play.is-playing .ic-pause {
    display: block;
  }

  .np {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
    min-width: 0;
    line-height: 1.1;
  }
  .np-label {
    font-family: var(--font-ddr-title);
    font-weight: 700;
    font-size: calc(8 * var(--u));
    letter-spacing: 0.24em;
    color: #b7c46a;
  }
  .np-title {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(14 * var(--u));
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ddr-cream);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .progress {
    position: relative;
    height: calc(10 * var(--u));
    border-radius: 999px;
    background: #2f3a0b;
    border: calc(1 * var(--u)) solid rgb(198 245 46 / 0.3);
    cursor: pointer;
    overflow: hidden;
  }
  .progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background:
      repeating-linear-gradient(
        -45deg,
        rgb(255 255 255 / 0.25) 0 calc(4 * var(--u)),
        transparent calc(4 * var(--u)) calc(8 * var(--u))
      ),
      var(--ddr-lime);
  }
  .time {
    font-family: var(--font-ddr-title);
    font-weight: 700;
    font-size: calc(11 * var(--u));
    letter-spacing: 0.08em;
    color: var(--ddr-cream);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .help {
      font-size: calc(9 * var(--u));
    }
    .keys {
      display: none;
    }
    .transport {
      inset: calc(8 * var(--u)) calc(10 * var(--u))
        calc(8 * var(--u) + env(safe-area-inset-bottom));
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      row-gap: calc(4 * var(--u));
      border-radius: calc(18 * var(--u));
      padding: calc(6 * var(--u)) calc(12 * var(--u)) calc(6 * var(--u))
        calc(8 * var(--u));
    }
    .btns {
      grid-row: span 2;
    }
    .progress {
      grid-column: 2;
    }
    .time {
      display: none;
    }
    .run span {
      font-size: calc(40 * var(--u));
    }
  }
</style>
