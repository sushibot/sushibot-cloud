---
// The song wheel. Rows are cloned from the <template> below by
// src/scripts/ddr/wheel.ts -- the template lives in this component so
// the clones keep this component's scoped styles.
---

<div class="wheel-wrap">
  <div class="backdrop" aria-hidden="true"></div>
  <ol class="wheel" id="wheel" role="listbox" tabindex="0" aria-label="Music">
  </ol>
  <div class="cursor" id="ddr-cursor" aria-hidden="true">
    <span class="cursor-tip"></span>
  </div>
  <div class="scrollbar" aria-hidden="true">
    <span class="sb-arrow up"></span>
    <span class="sb-track"
      ><span class="sb-thumb" id="ddr-scroll-thumb"></span></span
    >
    <span class="sb-arrow dn"></span>
  </div>
  <template id="wheel-row-template">
    <li class="row" role="option" aria-selected="false">
      <span class="row-body">
        <span class="title-box"><span class="row-title"></span></span>
        <span class="sub-box"><span class="row-sub"></span></span>
      </span>
      <span class="row-badge" aria-hidden="true"></span>
    </li>
  </template>
</div>

<style>
  .wheel-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(6 * var(--u));
  }

  .backdrop {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        0deg,
        rgb(0 0 0 / 0.18) 0 1px,
        transparent 1px calc(26 * var(--u))
      ),
      repeating-linear-gradient(
        90deg,
        rgb(0 0 0 / 0.18) 0 1px,
        transparent 1px calc(26 * var(--u))
      ),
      linear-gradient(
        90deg,
        rgb(78 90 22 / 0.2),
        rgb(44 52 11 / 0.55) 45%,
        rgb(44 52 11 / 0.7)
      );
  }

  .wheel {
    position: absolute;
    inset: 0 calc(30 * var(--u)) 0 0;
    margin: 0;
    padding: 0;
    list-style: none;
    perspective: calc(900 * var(--u));
    touch-action: none;
    outline: none;
    --row-h: calc(54 * var(--u));
  }
  .wheel:focus-visible ~ .cursor {
    outline: calc(3 * var(--u)) solid var(--ddr-magenta);
    outline-offset: calc(3 * var(--u));
  }

  /* ---------- rows ---------- */
  .row {
    --cat: var(--ddr-cat-0);
    position: absolute;
    left: calc(26 * var(--u));
    right: 0;
    top: 50%;
    height: var(--row-h);
    margin-top: calc(var(--row-h) / -2);
    transform-origin: 0% 50%;
    will-change: transform, opacity;
    cursor: pointer;
    /* chevron-cut bar */
    clip-path: polygon(
      calc(var(--row-h) * 0.32) 0,
      100% 0,
      100% 100%,
      calc(var(--row-h) * 0.32) 100%,
      0 50%
    );
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.12), transparent 40%),
      linear-gradient(90deg, #3d4a0e 0%, #2a3309 70%, rgb(42 51 9 / 0.6) 100%);
  }
  .row[data-cat="1"] {
    --cat: var(--ddr-cat-1);
  }
  .row[data-cat="2"] {
    --cat: var(--ddr-cat-2);
  }
  .row[data-cat="3"] {
    --cat: var(--ddr-cat-3);
  }
  .row[data-cat="4"] {
    --cat: var(--ddr-cat-4);
  }
  .row[data-cat="5"] {
    --cat: var(--ddr-cat-5);
  }

  .row::before {
    /* bright chevron edge */
    content: "";
    position: absolute;
    inset: 0;
    clip-path: polygon(
      calc(var(--row-h) * 0.32) 0,
      calc(var(--row-h) * 0.32 + 5px) 0,
      5px 50%,
      calc(var(--row-h) * 0.32 + 5px) 100%,
      calc(var(--row-h) * 0.32) 100%,
      0 50%
    );
    background: rgb(214 232 110 / 0.55);
  }

  .row-body {
    position: absolute;
    inset: 0 calc(16 * var(--u)) 0 calc(var(--row-h) * 0.45);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(var(--row-h) * 0.02);
    min-width: 0;
  }
  .title-box,
  .sub-box {
    display: block;
    overflow: hidden;
    white-space: nowrap;
  }
  .row-title,
  .row-sub {
    display: inline-block;
    transform: scaleX(var(--squish, 1));
    transform-origin: 0 50%;
  }
  .row-title {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(var(--row-h) * 0.4);
    line-height: 1.05;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--cat);
    text-shadow:
      2px 0 0 #121703,
      -2px 0 0 #121703,
      0 2px 0 #121703,
      0 -2px 0 #121703,
      2px 2px 0 #121703,
      -2px -2px 0 #121703,
      2px -2px 0 #121703,
      -2px 2px 0 #121703;
  }
  .row-sub {
    font-family: var(--font-ddr-title);
    font-weight: 700;
    font-size: calc(var(--row-h) * 0.2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ddr-cream);
    text-shadow:
      1px 0 0 #121703,
      -1px 0 0 #121703,
      0 1px 0 #121703,
      0 -1px 0 #121703;
  }

  .row-badge {
    position: absolute;
    right: calc(10 * var(--u));
    top: 50%;
    translate: 0 -50%;
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: calc(var(--row-h) * 0.34);
  }
  .row.is-playing .row-badge,
  .row.is-previewing .row-badge {
    display: flex;
  }
  .row-badge::before,
  .row-badge::after {
    content: "";
    width: calc(var(--row-h) * 0.08);
    height: 100%;
    background: var(--ddr-lime);
    box-shadow:
      calc(var(--row-h) * -0.12) 0 0 var(--ddr-lime),
      calc(var(--row-h) * -0.24) 0 0 var(--ddr-lime);
    transform-origin: bottom;
  }
  .row.is-previewing .row-badge::before,
  .row.is-previewing .row-badge::after {
    background: var(--ddr-magenta);
    box-shadow:
      calc(var(--row-h) * -0.12) 0 0 var(--ddr-magenta),
      calc(var(--row-h) * -0.24) 0 0 var(--ddr-magenta);
  }

  .row.is-selected {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.35), transparent 50%),
      linear-gradient(90deg, #a9c43a 0%, #7f9a1f 55%, rgb(92 112 22 / 0.8) 100%);
  }
  .row.is-selected::before {
    background: var(--ddr-lime-hot);
  }
  .row.is-hovered:not(.is-selected) {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.2), transparent 50%),
      linear-gradient(90deg, #5a6c14 0%, #3b4810 70%, rgb(42 51 9 / 0.6) 100%);
  }

  /* ---------- fixed cursor frame (center slot) ---------- */
  .cursor {
    position: absolute;
    left: calc(14 * var(--u));
    right: calc(22 * var(--u));
    top: 50%;
    height: var(--cursor-px, calc(62 * var(--u)));
    translate: 0 -50%;
    pointer-events: none;
    border: calc(4 * var(--u)) solid var(--ddr-lime-hot);
    border-radius: calc(12 * var(--u)) calc(4 * var(--u)) calc(4 * var(--u))
      calc(12 * var(--u));
    box-shadow:
      0 0 0 calc(2 * var(--u)) #2a3309,
      0 0 calc(18 * var(--u)) rgb(228 255 92 / 0.55),
      inset 0 0 calc(10 * var(--u)) rgb(228 255 92 / 0.35);
  }
  .cursor-tip {
    position: absolute;
    left: calc(-14 * var(--u));
    top: 50%;
    translate: 0 -50%;
    width: calc(16 * var(--u));
    height: calc(22 * var(--u));
    background: var(--ddr-lime-hot);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    filter: drop-shadow(0 0 calc(4 * var(--u)) var(--ddr-lime));
  }
  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: breathe 1.6s ease-in-out infinite;
    }
    .cursor-tip {
      animation: nudge 0.8s ease-in-out infinite;
    }
    .row.is-playing .row-badge::before,
    .row.is-previewing .row-badge::before {
      animation: eq 0.55s ease-in-out infinite alternate;
    }
    .row.is-playing .row-badge::after,
    .row.is-previewing .row-badge::after {
      animation: eq 0.42s ease-in-out infinite alternate-reverse;
    }
  }
  @keyframes breathe {
    0%,
    100% {
      filter: brightness(1);
      box-shadow:
        0 0 0 calc(2 * var(--u)) #2a3309,
        0 0 calc(14 * var(--u)) rgb(228 255 92 / 0.4),
        inset 0 0 calc(8 * var(--u)) rgb(228 255 92 / 0.25);
    }
    50% {
      filter: brightness(1.18);
      box-shadow:
        0 0 0 calc(2 * var(--u)) #2a3309,
        0 0 calc(26 * var(--u)) rgb(228 255 92 / 0.75),
        inset 0 0 calc(14 * var(--u)) rgb(228 255 92 / 0.45);
    }
  }
  @keyframes nudge {
    50% {
      translate: calc(4 * var(--u)) -50%;
    }
  }
  @keyframes eq {
    from {
      transform: scaleY(0.3);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* ---------- scrollbar ---------- */
  .scrollbar {
    position: absolute;
    top: calc(6 * var(--u));
    bottom: calc(6 * var(--u));
    right: calc(4 * var(--u));
    width: calc(20 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(4 * var(--u));
  }
  .sb-arrow {
    width: calc(20 * var(--u));
    height: calc(18 * var(--u));
    background: #e9f5b4;
    border: calc(2 * var(--u)) solid var(--ddr-olive-5);
    display: grid;
    place-items: center;
    position: relative;
  }
  .sb-arrow::after {
    content: "";
    width: calc(10 * var(--u));
    height: calc(8 * var(--u));
    background: var(--ddr-olive-4);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .sb-arrow.dn::after {
    rotate: 180deg;
  }
  .sb-track {
    position: relative;
    flex: 1;
    width: calc(10 * var(--u));
    background: rgb(29 36 5 / 0.6);
    border: calc(1 * var(--u)) solid rgb(233 245 180 / 0.35);
  }
  .sb-thumb {
    position: absolute;
    left: calc(-2 * var(--u));
    right: calc(-2 * var(--u));
    height: calc(18 * var(--u));
    top: calc(var(--p, 0) * (100% - 18 * var(--u)));
    background: #e9f5b4;
    border: calc(2 * var(--u)) solid var(--ddr-olive-5);
  }
</style>
