---
// STAGE / SPEED plate. The BPM digits are rolled by
// src/scripts/ddr/bpm-roulette.ts.
---

<div class="plate">
  <div class="rows">
    <div class="prow">
      <span class="label">STAGE</span>
      <span class="slash" aria-hidden="true">/</span>
      <span class="val stage" id="ddr-stage">YEAR</span>
    </div>
    <div class="prow">
      <span class="label">SPEED</span>
      <span class="slash" aria-hidden="true">/</span>
      <span class="val bpm"
        ><span id="ddr-bpm">000</span><small>bpm</small></span
      >
    </div>
  </div>
  <div class="sort">
    <span>SORT</span>
    <strong id="ddr-sort">YEAR</strong>
  </div>
</div>

<style>
  .plate {
    display: flex;
    align-items: stretch;
    gap: calc(10 * var(--u));
    height: 100%;
    padding: calc(5 * var(--u)) calc(10 * var(--u)) calc(5 * var(--u))
      calc(14 * var(--u));
    border-radius: calc(10 * var(--u));
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.6), transparent 60%),
      var(--ddr-plate);
    border: calc(3 * var(--u)) solid var(--ddr-olive-4);
    box-shadow:
      inset 0 0 0 calc(2 * var(--u)) #fffbe0,
      0 calc(3 * var(--u)) 0 rgb(0 0 0 / 0.25);
    color: var(--ddr-olive-4);
  }
  .rows {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(1 * var(--u));
    min-width: 0;
  }
  .prow {
    display: flex;
    align-items: baseline;
    gap: calc(8 * var(--u));
    line-height: 1;
  }
  .label {
    width: calc(70 * var(--u));
    font-family: var(--font-ddr-title);
    font-weight: 700;
    font-style: italic;
    font-size: calc(15 * var(--u));
    letter-spacing: 0.12em;
    color: #8f9a3c;
    transform: skewX(-10deg);
  }
  .slash {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(18 * var(--u));
    color: #8f9a3c;
  }
  .val {
    font-family: var(--font-ddr-title);
    font-weight: 900;
    font-size: calc(22 * var(--u));
    letter-spacing: 0.04em;
    transform: skewX(-10deg);
    transform-origin: left bottom;
    white-space: nowrap;
    /* chunky arcade outline */
    text-shadow:
      calc(2 * var(--u)) 0 0 #fff,
      calc(-2 * var(--u)) 0 0 #fff,
      0 calc(2 * var(--u)) 0 #fff,
      0 calc(-2 * var(--u)) 0 #fff,
      calc(2 * var(--u)) calc(3 * var(--u)) 0 rgb(0 0 0 / 0.25);
  }
  .stage {
    color: var(--ddr-blue);
  }
  .bpm {
    color: var(--ddr-magenta);
    font-variant-numeric: tabular-nums;
  }
  .bpm small {
    font-size: 0.6em;
    margin-left: 0.15em;
    letter-spacing: 0.02em;
  }
  .sort {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 0 calc(10 * var(--u));
    border-left: calc(2 * var(--u)) solid rgb(78 90 22 / 0.35);
    font-family: var(--font-ddr-title);
    line-height: 1.05;
    letter-spacing: 0.08em;
  }
  .sort span {
    font-size: calc(11 * var(--u));
    font-weight: 700;
  }
  .sort strong {
    font-size: calc(16 * var(--u));
    font-weight: 900;
    color: var(--ddr-olive-5);
  }
</style>
