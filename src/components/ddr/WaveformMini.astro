---
// Mini oscilloscope. Drawn by src/scripts/ddr/waveform.ts from
// whichever AnalyserNode is audible (hover preview or main player).
---

<div class="wave" data-mode="idle">
  <div class="head">
    <span class="led" aria-hidden="true"></span>
    <span class="lbl" id="ddr-wave-label">STANDBY</span>
    <span class="meta" id="ddr-meta"></span>
  </div>
  <canvas id="ddr-wave" aria-hidden="true"></canvas>
</div>

<style>
  .wave {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--u));
    min-height: 0;
    padding: calc(6 * var(--u)) calc(9 * var(--u)) calc(7 * var(--u));
    border-radius: calc(8 * var(--u));
    background:
      repeating-linear-gradient(
        0deg,
        rgb(198 245 46 / 0.06) 0 1px,
        transparent 1px calc(8 * var(--u))
      ),
      repeating-linear-gradient(
        90deg,
        rgb(198 245 46 / 0.06) 0 1px,
        transparent 1px calc(8 * var(--u))
      ),
      #0d1103;
    border: calc(2 * var(--u)) solid var(--ddr-olive-3);
    box-shadow: inset 0 0 calc(12 * var(--u)) rgb(0 0 0 / 0.8);
  }
  .head {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    font-family: var(--font-ddr-title);
    line-height: 1;
  }
  .led {
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    border-radius: 50%;
    background: #3a4410;
  }
  .wave[data-mode="preview"] .led {
    background: var(--ddr-magenta);
    box-shadow: 0 0 calc(6 * var(--u)) var(--ddr-magenta);
  }
  .wave[data-mode="main"] .led {
    background: var(--ddr-lime);
    box-shadow: 0 0 calc(6 * var(--u)) var(--ddr-lime);
  }
  .lbl {
    font-size: calc(9 * var(--u));
    font-weight: 700;
    letter-spacing: 0.22em;
    color: #b7c46a;
  }
  .meta {
    margin-left: auto;
    font-size: calc(9 * var(--u));
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--ddr-cream);
    font-variant-numeric: tabular-nums;
  }
  canvas {
    display: block;
    width: 100%;
    flex: 1;
    min-height: 0;
  }
</style>
