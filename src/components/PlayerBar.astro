---
---

<div
  class="player-bar"
  id="player-bar"
  transition:persist
  transition:name="player-bar"
>
  <audio
    id="player-audio"
    preload="none"
    transition:persist
    transition:name="player-audio"
  ></audio>

  <div class="progress-border" id="progress-border" aria-hidden="true">
    <div class="progress-fill" id="progress-fill"></div>
  </div>

  <div class="player-inner">
    <div class="np" id="np">
      <button class="np-open" id="np-open" type="button" aria-label="Open player">
        <span class="np-title" id="np-title"></span>
      </button>
      <a class="np-album" id="np-album"></a>
    </div>

    <div class="transport">
      <div class="controls">
        <button
          class="tbtn"
          id="prev-btn"
          type="button"
          aria-label="Previous track"
          disabled
        >
          <span class="ic-skip prev"></span>
        </button>
        <button
          class="tbtn play"
          id="play-btn"
          type="button"
          aria-label="Play"
          disabled
        >
          <span class="ic-play" id="play-icon"></span>
        </button>
        <button
          class="tbtn"
          id="next-btn"
          type="button"
          aria-label="Next track"
          disabled
        >
          <span class="ic-skip"></span>
        </button>
      </div>
      <div class="scrub">
        <span class="time" id="cur-time">0:00</span>
        <input
          class="range seek"
          id="seek"
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1"
          aria-label="Seek"
          disabled
        />
        <span class="time now" id="tot-time">0:00</span>
      </div>
    </div>

    <button class="expand-btn" id="expand-btn" type="button" aria-label="Open player">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M6 15l6-6 6 6" />
      </svg>
    </button>
  </div>
</div>

<div
  class="player-drawer"
  id="player-drawer"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  transition:persist
  transition:name="player-drawer"
>
  <div class="drawer-top">
    <button
      class="drawer-close"
      id="drawer-close-btn"
      type="button"
      aria-label="Close player"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="square"
        stroke-linejoin="miter"
        aria-hidden="true"
      >
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <span class="drawer-chip">Now playing</span>
  </div>

  <div class="drawer-content">
    <div class="drawer-meta">
      <div class="drawer-title" id="drawer-title"></div>
      <a class="drawer-album" id="drawer-album"></a>
    </div>

    <div class="drawer-viz-wrap">
      <canvas id="player-viz" aria-hidden="true"></canvas>
      <div class="drawer-decal" id="drawer-decal" hidden aria-hidden="true">
        <b>Signal</b>
        <span id="drawer-decal-text"></span>
        <i></i>
      </div>
    </div>
    <div class="drawer-hazard" aria-hidden="true"></div>

    <div class="drawer-scrub">
      <input
        class="range seek"
        id="drawer-seek"
        type="range"
        min="0"
        max="1000"
        value="0"
        step="1"
        aria-label="Seek"
        disabled
      />
      <div class="drawer-times">
        <span class="time" id="drawer-cur-time">0:00</span>
        <span class="time now" id="drawer-tot-time">0:00</span>
      </div>
    </div>

    <div class="drawer-controls">
      <button
        class="tbtn"
        id="drawer-prev-btn"
        type="button"
        aria-label="Previous track"
        disabled
      >
        <span class="ic-skip prev"></span>
      </button>
      <button
        class="tbtn play"
        id="drawer-play-btn"
        type="button"
        aria-label="Play"
        disabled
      >
        <span class="ic-play" id="drawer-play-icon"></span>
      </button>
      <button
        class="tbtn"
        id="drawer-next-btn"
        type="button"
        aria-label="Next track"
        disabled
      >
        <span class="ic-skip"></span>
      </button>
    </div>
  </div>
</div>

<script>
  // body isn't a transition:persist element -- Astro replaces it with a
  // fresh node (no classes) on every navigation, unlike #player-bar
  // itself, which really does survive. Re-sync body's padding to the
  // bar's actual (persisted) state on every page load so a track
  // loaded on an earlier page doesn't leave a stale gap.
  function syncBodyPadding(bar: HTMLElement) {
    document.body.classList.toggle(
      "player-active",
      bar.classList.contains("has-track"),
    )
  }

  function initPlayerBar() {
    const bar = document.getElementById("player-bar")
    if (!bar) return
    syncBodyPadding(bar)
    if (bar.dataset.initialized === "true") return
    bar.dataset.initialized = "true"

    const audio = document.getElementById("player-audio") as HTMLAudioElement
    const playBtn = document.getElementById("play-btn") as HTMLButtonElement
    const playIcon = document.getElementById("play-icon") as HTMLSpanElement
    const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement
    const nextBtn = document.getElementById("next-btn") as HTMLButtonElement
    const seek = document.getElementById("seek") as HTMLInputElement
    const curTimeEl = document.getElementById("cur-time") as HTMLSpanElement
    const totTimeEl = document.getElementById("tot-time") as HTMLSpanElement
    const npTitle = document.getElementById("np-title") as HTMLDivElement
    const npAlbum = document.getElementById("np-album") as HTMLAnchorElement
    const progressFill = document.getElementById(
      "progress-fill",
    ) as HTMLDivElement
    const npEl = document.getElementById("np") as HTMLDivElement
    // New: explicit "open player" affordances for desktop -- a real
    // button wrapping the title (keyboard accessible), and a separate
    // visible expand control.
    const npOpenBtn = document.getElementById(
      "np-open",
    ) as HTMLButtonElement | null
    const expandBtn = document.getElementById(
      "expand-btn",
    ) as HTMLButtonElement | null
    const deskMql = matchMedia("(min-width: 980px)")

    // Drawer elements are mobile-only UI; guard each use individually
    // rather than bailing out of the whole player if one is missing.
    const drawer = document.getElementById(
      "player-drawer",
    ) as HTMLDivElement | null
    const drawerCloseBtn = document.getElementById(
      "drawer-close-btn",
    ) as HTMLButtonElement | null
    const drawerTitle = document.getElementById(
      "drawer-title",
    ) as HTMLDivElement | null
    const drawerAlbum = document.getElementById(
      "drawer-album",
    ) as HTMLAnchorElement | null
    const drawerSeek = document.getElementById(
      "drawer-seek",
    ) as HTMLInputElement | null
    const drawerCurTime = document.getElementById(
      "drawer-cur-time",
    ) as HTMLSpanElement | null
    const drawerTotTime = document.getElementById(
      "drawer-tot-time",
    ) as HTMLSpanElement | null
    const drawerPrevBtn = document.getElementById(
      "drawer-prev-btn",
    ) as HTMLButtonElement | null
    const drawerNextBtn = document.getElementById(
      "drawer-next-btn",
    ) as HTMLButtonElement | null
    const drawerPlayBtn = document.getElementById(
      "drawer-play-btn",
    ) as HTMLButtonElement | null
    const drawerPlayIcon = document.getElementById(
      "drawer-play-icon",
    ) as HTMLSpanElement | null
    // New in step 8: optional "Signal" decal (bpm/key), shown only when a
    // track carries that data, and the stage's spectrum canvas.
    const drawerDecal = document.getElementById(
      "drawer-decal",
    ) as HTMLDivElement | null
    const drawerDecalText = document.getElementById(
      "drawer-decal-text",
    ) as HTMLSpanElement | null
    const viz = document.getElementById(
      "player-viz",
    ) as HTMLCanvasElement | null

    if (
      !audio ||
      !playBtn ||
      !playIcon ||
      !prevBtn ||
      !nextBtn ||
      !seek ||
      !curTimeEl ||
      !totTimeEl ||
      !npTitle ||
      !npAlbum ||
      !npEl ||
      !progressFill
    ) {
      return
    }

    type QueueTrack = {
      title: string
      album?: string
      albumId?: string
      audioUrl: string
      // optional: not sent by any dispatcher yet (no track in the
      // content collection has bpm/key set), but the stage's decal
      // reads them if present -- never invented when absent.
      bpm?: number
      key?: string
    }

    let queue: QueueTrack[] = []
    let index = -1
    let isSeeking = false

    function fmt(seconds: number) {
      if (!Number.isFinite(seconds) || seconds < 0) return "0:00"
      const m = Math.floor(seconds / 60)
      const s = Math.floor(seconds % 60)
      return `${m}:${s < 10 ? "0" : ""}${s}`
    }

    function setRangeProgress(input: HTMLInputElement) {
      const min = Number(input.min) || 0
      const max = Number(input.max) || 100
      const value = Number(input.value)
      const pct = max > min ? ((value - min) / (max - min)) * 100 : 0
      input.style.setProperty("--progress", `${pct}%`)
      return pct
    }

    // Mobile shows a plain progress line instead of the draggable seek
    // input; keep both in sync from the same seek-input calculation.
    function syncSeekProgress() {
      const pct = setRangeProgress(seek)
      progressFill.style.width = `${pct}%`
      if (drawerSeek) {
        drawerSeek.value = seek.value
        setRangeProgress(drawerSeek)
      }
    }

    function updatePlayIcon() {
      playIcon.className = audio.paused ? "ic-play" : "ic-pause"
      playBtn.setAttribute("aria-label", audio.paused ? "Play" : "Pause")
      if (drawerPlayIcon && drawerPlayBtn) {
        drawerPlayIcon.className = audio.paused ? "ic-play" : "ic-pause"
        drawerPlayBtn.setAttribute("aria-label", audio.paused ? "Play" : "Pause")
      }
      emitState()
    }

    // Lets any page's tracklist know which track (by audioUrl) is
    // currently loaded and whether it's playing, so it can highlight
    // the matching row -- broadcast on every load/play/pause, and also
    // on request (a freshly-loaded page asks via "player:query" since
    // it can't see this closure's state directly).
    function emitState() {
      const current = index >= 0 ? queue[index] : null
      document.dispatchEvent(
        new CustomEvent("player:state", {
          detail: {
            audioUrl: current?.audioUrl ?? null,
            playing: !audio.paused,
          },
        }),
      )
    }

    function updateNav() {
      prevBtn.disabled = queue.length === 0
      nextBtn.disabled = queue.length === 0
      if (drawerPrevBtn) drawerPrevBtn.disabled = queue.length === 0
      if (drawerNextBtn) drawerNextBtn.disabled = queue.length === 0
    }

    // ---------- step 8: CORS capability check + real analyser (additive) ----------
    // Per-origin cache so a HEAD request isn't repeated for every track.
    const corsResolved = new Map<string, boolean>()
    const corsChecking = new Set<string>()
    function originOf(url: string): string | null {
      try {
        return new URL(url, location.href).origin
      } catch {
        return null
      }
    }
    function checkCorsAsync(origin: string, sampleUrl: string) {
      if (corsChecking.has(origin)) return
      corsChecking.add(origin)
      fetch(sampleUrl, { method: "HEAD", mode: "cors", cache: "no-store" })
        .then((res) => {
          corsResolved.set(
            origin,
            res.ok && res.headers.has("access-control-allow-origin"),
          )
        })
        .catch(() => {
          corsResolved.set(origin, false)
        })
    }

    let audioCtx: AudioContext | null = null
    let analyser: AnalyserNode | null = null
    let freqData: Uint8Array | null = null
    let sourceNode: MediaElementAudioSourceNode | null = null
    let analyserFailed = false

    // Only ever wires the graph once per element (createMediaElementSource
    // throws on a second call), and only once CORS is confirmed for the
    // track's origin -- otherwise the element is left exactly as it is
    // today and the simulation drives the visualizer instead.
    function ensureAudioGraph() {
      if (sourceNode || analyserFailed) return
      try {
        const AC =
          window.AudioContext || (window as any).webkitAudioContext
        if (!AC) {
          analyserFailed = true
          return
        }
        audioCtx = audioCtx || new AC()
        sourceNode = audioCtx.createMediaElementSource(audio)
        analyser = audioCtx.createAnalyser()
        analyser.fftSize = 1024
        analyser.smoothingTimeConstant = 0.55
        freqData = new Uint8Array(analyser.frequencyBinCount)
        sourceNode.connect(analyser)
        analyser.connect(audioCtx.destination)
      } catch {
        analyserFailed = true
        sourceNode = null
        analyser = null
        freqData = null
      }
    }

    function prepareAnalyser(url: string) {
      try {
        const origin = originOf(url)
        if (!origin) return
        checkCorsAsync(origin, url)
        if (corsResolved.get(origin) === true) {
          audio.crossOrigin = "anonymous"
          ensureAudioGraph()
        }
      } catch {
        analyserFailed = true
      }
    }

    function resumeAudioContextIfNeeded() {
      try {
        if (audioCtx && audioCtx.state === "suspended") audioCtx.resume()
      } catch {}
    }

    function loadTrack(newIndex: number, autoplay = true) {
      const track = queue[newIndex]
      if (!track) return
      index = newIndex
      bar.classList.add("has-track")
      syncBodyPadding(bar)
      npTitle.textContent = track.title
      npAlbum.textContent = track.album ?? ""
      if (track.albumId) {
        npAlbum.href = `/albums/${track.albumId}/`
      } else {
        npAlbum.removeAttribute("href")
      }
      if (drawerTitle) drawerTitle.textContent = track.title
      if (drawerAlbum) {
        drawerAlbum.textContent = track.album ?? ""
        if (track.albumId) drawerAlbum.href = `/albums/${track.albumId}/`
        else drawerAlbum.removeAttribute("href")
      }
      if (drawerDecal && drawerDecalText) {
        if (track.bpm != null && track.key) {
          drawerDecalText.textContent = `${track.bpm} BPM // ${track.key}`
          drawerDecal.hidden = false
        } else {
          drawerDecal.hidden = true
        }
      }
      prepareAnalyser(track.audioUrl)
      audio.src = track.audioUrl
      if (autoplay) {
        resumeAudioContextIfNeeded()
        audio.play().catch(() => {})
      }
      playBtn.disabled = false
      seek.disabled = false
      if (drawerPlayBtn) drawerPlayBtn.disabled = false
      if (drawerSeek) drawerSeek.disabled = false
      updateNav()
      emitState()
    }

    function togglePlayback() {
      if (!audio.src) return
      if (audio.paused) {
        resumeAudioContextIfNeeded()
        audio.play()
      } else audio.pause()
    }

    let drawerScrollY = 0
    // Tracks whatever had focus when the stage opened (a row on an
    // album page, the mini bar's open button, etc.) so focus can return
    // to it on close, matching the POC's open/close focus contract.
    let openerEl: HTMLElement | null = null

    // While the stage is open, everything else on the page (nav, main
    // content, the mini bar itself) becomes inert -- #player-drawer is
    // always one of body's direct children (it's transition:persist),
    // so this only ever needs to look at body's immediate children.
    function setBehindStageInert(isOpen: boolean) {
      if (!drawer) return
      for (const el of Array.from(document.body.children)) {
        if (el === drawer) continue
        ;(el as HTMLElement).inert = isOpen
      }
    }

    // overflow:hidden on body doesn't reliably block touch-scrolling on
    // iOS Safari -- pin body in place at its current scroll offset and
    // restore the real scroll position on close instead.
    function openDrawer() {
      if (!drawer || drawer.classList.contains("open")) return
      openerEl = document.activeElement as HTMLElement | null
      drawerScrollY = window.scrollY
      document.body.style.position = "fixed"
      document.body.style.top = `-${drawerScrollY}px`
      document.body.style.left = "0"
      document.body.style.right = "0"
      drawer.classList.add("open")
      drawer.setAttribute("aria-hidden", "false")
      setBehindStageInert(true)
      drawerPlayBtn?.focus({ preventScroll: true })
    }

    function closeDrawer() {
      if (!drawer || !drawer.classList.contains("open")) return
      drawer.classList.remove("open")
      drawer.setAttribute("aria-hidden", "true")
      document.body.style.position = ""
      document.body.style.top = ""
      document.body.style.left = ""
      document.body.style.right = ""
      window.scrollTo(0, drawerScrollY)
      setBehindStageInert(false)
      ;(openerEl ?? npOpenBtn)?.focus({ preventScroll: true })
      openerEl = null
    }

    playBtn.addEventListener("click", togglePlayback)
    drawerPlayBtn?.addEventListener("click", togglePlayback)

    npOpenBtn?.addEventListener("click", () => {
      if (!audio.src) return
      openDrawer()
    })
    expandBtn?.addEventListener("click", () => {
      if (!audio.src) return
      openDrawer()
    })

    drawerCloseBtn?.addEventListener("click", closeDrawer)

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return
      if (!drawer?.classList.contains("open")) return
      closeDrawer()
    })

    document.addEventListener("keydown", (event) => {
      if (event.code !== "Space" && event.key !== " ") return
      if (!audio.src) return

      const target = event.target as HTMLElement | null
      const tag = target?.tagName
      const isFormField =
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        tag === "BUTTON" ||
        target?.isContentEditable

      if (isFormField) return

      event.preventDefault()
      togglePlayback()
    })

    function goToPrev() {
      if (queue.length === 0) return
      loadTrack((index - 1 + queue.length) % queue.length)
    }

    function goToNext() {
      if (queue.length === 0) return
      loadTrack((index + 1) % queue.length)
    }

    prevBtn.addEventListener("click", goToPrev)
    nextBtn.addEventListener("click", goToNext)
    drawerPrevBtn?.addEventListener("click", goToPrev)
    drawerNextBtn?.addEventListener("click", goToNext)

    audio.addEventListener("play", updatePlayIcon)
    audio.addEventListener("pause", updatePlayIcon)
    audio.addEventListener("ended", () => {
      if (queue.length > 0) goToNext()
    })

    audio.addEventListener("loadedmetadata", () => {
      totTimeEl.textContent = fmt(audio.duration)
      seek.max = String(Math.floor(audio.duration * 1000))
      if (drawerTotTime) drawerTotTime.textContent = fmt(audio.duration)
      if (drawerSeek) drawerSeek.max = seek.max
    })

    audio.addEventListener("timeupdate", () => {
      if (isSeeking) return
      curTimeEl.textContent = fmt(audio.currentTime)
      if (drawerCurTime) drawerCurTime.textContent = fmt(audio.currentTime)
      if (audio.duration) {
        seek.value = String(Math.floor(audio.currentTime * 1000))
        syncSeekProgress()
      }
    })

    seek.addEventListener("input", () => {
      isSeeking = true
      curTimeEl.textContent = fmt(Number(seek.value) / 1000)
      if (drawerCurTime) drawerCurTime.textContent = fmt(Number(seek.value) / 1000)
      syncSeekProgress()
    })
    seek.addEventListener("change", () => {
      audio.currentTime = Number(seek.value) / 1000
      isSeeking = false
    })

    drawerSeek?.addEventListener("input", () => {
      if (!drawerSeek) return
      isSeeking = true
      seek.value = drawerSeek.value
      curTimeEl.textContent = fmt(Number(drawerSeek.value) / 1000)
      if (drawerCurTime)
        drawerCurTime.textContent = fmt(Number(drawerSeek.value) / 1000)
      syncSeekProgress()
    })
    drawerSeek?.addEventListener("change", () => {
      if (!drawerSeek) return
      audio.currentTime = Number(drawerSeek.value) / 1000
      isSeeking = false
    })

    document.addEventListener("player:play", ((event: CustomEvent) => {
      const detail = event.detail
      if (!detail || !Array.isArray(detail.queue)) return
      queue = detail.queue
      loadTrack(detail.index ?? 0, detail.autoplay ?? true)
      // Desktop (>=980px): picking a track from a row also opens the
      // stage, matching the POC's playFromUser. Re-checked here (not
      // just trusted from the dispatcher) so the stage never auto-opens
      // on a narrow viewport regardless of what a caller requests.
      if (detail.openStage && deskMql.matches) openDrawer()
    }) as EventListener)

    document.addEventListener("player:toggle", togglePlayback)

    // Re-clicking the row of the track that's already playing opens the
    // stage without restarting or toggling playback (desktop only --
    // dispatchers are expected to send player:toggle instead on mobile).
    document.addEventListener("player:open-stage", () => {
      if (!audio.src) return
      openDrawer()
    })

    document.addEventListener("player:query", emitState)

    audio.volume = 0.8
    syncSeekProgress()
    updatePlayIcon()
    updateNav()

    // ---------- step 8: --minih (mini bar height) for page bottom padding ----------
    function initMinih() {
      function set() {
        document.documentElement.style.setProperty(
          "--minih",
          bar!.offsetHeight + "px",
        )
      }
      new ResizeObserver(set).observe(bar!)
      set()
    }
    initMinih()

    // ---------- step 8: stage spectrum -- real analyser with a 118 BPM
    // simulated fallback, matching the home page's About spectrum pattern ----------
    if (viz) {
      const ctx = viz.getContext("2d")
      if (ctx) {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
        const SEG = 6,
          GAP = 3,
          BGAP = 4,
          HOLD_MS = 650,
          FALL = 2.4,
          SIM_BPM = 118
        let W = 0,
          H = 0,
          N = 0
        let lvl: number[] = [],
          peak: number[] = [],
          hold: number[] = [],
          vel: number[] = []
        const clamp = (v: number, a: number, b: number) =>
          Math.max(a, Math.min(b, v))

        new ResizeObserver(() => {
          const r = viz.getBoundingClientRect()
          const dpr = Math.min(2, devicePixelRatio || 1)
          W = r.width
          H = r.height
          viz.width = Math.round(W * dpr)
          viz.height = Math.round(H * dpr)
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
          N = clamp(Math.floor((W + BGAP) / (12 + BGAP)), 14, 40)
          lvl = Array(N).fill(0)
          peak = Array(N).fill(0)
          hold = Array(N).fill(0)
          vel = Array(N).fill(0)
        }).observe(viz)

        function targets(ts: number) {
          const out = new Array(N).fill(0)
          if (audio.paused) {
            if (!reduce)
              for (let i = 0; i < N; i++)
                out[i] = 0.05 + 0.05 * (0.5 + 0.5 * Math.sin(ts / 600 + i * 0.55))
            return out
          }
          if (analyser && freqData && !analyserFailed) {
            analyser.getByteFrequencyData(freqData)
            const nyq = (audioCtx?.sampleRate ?? 44100) / 2
            const bins = freqData.length
            const f0 = 45,
              f1 = 9000
            for (let i = 0; i < N; i++) {
              const a = f0 * Math.pow(f1 / f0, i / N)
              const b = f0 * Math.pow(f1 / f0, (i + 1) / N)
              const lo = Math.floor((a / nyq) * bins)
              const hi = Math.max(lo + 1, Math.ceil((b / nyq) * bins))
              let m = 0
              for (let k = lo; k < hi && k < bins; k++)
                if (freqData[k] > m) m = freqData[k]
              out[i] = clamp(Math.pow(m / 255, 1.7) * (1 + (i / N) * 0.35), 0, 1)
            }
            return out
          }
          // simulated fallback: fixed 118 BPM, phased off currentTime
          const ph = (audio.currentTime / (60 / SIM_BPM)) % 1
          for (let i = 0; i < N; i++) {
            const lowW = 1 - i / N
            out[i] = clamp(
              lowW * 0.95 * Math.exp(-ph * 4) +
                Math.random() * 0.25 * (0.4 + lowW * 0.6) +
                0.08,
              0,
              1,
            )
          }
          return out
        }

        let last = 0
        let vis = true
        let running = false

        function draw(ts: number) {
          const dt = Math.min(0.05, (ts - last) / 1000 || 0.016)
          last = ts
          if (W && N) {
            const tg = targets(ts)
            ctx.clearRect(0, 0, W, H)
            const bw = (W - (N - 1) * BGAP) / N
            const pitch = SEG + GAP
            const segs = Math.max(4, Math.floor((H + GAP) / pitch))
            const litColor = getComputedStyle(document.documentElement)
              .getPropertyValue("--scarlet")
              .trim() || "#C0392F"
            const hotColor = getComputedStyle(document.documentElement)
              .getPropertyValue("--pop")
              .trim() || "#E5472F"
            for (let i = 0; i < N; i++) {
              lvl[i] = Math.max(tg[i], lvl[i] - dt * 1.7)
              const L = lvl[i]
              if (L >= peak[i]) {
                peak[i] = L
                hold[i] = HOLD_MS
                vel[i] = 0
              } else if (hold[i] > 0) {
                hold[i] -= dt * 1000
              } else {
                vel[i] += FALL * dt
                peak[i] = Math.max(L, peak[i] - vel[i] * dt)
              }
              const x = i * (bw + BGAP)
              const lit = Math.round(L * segs)
              const cap = Math.min(segs - 1, Math.max(0, Math.round(peak[i] * segs) - 1))
              for (let s = 0; s < segs; s++) {
                const y = H - (s + 1) * pitch + GAP
                ctx.fillStyle =
                  s < lit
                    ? s / segs > 0.84
                      ? hotColor
                      : litColor
                    : "rgba(239,230,204,.07)"
                ctx.fillRect(x, y, bw, SEG)
              }
              if (peak[i] > 0.04) {
                ctx.fillStyle = "#EFE6CC"
                ctx.fillRect(x, H - (cap + 1) * pitch + GAP, bw, SEG)
              }
            }
          }
          if (!reduce && vis) requestAnimationFrame(draw)
          else running = false
        }
        function kick() {
          if (!running && !reduce) {
            running = true
            requestAnimationFrame(draw)
          }
        }
        new IntersectionObserver((entries) => {
          vis = entries[0].isIntersecting
          if (vis) kick()
        }).observe(drawer ?? viz)
        if (reduce) {
          for (let k = 0; k < 40; k++) draw(performance.now() + k * 40)
        }
      }
    }
  }

  document.addEventListener("astro:page-load", initPlayerBar)
</script>

