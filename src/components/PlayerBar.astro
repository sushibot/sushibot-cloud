---
import { ERA_SIGILS } from "../lib/archive"

// Frequency axis under the stage visualizer. Must match the analyser's
// log-spaced band range (f0/f1 in the spectrum code below) so each tick
// sits over the bars that really carry that frequency.
const VIZ_F0 = 45
const VIZ_F1 = 9000
const freqTicks = [
  [50, "50"],
  [100, "100"],
  [250, "250"],
  [500, "500"],
  [1000, "1k"],
  [2000, "2k"],
  [4000, "4k"],
  [8000, "8k"],
].map(([hz, label], i, all) => ({
  label,
  left: ((Math.log((hz as number) / VIZ_F0) / Math.log(VIZ_F1 / VIZ_F0)) * 100).toFixed(2),
  edge: i === 0 ? "start" : i === all.length - 1 ? "end" : undefined,
}))
---

<div
  class="player-bar"
  id="player-bar"
  transition:persist
  transition:name="player-bar"
>
  <!-- No <audio> element here -- the audio object is a detached
       singleton created once in the client script below (`new
       Audio()`, module scope), not a DOM node at all. #player-bar
       still keeps its own transition:persist for the UI chrome below
       (title, buttons, progress display), but the audio itself is
       never part of the document, so no Astro swap can ever find,
       move, or drop it. See the module-scope comment in the script
       for the WebKit/Chrome persistence issues this replaces. -->

  <div
    class="progress-border"
    id="progress-border"
    role="progressbar"
    aria-label="Playback progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <div class="progress-fill" id="progress-fill"></div>
  </div>

  <div class="player-inner">
    <div class="np" id="np">
      <!-- No cover-art field exists anywhere in the content model, so
           every track gets this era-colored, chamfered tile with its
           album's era sigil (the same marks as the archives wheel);
           paintTrackUI() shows the one for the track's era, falling
           back to the track number if a queue entry has no era. -->
      <div class="np-art" id="np-art" aria-hidden="true">
        {
          Object.entries(ERA_SIGILS).map(([token, paths]) => (
            <svg class="np-sigil" viewBox="0 0 30 30" data-era={token} hidden>
              {paths.map((d) => <path d={d} />)}
            </svg>
          ))
        }
        <span class="np-art-num" id="np-art-num"></span>
      </div>
      <div class="np-text">
        <button class="np-open" id="np-open" type="button" aria-label="Open player">
          <!-- the inner span is what the long-title marquee slides -->
          <span class="np-title" id="np-title"
            ><span class="np-title-text" id="np-title-text"></span
          ></span>
        </button>
        <!-- .np-sub is display:contents on mobile (a no-op wrapper --
             .np-album stacks exactly as it did as a direct .np-text
             child) and a flex row only at desktop width, so np-album
             and np-year sit on one "Album · Year" line there. -->
        <span class="np-sub">
          <a class="np-album" id="np-album"></a>
          <!-- Desktop only -- "· year" suffix. A new, separate
               element rather than appending year onto np-album's own
               text: np-album is shared with mobile, and mobile's text
               must not change. -->
          <span class="np-year" id="np-year"></span>
        </span>
      </div>
    </div>

    <div class="transport">
      <div class="controls">
        <button
          class="tbtn"
          id="prev-btn"
          type="button"
          aria-label="Previous track"
          disabled
        >
          <span class="ic-skip prev"></span>
        </button>
        <button
          class="tbtn play"
          id="play-btn"
          type="button"
          aria-label="Play"
          disabled
        >
          <span class="ic-play" id="play-icon"></span>
        </button>
        <button
          class="tbtn"
          id="next-btn"
          type="button"
          aria-label="Next track"
          disabled
        >
          <span class="ic-skip"></span>
        </button>
      </div>

      <!-- Desktop only -- a real, draggable, keyboard-accessible seek
           input. The mobile progress-row below is untouched: still a
           plain, non-interactive div, still role="progressbar". -->
      <div class="bar-seek-row" id="bar-seek-row">
        <span class="time" id="bar-cur-time">0:00</span>
        <input
          class="range bar-seek"
          id="bar-seek"
          type="range"
          min="0"
          max="1000"
          value="0"
          step="1000"
          aria-label="Seek"
          disabled
        />
        <span class="time now" id="bar-tot-time">0:00</span>
      </div>
    </div>

    <div class="right-controls">
      <!-- Desktop only -- volume. Mute toggle + slider, persisted to
           localStorage as sb_volume/sb_muted; see applyVolumeUI() and
           persistVolume() in the script. -->
      <div class="volume" id="volume">
        <button class="vol-btn" id="vol-btn" type="button" aria-label="Mute" data-level="high">
          <svg
            id="vol-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="square"
            stroke-linejoin="miter"
            aria-hidden="true"
          >
            <path d="M3 9v6h4l5 4V5L7 9H3z" />
            <path class="vol-arc" d="M16 9a4 4 0 0 1 0 6" />
            <path class="vol-arc vol-arc-outer" d="M19 6a8 8 0 0 1 0 12" />
          </svg>
        </button>
        <input
          class="range vol-slider"
          id="vol-slider"
          type="range"
          min="0"
          max="100"
          value="80"
          step="1"
          aria-label="Volume"
        />
      </div>

      <!-- Desktop only -- a fullscreen/expand glyph (four corner
           brackets), replacing the mobile-style chevron. Same button,
           same size, same click handler/open-stage behavior as
           before; mobile never shows this button at all (it's hidden
           below 980px already), so nothing there changes. -->
      <button class="expand-btn" id="expand-btn" type="button" aria-label="Open player">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="square"
          aria-hidden="true"
        >
          <path d="M8 4H4v4" />
          <path d="M16 4h4v4" />
          <path d="M20 16v4h-4" />
          <path d="M4 16v4h4" />
        </svg>
      </button>
    </div>
  </div>
</div>

<section
  class="player-drawer"
  id="player-drawer"
  aria-label="Now playing"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  transition:persist
  transition:name="player-drawer"
>
  <div class="stage-in">
    <div class="stage-top">
      <button
        class="icon-btn collapse"
        id="drawer-close-btn"
        type="button"
        aria-label="Back to archives"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="square"
          stroke-linejoin="miter"
          aria-hidden="true"
        >
          <path d="M15 5l-7 7 7 7" />
        </svg>
      </button>
      <!-- the barcode and the track's catalog code (A06-T04 = album 6,
           track 4), shown glitched -- purely decorative -->
      <span class="code" aria-hidden="true">
        <span id="drawer-barcode" data-barcode="stage"></span>
        <span id="drawer-code"></span>
      </span>
    </div>

    <div class="stage-head">
      <!-- the inner span is what the long-title marquee slides (phones) -->
      <h2 class="title" id="drawer-title"
        ><span class="title-text" id="drawer-title-text">Pick a track</span></h2
      >
      <p class="sub" id="drawer-sub"></p>
    </div>

    <div class="viz-wrap">
      <canvas
        id="player-viz"
        role="img"
        aria-label="Live frequency bars. A cream cap holds at each peak, then falls."
      ></canvas>
      <div class="decal" id="drawer-decal" hidden aria-hidden="true">
        <b>Signal</b>
        <span id="drawer-decal-text"></span>
        <i></i>
      </div>
    </div>
    <!-- frequency ticks at their true spots on the visualizer's log scale -->
    <div class="freq-axis" aria-hidden="true">
      {
        freqTicks.map(({ label, left, edge }) => (
          <>
            <i class="mark" style={`left:${left}%`} />
            <span class="tick" data-edge={edge} style={edge ? undefined : `left:${left}%`}>
              {label}
            </span>
          </>
        ))
      }
    </div>

    <div class="seek-row">
      <span id="drawer-cur-time">0:00</span>
      <input
        class="range"
        id="drawer-seek"
        type="range"
        min="0"
        max="1000"
        value="0"
        step="1"
        aria-label="Seek"
        disabled
      />
      <span id="drawer-tot-time">0:00</span>
    </div>

    <div class="stage-transport">
      <button
        class="icon-btn tb"
        id="drawer-prev-btn"
        type="button"
        aria-label="Previous track"
        disabled
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 5h2.5v14H6zM20 5v14L9.5 12z" />
        </svg>
        <span class="tl">Prev</span>
      </button>
      <button
        class="icon-btn tb play"
        id="drawer-play-btn"
        type="button"
        aria-label="Play"
        disabled
      >
        <span class="ic-play" id="drawer-play-icon"></span>
      </button>
      <button
        class="icon-btn tb"
        id="drawer-next-btn"
        type="button"
        aria-label="Next track"
        disabled
      >
        <span class="tl">Next</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15.5 5H18v14h-2.5zM4 5l10.5 7L4 19z" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  // body isn't a transition:persist element -- Astro replaces it with a
  // fresh node (no classes) on every navigation, unlike #player-bar
  // itself, which really does survive. Re-sync body's padding to the
  // bar's actual (persisted) state on every page load so a track
  // loaded on an earlier page doesn't leave a stale gap.
  function syncBodyPadding(bar: HTMLElement) {
    document.body.classList.toggle(
      "player-active",
      bar.classList.contains("has-track"),
    )
  }

  // Same seeded-barcode generator as Nav.astro, duplicated rather than
  // shared across a component boundary for a ~10-line utility -- the
  // stage's barcode reseeds per track (Nav's own copy only reseeds
  // per navigation), so this needs to be called directly from
  // loadTrack() below.
  function seededBarcode(seed: string, len: number, height: number) {
    let h = 2166136261
    for (let i = 0; i < seed.length; i++) {
      h ^= seed.charCodeAt(i)
      h = Math.imul(h, 16777619)
    }
    const rng = () => {
      h |= 0
      h = (h + 0x6d2b79f5) | 0
      let t = Math.imul(h ^ (h >>> 15), 1 | h)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }
    let x = 0
    let out = ""
    while (x < len) {
      const w = 1 + Math.floor(rng() * 3)
      const gap = 1 + Math.floor(rng() * 2)
      if (x + w > len) break
      out += `<rect x="${x}" y="0" width="${w}" height="${height}"/>`
      x += w + gap
    }
    return `<svg class="bars" viewBox="0 0 ${len} ${height}" width="${len}" height="${height}" aria-hidden="true" fill="currentColor">${out}</svg>`
  }

  type QueueTrack = {
    title: string
    album?: string
    albumId?: string
    audioUrl: string
    // optional: not sent by any dispatcher yet (no track in the
    // content collection has bpm/key set), but the stage's decal
    // reads them if present -- never invented when absent.
    bpm?: number
    key?: string
    // optional stage furniture, all precomputed by the dispatcher
    // (it has the album/track index and era data already, at build
    // time) rather than looked up here -- absent fields just leave
    // that piece of the subline/code off instead of inventing it.
    code?: string // "A06-T02" style
    year?: number
    trackNum?: number
    trackTotal?: number
    eraBg?: string // e.g. "var(--era-2012)"
    eraFg?: string
    eraToken?: string // e.g. "--era-2012", picks the album sigil
  }

  // ---------- the audio element: a detached singleton, not a DOM node ----------
  // Created exactly once, right here, when this script module first
  // evaluates. Astro's ClientRouter swaps the DOM on navigation but
  // never re-runs an already-loaded page module, so this one object
  // outlives every navigation for the whole tab's session -- nothing
  // in the document for Astro's swap to find, move, or drop. This
  // replaces an earlier design where <audio> lived in the DOM behind
  // #player-bar's transition:persist: that worked in Chrome but
  // WebKit doesn't implement Element.moveBefore(), so its fallback
  // swap could drop a persisted child even though the parent survived
  // -- recoverable (a later round made the recovery reliable), but a
  // replacement element has no buffered network data, so resuming it
  // always cost a brief, audible re-fetch. A singleton that's never
  // part of the document removes the failure mode entirely rather
  // than recovering from it.
  let audio: HTMLAudioElement | null = null
  let audioUnavailable = false
  try {
    audio = new Audio()
    audio.preload = "none"
    // Test-only hook: the singleton has no DOM presence anymore for
    // Playwright (or anything else) to find via getElementById, so
    // expose a reference for inspection. Read-only in spirit -- no
    // production code reads this back.
    ;(window as any).__playerAudio = audio
  } catch {
    audio = null
    audioUnavailable = true
  }

  // ---------- volume (desktop only -- the control itself doesn't
  // render on mobile, but this state lives at module scope regardless
  // so it survives navigation the same way everything else here does)
  // ---------- Read once, here, right after the singleton exists, so
  // audio.volume is correct from the very first frame rather than
  // waiting for initPlayerBar()'s first run. iOS ignores
  // element.volume entirely (per Apple's own docs, volume is only
  // user-adjustable via hardware buttons/Control Center there) --
  // this whole feature is desktop-only by design, so that's expected,
  // not a bug to work around.
  let volumeLevel = 80
  let isMuted = false
  try {
    const storedVol = Number(localStorage.getItem("sb_volume"))
    if (Number.isFinite(storedVol) && storedVol >= 0 && storedVol <= 100) volumeLevel = storedVol
    isMuted = localStorage.getItem("sb_muted") === "1"
  } catch {}
  if (audio) audio.volume = isMuted ? 0 : volumeLevel / 100

  function persistVolume() {
    try {
      localStorage.setItem("sb_volume", String(volumeLevel))
      localStorage.setItem("sb_muted", isMuted ? "1" : "0")
    } catch {}
  }

  // Applies {volumeLevel, isMuted} to the live audio element, the
  // slider's position/fill/aria-valuetext, and the icon's
  // muted/low/high state, all in one place -- called on every actual
  // change (slider drag, mute toggle) and once per page-load resync.
  function applyVolumeUI() {
    if (audio) audio.volume = isMuted ? 0 : volumeLevel / 100
    if (volSlider) {
      volSlider.value = String(volumeLevel)
      setRangeProgress(volSlider)
      volSlider.setAttribute("aria-valuetext", isMuted ? "Muted" : `${volumeLevel}%`)
    }
    if (volBtn) {
      volBtn.dataset.level = isMuted || volumeLevel === 0 ? "muted" : volumeLevel <= 50 ? "low" : "high"
      volBtn.setAttribute("aria-label", isMuted ? "Unmute" : "Mute")
    }
  }

  // ---------- debug mode (?debug=1, ?noanalyser=1) ----------
  // Persisted via sessionStorage so they stay on across client-side
  // navigation without retyping the query string on every page. This
  // is diagnostic-only: neither flag changes behavior for a normal
  // visit, and noanalyser is only meant for isolating whether the Web
  // Audio graph is implicated in FAIL A (lock-screen skip/auto-advance
  // going silent after the first track) -- it is NOT a fix, just a way
  // to test with that whole code path removed from the picture.
  //
  // An explicit URL always wins over whatever's stored: if EITHER
  // `debug` or `noanalyser` appears in this load's query string at
  // all, both flags are fully recomputed from this URL in one shot
  // (any value other than "1", including the param being entirely
  // absent, means off) and that overwrites storage. A URL with neither
  // param leaves whatever's already stored untouched. This was added
  // after a stuck noanalyser=1 was reported from a *private* Safari
  // tab with a clean ?debug=1 URL -- ruled out a stale deployed
  // bundle, a service worker, a cookie, and window.name/referrer (none
  // of that exists in this logic at all); the leading explanation is a
  // documented WebKit behavior where Private Browsing shares
  // sessionStorage across tabs within one private session rather than
  // isolating per-tab. This fix makes the exact mechanism moot either
  // way: a clean ?debug=1 now always forces noanalyser off regardless
  // of what's stored.
  let debugMode = false
  let noAnalyser = false
  let debugSource: "url" | "storage" | "default" = "default"
  let noAnalyserSource: "url" | "storage" | "default" = "default"
  let flagConflictWarning: string | null = null
  try {
    const params = new URLSearchParams(location.search)
    const debugParam = params.get("debug")
    const noAnalyserParam = params.get("noanalyser")

    // A conflict is only real if a prior value actually existed --
    // sessionStorage.getItem returning null (nothing ever stored) must
    // never be treated as "previously off," or the very first explicit
    // ?noanalyser=1 of a brand-new session would spuriously warn about
    // a conflict with a value that was never there.
    const warnIfConflicting = (priorRaw: string | null, newVal: string) => {
      if (priorRaw !== null && priorRaw !== newVal) {
        flagConflictWarning = `noanalyser was stored=${priorRaw}, this URL implies ${newVal} -- using ${newVal}`
      }
    }

    if (debugParam !== null) {
      // debug explicitly declared this load -- also resets noanalyser
      // to off unless THIS SAME url explicitly declares it too, so a
      // plain ?debug=1 can never silently inherit a stuck noanalyser
      // from storage (the bug this whole fix exists for).
      const newNoAnalyser = noAnalyserParam === "1" ? "1" : "0"
      warnIfConflicting(sessionStorage.getItem("sb_noanalyser"), newNoAnalyser)
      sessionStorage.setItem("sb_debug", debugParam === "1" ? "1" : "0")
      sessionStorage.setItem("sb_noanalyser", newNoAnalyser)
    } else if (noAnalyserParam !== null) {
      // noanalyser declared alone, debug not mentioned at all -- only
      // this one flag changes. debugMode is deliberately left
      // untouched: a tester toggling noanalyser mid-session while
      // debug is already on should never have debug mode silently
      // turned off as a side effect.
      const newNoAnalyser = noAnalyserParam === "1" ? "1" : "0"
      warnIfConflicting(sessionStorage.getItem("sb_noanalyser"), newNoAnalyser)
      sessionStorage.setItem("sb_noanalyser", newNoAnalyser)
    }
    // Neither param present: storage is left completely untouched.

    debugMode = sessionStorage.getItem("sb_debug") === "1"
    noAnalyser = sessionStorage.getItem("sb_noanalyser") === "1"
    debugSource = debugParam !== null
      ? "url"
      : sessionStorage.getItem("sb_debug") !== null ? "storage" : "default"
    noAnalyserSource = noAnalyserParam !== null
      ? "url"
      : debugParam !== null
        ? "default" // reset to off as a side effect of an explicit ?debug= URL
        : sessionStorage.getItem("sb_noanalyser") !== null ? "storage" : "default"
  } catch {}

  // Full diagnostic log for FAIL A. Kept at module scope (survives
  // navigation) and rendered into a panel that's recreated each
  // astro:page-load (the DOM gets swapped; the log data doesn't).
  // This is meant to be read directly on the phone after unlocking it,
  // not pulled from a devtools console the user can't easily attach
  // while testing lock-screen behavior -- see PROGRESS.md for the full
  // legend of what each line prefix means.
  const debugLogLines: string[] = []
  function debugLog(line: string) {
    if (!debugMode) return
    const t = (performance.now() / 1000).toFixed(2)
    debugLogLines.push(`[${t}s] ${line}`)
    renderDebugLog()
  }
  function renderDebugLog() {
    if (!debugPanel) return
    const body = debugPanel.querySelector("#sb-debug-log") as HTMLDivElement | null
    if (!body) return
    body.textContent = debugLogLines.join("\n")
    body.scrollTop = body.scrollHeight
  }

  let debugPanel: HTMLDivElement | null = null
  let debugStatusLine: HTMLDivElement | null = null
  let debugWarningLine: HTMLDivElement | null = null
  function ensureDebugPanel() {
    if (!debugMode) return
    if (debugPanel && document.body.contains(debugPanel)) return
    debugPanel = document.createElement("div")
    debugPanel.id = "sb-debug-panel"
    // Anchored BELOW the real nav (top: var(--navh), the same custom
    // property PlayerBar's own stage already uses for the identical
    // reason -- see the stage's own comment above), not at bare top:0
    // and not at the bottom. A bare top:0 panel sat directly on top of
    // the site's own nav links (confirmed: a real, non-forced tap on
    // "Archives" in the nav timed out as blocked, underneath the
    // panel). A bottom-anchored panel sat on top of the player bar's
    // own tap targets instead (an earlier draft, caught the same way,
    // via a Playwright click failing with "subtree intercepts pointer
    // events" on #next-btn). max-height is capped by BOTH a flat 32vh
    // ceiling AND `100dvh - navh - 100px` (100px is the player bar's
    // own height plus its mobile bottom padding, with a small margin),
    // whichever is smaller -- so on no viewport size can the panel
    // reach down far enough to cover the player bar either.
    debugPanel.style.cssText =
      "position:fixed;top:var(--navh);left:0;right:0;" +
      "max-height:min(32vh, calc(100dvh - var(--navh) - 100px));overflow:hidden;" +
      "display:flex;flex-direction:column;" +
      "background:rgba(0,0,0,.88);color:#9f9;font:11px/1.4 monospace;" +
      "padding:6px 8px;z-index:999999;pointer-events:auto;"
    debugStatusLine = document.createElement("div")
    debugStatusLine.id = "sb-debug-status"
    debugStatusLine.style.cssText = "color:#ff9;font-weight:bold;flex:none;"
    if (flagConflictWarning) {
      debugWarningLine = document.createElement("div")
      debugWarningLine.id = "sb-debug-warning"
      debugWarningLine.style.cssText = "color:#f66;font-weight:bold;flex:none;"
      debugWarningLine.textContent = `⚠ ${flagConflictWarning}`
      debugPanel.appendChild(debugWarningLine)
    }
    const logBody = document.createElement("div")
    logBody.id = "sb-debug-log"
    logBody.style.cssText = "overflow:auto;white-space:pre-wrap;flex:1;margin-top:4px;"
    debugPanel.appendChild(debugStatusLine)
    debugPanel.appendChild(logBody)
    document.body.appendChild(debugPanel)
    setAnalyserStatusLine()
    renderDebugLog()
  }
  // Reports WHY the current mode is what it is, not just the mode
  // itself -- distinguishes a flag forced off by an explicit URL from
  // one left on by stale storage, and a CORS probe that hasn't
  // resolved yet (still possibly "sim" for now, might go "live" on a
  // later track) from one that's definitively failed (never will).
  function setAnalyserStatusLine() {
    if (!debugMode || !debugStatusLine) return
    let reason: string
    if (noAnalyser) {
      reason = noAnalyserSource === "url" ? "disabled(url)" : "disabled(storage)"
    } else if (analyserFailed) {
      reason = "disabled(ctx failed)"
    } else if (corsResolved.get(CORS_WARMUP_ORIGIN ?? "") === false) {
      reason = "disabled(probe failed)"
    } else if (analyser) {
      reason = audioCtx?.state === "suspended" ? "suspended" : "live"
    } else {
      reason = "sim"
    }
    const search = location.search || "(none)"
    debugStatusLine.textContent =
      `analyser: ${reason}\n` +
      `search=${search}  debug:${debugSource} noanalyser:${noAnalyserSource}`
  }

  // visibilitychange fires on lock/unlock and background/foreground --
  // registered once, here, since `document` itself is the same object
  // for the whole tab session regardless of client-side navigation.
  // Re-asserts UI state (not just logs it) on becoming visible again --
  // a targeted fix for a reported "error banner stuck after a lock-
  // screen Next": the underlying setErrorUI(false) calls already run
  // correctly on a successful track change, but if a DOM write made
  // while the tab was hidden/backgrounded isn't repainted until it's
  // visible again, this forces a fresh re-apply of whatever the state
  // actually is right when it matters -- the same resync pattern
  // initPlayerBar() already uses after a navigation, applied here for
  // a visibility change instead.
  document.addEventListener("visibilitychange", () => {
    debugLog(`visibilitychange: ${document.visibilityState}`)
    if (document.visibilityState === "visible") {
      setErrorUI(playbackError, "visibilitychange resync")
      updatePlayIcon()
      syncProgress()
    }
  })

  let queue: QueueTrack[] = []
  let index = -1
  let isSeeking = false
  // Distinct from `!audio.paused`: .paused flips to false the instant
  // .play() is called, even while the element is still buffering and
  // producing no sound yet. The visualizer needs to know when playback
  // has actually, audibly started (the "playing" event) vs. merely
  // been requested, so a stall or a fresh track loading doesn't show
  // the energetic pattern while nothing is actually audible.
  let isActuallyPlaying = false
  let playbackError = false

  // UI element refs -- unlike `audio` above, these DO live in the
  // swapped DOM and are re-queried on every astro:page-load.
  let bar: HTMLElement | null = null
  let playBtn: HTMLButtonElement | null = null
  let playIcon: HTMLSpanElement | null = null
  let prevBtn: HTMLButtonElement | null = null
  let nextBtn: HTMLButtonElement | null = null
  // Desktop only -- the bar's own interactive seek input (replaces the
  // old non-interactive .bar-progress div entirely; it was already
  // desktop-only -- hidden below 980px -- so nothing on mobile ever
  // used it).
  let barSeek: HTMLInputElement | null = null
  let curTimeEl: HTMLSpanElement | null = null
  let totTimeEl: HTMLSpanElement | null = null
  let npTitle: HTMLDivElement | null = null
  let npTitleText: HTMLSpanElement | null = null
  let npAlbum: HTMLAnchorElement | null = null
  // Desktop only -- the album/year subtitle and the era-colored
  // placeholder tile's track-number text.
  let npYear: HTMLSpanElement | null = null
  let npArtNum: HTMLSpanElement | null = null
  let npArt: HTMLDivElement | null = null
  let progressFill: HTMLDivElement | null = null
  let progressBorder: HTMLDivElement | null = null
  let npEl: HTMLDivElement | null = null
  let npOpenBtn: HTMLButtonElement | null = null
  let expandBtn: HTMLButtonElement | null = null
  // Desktop only -- volume.
  let volBtn: HTMLButtonElement | null = null
  let volIcon: SVGSVGElement | null = null
  let volSlider: HTMLInputElement | null = null
  let drawer: HTMLDivElement | null = null
  let drawerCloseBtn: HTMLButtonElement | null = null
  let drawerTitle: HTMLDivElement | null = null
  let drawerTitleText: HTMLSpanElement | null = null
  let drawerSub: HTMLParagraphElement | null = null
  let drawerBarcode: HTMLSpanElement | null = null
  let drawerCode: HTMLSpanElement | null = null
  let drawerSeek: HTMLInputElement | null = null
  let drawerCurTime: HTMLSpanElement | null = null
  let drawerTotTime: HTMLSpanElement | null = null
  let drawerPrevBtn: HTMLButtonElement | null = null
  let drawerNextBtn: HTMLButtonElement | null = null
  let drawerPlayBtn: HTMLButtonElement | null = null
  let drawerPlayIcon: HTMLSpanElement | null = null
  let drawerDecal: HTMLDivElement | null = null
  let drawerDecalText: HTMLSpanElement | null = null
  let viz: HTMLCanvasElement | null = null

  function fmt(seconds: number) {
    if (!Number.isFinite(seconds) || seconds < 0) return "0:00"
    const m = Math.floor(seconds / 60)
    const s = Math.floor(seconds % 60)
    return `${m}:${s < 10 ? "0" : ""}${s}`
  }

  // Shared by #drawer-seek and #bar-seek -- generic over any range
  // input. #bar-seek isn't scrubbable yet (drag wiring is a later
  // phase); syncProgress() calls this just to keep its thumb position
  // visually in sync with playback in the meantime.
  function setRangeProgress(input: HTMLInputElement) {
    const min = Number(input.min) || 0
    const max = Number(input.max) || 100
    const value = Number(input.value)
    const pct = max > min ? ((value - min) / (max - min)) * 100 : 0
    input.style.setProperty("--progress", `${pct}%`)
    return pct
  }

  // Drives both progress indicators straight from audio state: the
  // desktop bar's own seek input (unless the user is actively
  // dragging it -- see isSeeking below, same guard #drawer-seek
  // already uses) and the mobile mini bar's top-edge line, which is
  // still plain and non-interactive, untouched by this round.
  function syncProgress() {
    if (!audio || !progressFill || !progressBorder) return
    const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0
    const rounded = String(Math.round(pct))
    if (barSeek && !isSeeking) {
      barSeek.value = String(Math.floor(audio.currentTime * 1000))
      setRangeProgress(barSeek)
      barSeek.setAttribute("aria-valuetext", fmt(audio.currentTime))
    }
    progressFill.style.width = `${pct}%`
    progressBorder.setAttribute("aria-valuenow", rounded)
  }

  function updatePlayIcon() {
    if (!audio || !playIcon || !playBtn) return
    playIcon.className = audio.paused ? "ic-play" : "ic-pause"
    playBtn.setAttribute("aria-label", audio.paused ? "Play" : "Pause")
    if (drawerPlayIcon && drawerPlayBtn) {
      drawerPlayIcon.className = audio.paused ? "ic-play" : "ic-pause"
      drawerPlayBtn.setAttribute("aria-label", audio.paused ? "Play" : "Pause")
    }
    if ("mediaSession" in navigator) {
      const state = audio.paused ? "paused" : "playing"
      navigator.mediaSession.playbackState = state
      debugLog(`mediaSession.playbackState := ${state}`)
    }
    emitState()
  }

  // Lets any page's tracklist know which track (by audioUrl) is
  // currently loaded and whether it's playing, so it can highlight
  // the matching row -- broadcast on every load/play/pause, and also
  // on request (a freshly-loaded page asks via "player:query" since
  // it can't see this module's state directly).
  function emitState() {
    if (!audio) return
    const current = index >= 0 ? queue[index] : null
    document.dispatchEvent(
      new CustomEvent("player:state", {
        detail: {
          audioUrl: current?.audioUrl ?? null,
          playing: !audio.paused,
        },
      }),
    )
  }

  function updateNav() {
    if (!prevBtn || !nextBtn) return
    prevBtn.disabled = queue.length === 0
    nextBtn.disabled = queue.length === 0
    if (drawerPrevBtn) drawerPrevBtn.disabled = queue.length === 0
    if (drawerNextBtn) drawerNextBtn.disabled = queue.length === 0
  }

  // No visible banner -- removed per direct instruction (deliberate
  // deviation from the POC). A data-error attribute on the bar is the
  // only on-page signal left, and it's intentionally unstyled: the
  // real surfaces for this are console.error and the debug panel log,
  // both wired at the error listener below.
  function setErrorUI(hasError: boolean, source: string) {
    playbackError = hasError
    if (bar) {
      if (hasError) bar.setAttribute("data-error", "")
      else bar.removeAttribute("data-error")
    }
    debugLog(`setErrorUI(${hasError}) <- ${source}`)
  }

  // ---------- CORS capability check + real analyser ----------
  // Per-origin cache so a HEAD request isn't repeated for every track.
  const corsResolved = new Map<string, boolean>()
  const corsChecking = new Set<string>()
  function originOf(url: string): string | null {
    try {
      return new URL(url, location.href).origin
    } catch {
      return null
    }
  }
  function checkCorsAsync(origin: string, sampleUrl: string) {
    if (corsChecking.has(origin)) return
    corsChecking.add(origin)
    // A `mode:"cors"` fetch's promise only resolves at all once the
    // browser has already verified the response's Access-Control-*
    // headers permit this origin -- a disallowed origin makes the
    // fetch reject (caught below), it never resolves with a non-ok
    // response for that reason. Checking for the ACAO header's
    // presence on top of that is unnecessary and was always false in
    // practice (browsers don't expose it to JS unless the server adds
    // it to Access-Control-Expose-Headers, which it has no reason to).
    fetch(sampleUrl, { method: "HEAD", mode: "cors", cache: "no-store" })
      .then((res) => {
        corsResolved.set(origin, res.ok)
      })
      .catch(() => {
        corsResolved.set(origin, false)
      })
  }

  // A fixed, always-present object on the shared audio origin, probed
  // once here at module init/idle -- *not* at the first tap. Before
  // this, the probe only ever started from inside prepareAnalyser(),
  // which only runs at tap time, so a fresh session's first track
  // could never win that race: the HEAD request hadn't even been
  // issued yet at the exact moment prepareAnalyser made its one-shot,
  // never-rechecked decision for that track. Confirmed empirically --
  // 12/12 fresh-session runs hit this before the fix, 0/12 after.
  // Starting the same probe here instead means it's almost always
  // already resolved by the time the user taps play on anything.
  const CORS_WARMUP_URL = "https://audio.sushibot.cloud/web/2012/buzz-symphony.mp3"
  const CORS_WARMUP_ORIGIN = originOf(CORS_WARMUP_URL)
  ;(() => {
    if (!CORS_WARMUP_ORIGIN) return
    const kick = () => checkCorsAsync(CORS_WARMUP_ORIGIN, CORS_WARMUP_URL)
    if ("requestIdleCallback" in window) (window as any).requestIdleCallback(kick)
    else kick()
  })()

  let audioCtx: AudioContext | null = null
  let analyser: AnalyserNode | null = null
  let freqData: Uint8Array | null = null
  let sourceNode: MediaElementAudioSourceNode | null = null
  let analyserFailed = false

  // Wires the graph exactly once for the whole session --
  // createMediaElementSource throws on a second call for the same
  // element, and since `audio` is now a singleton that's no longer a
  // "per element" constraint to work around, it's just "once, ever."
  function ensureAudioGraph() {
    if (!audio || sourceNode || analyserFailed || noAnalyser) return
    try {
      const AC = window.AudioContext || (window as any).webkitAudioContext
      if (!AC) {
        analyserFailed = true
        return
      }
      audioCtx = audioCtx || new AC()
      if (debugMode) {
        audioCtx.addEventListener("statechange", () => {
          debugLog(`audioCtx statechange: ${audioCtx!.state}`)
        })
      }
      sourceNode = audioCtx.createMediaElementSource(audio)
      analyser = audioCtx.createAnalyser()
      analyser.fftSize = 1024
      analyser.smoothingTimeConstant = 0.55
      freqData = new Uint8Array(analyser.frequencyBinCount)
      sourceNode.connect(analyser)
      analyser.connect(audioCtx.destination)
    } catch {
      analyserFailed = true
      sourceNode = null
      analyser = null
      freqData = null
    }
    setAnalyserStatusLine()
  }

  // crossOrigin is decided exactly once per track, here, strictly
  // before .src is assigned for it in loadTrack() below -- and never
  // touched again for that same load. The CORS_WARMUP_URL probe above
  // means `corsResolved` has almost always already settled by the time
  // any track is tapped. If it somehow hasn't (e.g. the probe is still
  // in flight on a very slow connection), crossOrigin is simply left
  // unset for THIS track -- the real analyser won't activate until a
  // later track, once the probe has had time to resolve. We never
  // retroactively flip crossOrigin on a load that's already in flight:
  // changing it after the fact can force the browser to redo the
  // fetch, which is exactly the kind of mid-playback disruption the
  // singleton rework exists to avoid in the first place.
  function prepareAnalyser(url: string) {
    if (!audio) return
    if (noAnalyser) {
      setAnalyserStatusLine()
      return
    }
    try {
      const origin = originOf(url)
      if (!origin) return
      checkCorsAsync(origin, url)
      if (corsResolved.get(origin) === true && audio.crossOrigin !== "anonymous") {
        audio.crossOrigin = "anonymous"
        ensureAudioGraph()
      }
    } catch {
      analyserFailed = true
    }
    setAnalyserStatusLine()
  }

  function resumeAudioContextIfNeeded() {
    try {
      if (audioCtx && audioCtx.state === "suspended") audioCtx.resume()
    } catch {}
  }

  function updateMediaSessionMetadata(track: QueueTrack) {
    if (!("mediaSession" in navigator) || typeof MediaMetadata === "undefined") return
    try {
      navigator.mediaSession.metadata = new MediaMetadata({
        title: track.title,
        artist: track.album ?? "SushiCloud",
        album: track.album ?? "",
        // No per-track artwork exists in the content model -- using
        // the site's own brand image for every track rather than
        // inventing per-track art that isn't there.
        artwork: [{ src: "/album-art/sushibot.jpg", sizes: "965x928", type: "image/jpeg" }],
      })
      debugLog(`mediaSession.metadata := "${track.title}"`)
    } catch (err) {
      debugLog(`mediaSession.metadata threw: ${(err as any)?.name ?? err}`)
    }
  }

  function updatePositionState() {
    if (!("mediaSession" in navigator) || !audio) return
    if (!Number.isFinite(audio.duration) || audio.duration <= 0) return
    try {
      navigator.mediaSession.setPositionState({
        duration: audio.duration,
        playbackRate: audio.playbackRate || 1,
        position: Math.min(audio.currentTime, audio.duration),
      })
    } catch (err) {
      // Previously fully silent -- this was explicitly called out as a
      // candidate for silently invalidating the whole action-handler
      // set on some iOS versions. Surfacing it so the next lock-screen
      // run shows whether it's actually throwing at all.
      debugLog(`mediaSession.setPositionState threw: ${(err as any)?.name ?? err}`)
    }
  }

  function setupMediaSession() {
    if (!("mediaSession" in navigator)) return
    // Logs the one-time REGISTRATION of each handler -- distinct from
    // the per-press debugLog calls below, which log each time a
    // handler actually fires. If the lock-screen's skip buttons turn
    // into +/-10s controls mid-session, comparing "were these ever
    // registered" (this line) against "did anything ever clear them"
    // (nothing in this file calls setActionHandler(action, null) --
    // confirmed by reading -- so if they do disappear, it's not this
    // code doing it on purpose) is the first thing to check.
    debugLog("setActionHandler registered: play, pause, previoustrack, nexttrack, seekto (no seekbackward/seekforward)")
    // debugLog() is synchronous (array push + a DOM textContent write)
    // -- it never introduces an await before the handler's own call,
    // which must stay direct and synchronous for iOS to accept it as
    // gesture-equivalent while the screen is locked.
    navigator.mediaSession.setActionHandler("play", () => {
      debugLog("mediaSession:play")
      togglePlayback()
    })
    navigator.mediaSession.setActionHandler("pause", () => {
      debugLog("mediaSession:pause")
      togglePlayback()
    })
    navigator.mediaSession.setActionHandler("previoustrack", () => {
      debugLog("mediaSession:previoustrack")
      goToPrev()
    })
    navigator.mediaSession.setActionHandler("nexttrack", () => {
      debugLog("mediaSession:nexttrack")
      goToNext()
    })
    navigator.mediaSession.setActionHandler("seekto", (details) => {
      debugLog(`mediaSession:seekto ${details.seekTime}`)
      if (!audio) return
      const t = details.seekTime ?? audio.currentTime
      if (details.fastSeek && "fastSeek" in audio) {
        ;(audio as any).fastSeek(t)
      } else {
        audio.currentTime = t
      }
    })
  }

  // A title too long for the bar gets a looping marquee (.marquee in the
  // CSS): after a pause the inner text span slides left to show the
  // end, holds, and slides back. Only the overflow distance and duration are set here,
  // so short titles never move and the speed is about the same for any
  // length. Re-run whenever the title or the bar's width changes.
  function fitTitleMarquee() {
    if (!npTitle) return
    titleReturn?.cancel()
    titleReturn = null
    if (fitMarquee(npTitle) && titleHovered) holdTitleMarquee()
  }
  // The same marquee for the stage's big title, which is one line on
  // phones. Measured whenever the title changes or its box resizes
  // (including the stage opening, when it first gets a width).
  function fitStageTitleMarquee() {
    if (drawerTitle) fitMarquee(drawerTitle)
  }
  // Shared by both: sets the overflow distance and cycle length on the
  // container and turns .marquee on, or leaves it off when the text
  // fits. Returns whether it's on.
  function fitMarquee(el: HTMLElement) {
    el.classList.remove("marquee")
    const shift = el.scrollWidth - el.clientWidth
    if (shift <= 1) return false
    el.style.setProperty("--marquee-shift", `${shift}px`)
    // ~40px/s across the 60% of the cycle spent sliding
    el.style.setProperty("--marquee-dur", `${Math.max(5, shift / 40 / 0.6)}s`)
    void el.offsetWidth // restart from the first hold on a new title
    el.classList.add("marquee")
    return true
  }

  // Mouse hover over the title stops the marquee and eases the text back
  // to its start, so it can be read from the beginning; leaving restarts
  // the marquee from its first pause. Mouse only -- a tap on phones
  // opens the stage, and touch "hover" would otherwise stick.
  let titleHovered = false
  let titleReturn: Animation | null = null
  function titleSlide() {
    return npTitleText
      ?.getAnimations()
      .find((a): a is CSSAnimation => a instanceof CSSAnimation)
  }
  function holdTitleMarquee() {
    const slide = titleSlide()
    if (!slide || !npTitleText) return
    slide.pause()
    const x = new DOMMatrix(getComputedStyle(npTitleText).transform).m41
    titleReturn?.cancel()
    titleReturn = npTitleText.animate(
      [{ transform: `translateX(${x}px)` }, { transform: "translateX(0)" }],
      { duration: 250, easing: "ease-out", fill: "forwards" },
    )
  }
  function releaseTitleMarquee() {
    titleReturn?.cancel()
    titleReturn = null
    const slide = titleSlide()
    if (!slide) return
    slide.currentTime = 0
    slide.play()
  }

  // Paints every piece of UI (bar + stage) for a given track. Called
  // both when a NEW track starts (from loadTrack()) and when resyncing
  // an already-playing track's info into a freshly-swapped page (see
  // initPlayerBar() below) -- the audio itself never stopped across a
  // navigation, but the DOM it's reflected into is brand new every
  // time and has to be told what's currently loaded.
  function paintTrackUI(track: QueueTrack) {
    if (!bar || !npTitle || !npTitleText || !npAlbum) return
    bar.classList.add("has-track")
    syncBodyPadding(bar)
    npTitleText.textContent = track.title
    fitTitleMarquee()
    npAlbum.textContent = track.album ?? ""
    if (track.albumId) {
      npAlbum.href = `/albums/${track.albumId}/`
    } else {
      npAlbum.removeAttribute("href")
    }
    // Desktop-only "· year" suffix, rendered right after .np-album on
    // the same line (see the np-text CSS) -- a separate element so
    // np-album's own text and link, shared with mobile, never change.
    // Skipped when the album's own title already reads as the year
    // (true for every album in this catalog today, since albums are
    // named after the year they're from) -- otherwise the subtitle
    // reads as a redundant "2012 · 2012".
    if (npYear) {
      const albumIsYear = track.year != null && track.album === String(track.year)
      npYear.textContent = track.year != null && !albumIsYear ? `· ${track.year}` : ""
    }
    // The bar's tile: the album's era sigil, or the track number if
    // this queue entry has no era. Its color comes from the same
    // --stage-era/-fg custom properties set just below, already used
    // by the full-screen stage.
    let sigilShown = false
    npArt?.querySelectorAll<SVGElement>(".np-sigil").forEach((svg) => {
      const match = !!track.eraToken && svg.dataset.era === track.eraToken
      svg.toggleAttribute("hidden", !match)
      if (match) sigilShown = true
    })
    if (npArtNum) {
      npArtNum.textContent = !sigilShown && track.trackNum != null ? String(track.trackNum) : ""
    }
    if (drawerTitleText) {
      drawerTitleText.textContent = track.title
      fitStageTitleMarquee()
    }
    if (drawerSub) {
      const parts: string[] = []
      if (track.album) parts.push(track.album)
      // skip the year when the album is already named after it (every
      // album today), same as the desktop bar's "· year" suffix
      if (track.year != null && track.album !== String(track.year)) {
        parts.push(String(track.year))
      }
      if (track.trackNum != null && track.trackTotal != null) {
        parts.push(`track ${track.trackNum} of ${track.trackTotal}`)
      }
      drawerSub.textContent = parts.join(" · ")
    }
    stageCode = track.code ?? ""
    paintStageCode()
    if (drawerBarcode) drawerBarcode.innerHTML = seededBarcode(track.audioUrl, 64, 14)
    document.documentElement.style.setProperty("--stage-era", track.eraBg ?? "var(--scarlet)")
    document.documentElement.style.setProperty("--stage-era-fg", track.eraFg ?? "var(--bone)")
    if (drawerDecal && drawerDecalText) {
      // Shown when bpm OR key is present, not just when both are --
      // the POC uses "//" as a separator between two possibly-partial
      // fields, not a requirement that both exist.
      if (track.bpm != null || track.key) {
        const bpmPart = track.bpm != null ? `${track.bpm} BPM` : ""
        const keyPart = track.key ?? ""
        drawerDecalText.textContent = [bpmPart, keyPart].filter(Boolean).join(" // ")
        drawerDecal.hidden = false
      } else {
        drawerDecal.hidden = true
      }
    }
    if (playBtn) playBtn.disabled = false
    if (drawerPlayBtn) drawerPlayBtn.disabled = false
    if (drawerSeek) drawerSeek.disabled = false
    if (barSeek) barSeek.disabled = false
    updateNav()
    updateMediaSessionMetadata(track)
  }

  function loadTrack(newIndex: number, autoplay = true) {
    if (!audio || audioUnavailable) return
    const track = queue[newIndex]
    if (!track) return
    index = newIndex
    isActuallyPlaying = false
    setErrorUI(false, "loadTrack")
    paintTrackUI(track)
    prepareAnalyser(track.audioUrl)
    debugLog(`src := ${track.audioUrl}`)
    audio.src = track.audioUrl
    if (autoplay) {
      resumeAudioContextIfNeeded()
      // .play() itself is still called synchronously, right here, in
      // direct response to a user gesture or the `ended` event's
      // auto-advance chain -- .then()/.catch() only observe what the
      // already-dispatched call resolves to, they don't delay it.
      audio.play().then(() => debugLog("play() resolved")).catch((err) => {
        debugLog(`play() rejected: ${err?.name ?? err}`)
      })
    }
    emitState()
  }

  function togglePlayback() {
    if (!audio || !audio.src) return
    if (audio.paused) {
      resumeAudioContextIfNeeded()
      audio.play().then(() => debugLog("play() resolved")).catch((err) => {
        debugLog(`play() rejected: ${err?.name ?? err}`)
      })
    } else {
      audio.pause()
    }
  }

  function goToPrev() {
    if (queue.length === 0) return
    loadTrack((index - 1 + queue.length) % queue.length)
  }

  function goToNext() {
    if (queue.length === 0) return
    loadTrack((index + 1) % queue.length)
  }

  let drawerScrollY = 0
  // Tracks whatever had focus when the stage opened (a row on an
  // album page, the mini bar's open button, etc.) so focus can return
  // to it on close, matching the POC's open/close focus contract.
  let openerEl: HTMLElement | null = null

  // While the stage is open, everything else on the page (nav, main
  // content, the mini bar itself) becomes inert -- #player-drawer is
  // always one of body's direct children (it's transition:persist),
  // so this only ever needs to look at body's immediate children.
  // Everything behind the stage goes inert while it's open -- except the
  // site nav, which stays visible above the stage and has to keep
  // working (a nav click closes the stage; see the listener in
  // initPlayerBar).
  function setBehindStageInert(isOpen: boolean) {
    if (!drawer) return
    for (const el of Array.from(document.body.children)) {
      if (el === drawer || el.matches(".top")) continue
      ;(el as HTMLElement).inert = isOpen
    }
  }

  // overflow:hidden on body doesn't reliably block touch-scrolling on
  // iOS Safari -- pin body in place at its current scroll offset and
  // restore the real scroll position on close instead.
  function openDrawer() {
    if (!drawer || drawer.classList.contains("open")) return
    openerEl = document.activeElement as HTMLElement | null
    drawerScrollY = window.scrollY
    document.body.style.position = "fixed"
    document.body.style.top = `-${drawerScrollY}px`
    document.body.style.left = "0"
    document.body.style.right = "0"
    drawer.classList.add("open")
    drawer.setAttribute("aria-hidden", "false")
    bar?.classList.add("under-stage")
    // re-scramble the glitched code every few seconds while open
    clearInterval(codeGlitchTimer)
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      codeGlitchTimer = window.setInterval(paintStageCode, 2500)
    }
    setBehindStageInert(true)
    drawerPlayBtn?.focus({ preventScroll: true })
  }

  // The stage's catalog code (A06-T04) is decorative, so it's drawn as
  // "zalgo" glitch text: one to three random combining marks stacked on
  // every real character. The span is aria-hidden; nothing is lost.
  let stageCode = ""
  let codeGlitchTimer = 0
  function glitchText(s: string) {
    let out = ""
    for (const ch of s) {
      out += ch
      const marks = 1 + Math.floor(Math.random() * 3)
      for (let k = 0; k < marks; k++) {
        // U+0300-U+036F, skipping U+034F (the invisible grapheme joiner)
        let cp = 0x300 + Math.floor(Math.random() * 0x70)
        if (cp === 0x34f) cp = 0x350
        out += String.fromCodePoint(cp)
      }
    }
    return out
  }
  function paintStageCode() {
    if (drawerCode) drawerCode.textContent = stageCode ? glitchText(stageCode) : ""
  }

  function closeDrawer() {
    if (!drawer || !drawer.classList.contains("open")) return
    clearInterval(codeGlitchTimer)
    drawer.classList.remove("open")
    bar?.classList.remove("under-stage")
    drawer.setAttribute("aria-hidden", "true")
    document.body.style.position = ""
    document.body.style.top = ""
    document.body.style.left = ""
    document.body.style.right = ""
    window.scrollTo(0, drawerScrollY)
    setBehindStageInert(false)
    ;(openerEl ?? npOpenBtn)?.focus({ preventScroll: true })
    openerEl = null
  }

  // Attaches every listener that lives directly on the audio object --
  // called exactly once, right after the singleton is constructed
  // above, not per astro:page-load (there's nothing to re-wire: it's
  // always the same object).
  function wireAudio() {
    if (!audio) return

    if (debugMode) {
      for (const ev of [
        "play", "pause", "playing", "waiting", "stalled", "ended",
        "error", "emptied", "abort", "seeking", "seeked",
        "loadstart", "canplay",
      ]) {
        audio.addEventListener(ev, () => {
          if (!audio) return
          debugLog(`audio:${ev} paused=${audio.paused} ct=${audio.currentTime.toFixed(2)} rs=${audio.readyState}`)
        })
      }
    }

    audio.addEventListener("play", updatePlayIcon)
    audio.addEventListener("pause", updatePlayIcon)
    audio.addEventListener("ended", () => {
      if (queue.length > 0) {
        debugLog("ended -> auto-advance")
        goToNext()
      }
    })

    // Drives the visualizer's idle/energetic switch -- see the
    // isActuallyPlaying declaration above for why this isn't just
    // !audio.paused.
    audio.addEventListener("playing", () => {
      isActuallyPlaying = true
      setErrorUI(false, "playing-event")
    })
    audio.addEventListener("pause", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("waiting", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("stalled", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("ended", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("error", () => {
      isActuallyPlaying = false
      const err = audio?.error
      const code = err?.code ?? 0
      const message = err?.message || ""
      // MediaError.code: 1 ABORTED, 2 NETWORK, 3 DECODE, 4 SRC_NOT_SUPPORTED.
      const codeName =
        ({ 1: "MEDIA_ERR_ABORTED", 2: "MEDIA_ERR_NETWORK", 3: "MEDIA_ERR_DECODE", 4: "MEDIA_ERR_SRC_NOT_SUPPORTED" } as Record<number, string>)[code] ??
        `unknown (${code})`
      const detail = `${codeName}${message ? ` -- ${message}` : ""}`
      if (code === 1) {
        // MEDIA_ERR_ABORTED is expected, not a real failure -- e.g. a
        // fast track switch aborts the previous track's in-flight
        // load. Logged for visibility but never treated as an error:
        // no data-error, no console.error, no setErrorUI.
        debugLog(`audio error ignored (${detail})`)
        return
      }
      console.error(`[PlayerBar] audio error: ${detail}`)
      debugLog(`audio error: ${detail}`)
      setErrorUI(true, "error-event")
    })
    audio.addEventListener("loadedmetadata", () => {
      if (!audio) return
      if (totTimeEl) totTimeEl.textContent = fmt(audio.duration)
      if (drawerTotTime) drawerTotTime.textContent = fmt(audio.duration)
      if (drawerSeek) drawerSeek.max = String(Math.floor(audio.duration * 1000))
      if (barSeek) barSeek.max = String(Math.floor(audio.duration * 1000))
      updatePositionState()
    })
    audio.addEventListener("timeupdate", () => {
      if (!audio) return
      if (isSeeking) return
      if (curTimeEl) curTimeEl.textContent = fmt(audio.currentTime)
      if (drawerCurTime) drawerCurTime.textContent = fmt(audio.currentTime)
      if (drawerSeek) {
        drawerSeek.value = String(Math.floor(audio.currentTime * 1000))
        setRangeProgress(drawerSeek)
      }
      syncProgress()
      updatePositionState()
    })

    setupMediaSession()
  }
  wireAudio()

  function initPlayerBar() {
    bar = document.getElementById("player-bar")
    if (!bar) return
    syncBodyPadding(bar)
    ensureDebugPanel()
    // The panel node itself can survive a client-side swap (it isn't
    // part of what Astro's transition touches), so ensureDebugPanel()
    // above may no-op on its "already exists" guard -- but
    // location.search is a live read, and the module script that
    // computed debugSource/noAnalyserSource only ever runs once per
    // tab, so without this the "search=" line would stay frozen on
    // whatever the tab's very first URL looked like. Refresh it
    // explicitly on every page-load regardless.
    setAnalyserStatusLine()

    playBtn = document.getElementById("play-btn") as HTMLButtonElement | null
    playIcon = document.getElementById("play-icon") as HTMLSpanElement | null
    prevBtn = document.getElementById("prev-btn") as HTMLButtonElement | null
    nextBtn = document.getElementById("next-btn") as HTMLButtonElement | null
    barSeek = document.getElementById("bar-seek") as HTMLInputElement | null
    curTimeEl = document.getElementById("bar-cur-time") as HTMLSpanElement | null
    totTimeEl = document.getElementById("bar-tot-time") as HTMLSpanElement | null
    npTitle = document.getElementById("np-title") as HTMLDivElement | null
    npTitleText = document.getElementById("np-title-text") as HTMLSpanElement | null
    npAlbum = document.getElementById("np-album") as HTMLAnchorElement | null
    npYear = document.getElementById("np-year") as HTMLSpanElement | null
    npArtNum = document.getElementById("np-art-num") as HTMLSpanElement | null
    npArt = document.getElementById("np-art") as HTMLDivElement | null
    progressFill = document.getElementById("progress-fill") as HTMLDivElement | null
    progressBorder = document.getElementById("progress-border") as HTMLDivElement | null
    npEl = document.getElementById("np") as HTMLDivElement | null
    // Explicit "open player" affordances for desktop -- a real button
    // wrapping the title (keyboard accessible), and a separate visible
    // expand control.
    npOpenBtn = document.getElementById("np-open") as HTMLButtonElement | null
    expandBtn = document.getElementById("expand-btn") as HTMLButtonElement | null
    // Desktop-only volume controls.
    volBtn = document.getElementById("vol-btn") as HTMLButtonElement | null
    volIcon = document.getElementById("vol-icon") as unknown as SVGSVGElement | null
    volSlider = document.getElementById("vol-slider") as HTMLInputElement | null

    // Drawer elements are mobile-only UI; guard each use individually
    // rather than bailing out of the whole player if one is missing.
    drawer = document.getElementById("player-drawer") as HTMLDivElement | null
    drawerCloseBtn = document.getElementById("drawer-close-btn") as HTMLButtonElement | null
    drawerTitle = document.getElementById("drawer-title") as HTMLDivElement | null
    drawerTitleText = document.getElementById("drawer-title-text") as HTMLSpanElement | null
    drawerSub = document.getElementById("drawer-sub") as HTMLParagraphElement | null
    drawerBarcode = document.getElementById("drawer-barcode") as HTMLSpanElement | null
    drawerCode = document.getElementById("drawer-code") as HTMLSpanElement | null
    drawerSeek = document.getElementById("drawer-seek") as HTMLInputElement | null
    drawerCurTime = document.getElementById("drawer-cur-time") as HTMLSpanElement | null
    drawerTotTime = document.getElementById("drawer-tot-time") as HTMLSpanElement | null
    drawerPrevBtn = document.getElementById("drawer-prev-btn") as HTMLButtonElement | null
    drawerNextBtn = document.getElementById("drawer-next-btn") as HTMLButtonElement | null
    drawerPlayBtn = document.getElementById("drawer-play-btn") as HTMLButtonElement | null
    drawerPlayIcon = document.getElementById("drawer-play-icon") as HTMLSpanElement | null
    // Optional "Signal" decal (bpm/key), shown only when a track
    // carries that data, and the stage's spectrum canvas.
    drawerDecal = document.getElementById("drawer-decal") as HTMLDivElement | null
    drawerDecalText = document.getElementById("drawer-decal-text") as HTMLSpanElement | null
    viz = document.getElementById("player-viz") as HTMLCanvasElement | null

    if (!audio || audioUnavailable) return

    if (
      !playBtn ||
      !playIcon ||
      !prevBtn ||
      !nextBtn ||
      !barSeek ||
      !curTimeEl ||
      !totTimeEl ||
      !npTitle ||
      !npAlbum ||
      !npEl ||
      !progressFill ||
      !progressBorder
    ) {
      return
    }

    // Re-apply (not resync -- that's the DOM half, done below grouped
    // with the rest of this block's resyncs) in case audio.volume was
    // somehow reset; narrower than applyVolumeUI() on purpose, since
    // volSlider/volBtn get their own full resync two lines down and
    // calling applyVolumeUI() twice here was redundant, dead work.
    if (audio) audio.volume = isMuted ? 0 : volumeLevel / 100

    // The audio object never stopped across this navigation -- it's
    // the same singleton it has always been. But the DOM it's
    // reflected into is brand new every swap, so resync every bit of
    // UI directly from its live state here rather than relying on
    // whatever events happen to have already fired by this point.
    syncProgress()
    updatePlayIcon()
    updateNav()
    if (index >= 0 && queue[index]) paintTrackUI(queue[index])
    setErrorUI(playbackError, "page-load resync")
    // Desktop only -- resync the volume slider/icon from
    // {volumeLevel, isMuted} on every page-load, same reasoning as the
    // rest of this resync block: the DOM is fresh each navigation even
    // though that state isn't.
    applyVolumeUI()

    if (bar.dataset.initialized === "true") return
    bar.dataset.initialized = "true"

    playBtn.addEventListener("click", togglePlayback)
    drawerPlayBtn?.addEventListener("click", togglePlayback)

    npOpenBtn?.addEventListener("click", () => {
      if (!audio?.src) return
      // Safari/WebKit doesn't focus a <button> on click the way other
      // browsers do -- openDrawer() below captures document.activeElement
      // as the "opener" to restore focus to on close, so without this
      // it would capture whatever had focus before the click instead.
      npOpenBtn?.focus()
      openDrawer()
    })
    expandBtn?.addEventListener("click", () => {
      if (!audio?.src) return
      expandBtn?.focus()
      openDrawer()
    })

    // Desktop only -- volume slider. "input" fires continuously while
    // dragging or on each arrow-key press: apply live (audio.volume,
    // icon state) but don't hit localStorage on every tick. "change"
    // fires once on release: persist then. Touching the slider at all
    // implies the user wants sound, so it un-mutes -- the same
    // behavior every mainstream player's volume slider has.
    volSlider?.addEventListener("input", () => {
      if (!volSlider) return
      volumeLevel = Number(volSlider.value)
      isMuted = false
      applyVolumeUI()
    })
    volSlider?.addEventListener("change", persistVolume)

    // Desktop only -- mute toggle. Remembers volumeLevel as-is (it's
    // never zeroed by muting, only audio.volume and the icon/slider
    // display reflect mute -- unmuting restores exactly where the
    // slider was).
    volBtn?.addEventListener("click", () => {
      isMuted = !isMuted
      applyVolumeUI()
      persistVolume()
    })

    drawerCloseBtn?.addEventListener("click", closeDrawer)

    // A click on the site nav (logo, Archives, About) leaves the stage:
    // close it first so its body scroll lock is undone before the
    // browser follows the link -- this also covers same-page links like
    // /#about, which never fire Astro's navigation events.
    document.addEventListener("click", (event) => {
      if (!drawer?.classList.contains("open")) return
      if ((event.target as HTMLElement).closest(".top a")) closeDrawer()
    })

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return
      if (!drawer?.classList.contains("open")) return
      closeDrawer()
    })

    document.addEventListener("keydown", (event) => {
      if (event.code !== "Space" && event.key !== " ") return
      if (!audio?.src) return

      const target = event.target as HTMLElement | null
      const tag = target?.tagName
      const isFormField =
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        tag === "BUTTON" ||
        target?.isContentEditable

      if (isFormField) return

      event.preventDefault()
      togglePlayback()
    })

    prevBtn.addEventListener("click", goToPrev)
    nextBtn.addEventListener("click", goToNext)
    drawerPrevBtn?.addEventListener("click", goToPrev)
    drawerNextBtn?.addEventListener("click", goToNext)

    // The stage's own seek bar. #bar-seek (desktop) has the same
    // input/change split just below this -- both set isSeeking so
    // syncProgress()'s timeupdate-driven writes don't fight a drag.
    drawerSeek?.addEventListener("input", () => {
      if (!drawerSeek) return
      isSeeking = true
      curTimeEl!.textContent = fmt(Number(drawerSeek.value) / 1000)
      if (drawerCurTime)
        drawerCurTime.textContent = fmt(Number(drawerSeek.value) / 1000)
      setRangeProgress(drawerSeek)
    })
    drawerSeek?.addEventListener("change", () => {
      if (!drawerSeek || !audio) return
      audio.currentTime = Number(drawerSeek.value) / 1000
      isSeeking = false
    })

    // Desktop only -- #bar-seek is now scrubbable too: click/drag
    // (native range-input pointer handling), and native browser
    // keyboard-arrow support, both free from using a real <input
    // type="range"> instead of a div. Same input/change split as
    // #drawer-seek above: "input" fires continuously while dragging
    // or on each arrow-key press (sets isSeeking so syncProgress's
    // timeupdate-driven writes don't fight the drag -- the guard was
    // already in place from the layout phase, this is what it was
    // for), "change" commits the actual seek once released.
    barSeek?.addEventListener("input", () => {
      if (!barSeek) return
      isSeeking = true
      const t = Number(barSeek.value) / 1000
      curTimeEl!.textContent = fmt(t)
      if (drawerCurTime) drawerCurTime.textContent = fmt(t)
      if (drawerSeek) drawerSeek.value = barSeek.value
      setRangeProgress(barSeek)
      barSeek.setAttribute("aria-valuetext", fmt(t))
    })
    barSeek?.addEventListener("change", () => {
      if (!barSeek || !audio) return
      audio.currentTime = Number(barSeek.value) / 1000
      isSeeking = false
    })

    // A track row click only plays -- it never opens the stage, on any
    // screen size. This is a deliberate POC deviation; see PROGRESS.md.
    document.addEventListener("player:play", ((event: CustomEvent) => {
      const detail = event.detail
      if (!detail || !Array.isArray(detail.queue)) return
      queue = detail.queue
      loadTrack(detail.index ?? 0, detail.autoplay ?? true)
    }) as EventListener)

    document.addEventListener("player:toggle", togglePlayback)

    // Opens the stage without touching playback -- used by the bar's
    // info area and expand button (desktop) and the mini bar (phones).
    document.addEventListener("player:open-stage", () => {
      if (!audio?.src) return
      openDrawer()
    })

    document.addEventListener("player:query", emitState)

    // ---------- --minih (mini bar height) for page bottom padding ----------
    function initMinih() {
      function set() {
        document.documentElement.style.setProperty(
          "--minih",
          bar!.offsetHeight + "px",
        )
      }
      new ResizeObserver(set).observe(bar!)
      set()
    }
    initMinih()

    // The title's room changes with the bar's width (rotation, desktop
    // resizes) and once the display font loads, so re-measure then.
    new ResizeObserver(() => fitTitleMarquee()).observe(bar!)
    if (drawerTitle) new ResizeObserver(() => fitStageTitleMarquee()).observe(drawerTitle)
    document.fonts?.ready.then(() => {
      fitTitleMarquee()
      fitStageTitleMarquee()
    })
    npTitle!.addEventListener("pointerenter", (e) => {
      if (e.pointerType !== "mouse") return
      titleHovered = true
      holdTitleMarquee()
    })
    npTitle!.addEventListener("pointerleave", (e) => {
      if (e.pointerType !== "mouse") return
      titleHovered = false
      releaseTitleMarquee()
    })

    // ---------- stage spectrum -- real analyser with a 118 BPM
    // simulated fallback, matching the home page's About spectrum pattern ----------
    if (viz) {
      const ctx = viz.getContext("2d")
      if (ctx) {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
        const SEG = 6,
          GAP = 3,
          BGAP = 4,
          HOLD_MS = 650,
          FALL = 2.4,
          SIM_BPM = 118
        let W = 0,
          H = 0,
          N = 0
        let lvl: number[] = [],
          peak: number[] = [],
          hold: number[] = [],
          vel: number[] = []
        const clamp = (v: number, a: number, b: number) =>
          Math.max(a, Math.min(b, v))

        new ResizeObserver(() => {
          const r = viz!.getBoundingClientRect()
          const dpr = Math.min(2, devicePixelRatio || 1)
          W = r.width
          H = r.height
          viz!.width = Math.round(W * dpr)
          viz!.height = Math.round(H * dpr)
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
          N = clamp(Math.floor((W + BGAP) / (12 + BGAP)), 14, 40)
          lvl = Array(N).fill(0)
          peak = Array(N).fill(0)
          hold = Array(N).fill(0)
          vel = Array(N).fill(0)
        }).observe(viz)

        function targets(ts: number) {
          const out = new Array(N).fill(0)
          if (!audio || !isActuallyPlaying) {
            if (!reduce)
              for (let i = 0; i < N; i++)
                out[i] = 0.05 + 0.05 * (0.5 + 0.5 * Math.sin(ts / 600 + i * 0.55))
            return out
          }
          if (analyser && freqData && !analyserFailed) {
            analyser.getByteFrequencyData(freqData)
            const nyq = (audioCtx?.sampleRate ?? 44100) / 2
            const bins = freqData.length
            // keep in sync with VIZ_F0/VIZ_F1 (the frequency axis ticks)
            const f0 = 45,
              f1 = 9000
            for (let i = 0; i < N; i++) {
              const a = f0 * Math.pow(f1 / f0, i / N)
              const b = f0 * Math.pow(f1 / f0, (i + 1) / N)
              const lo = Math.floor((a / nyq) * bins)
              const hi = Math.max(lo + 1, Math.ceil((b / nyq) * bins))
              let m = 0
              for (let k = lo; k < hi && k < bins; k++)
                if (freqData[k] > m) m = freqData[k]
              out[i] = clamp(Math.pow(m / 255, 1.7) * (1 + (i / N) * 0.35), 0, 1)
            }
            return out
          }
          // simulated fallback: fixed 118 BPM, phased off currentTime
          const ph = (audio.currentTime / (60 / SIM_BPM)) % 1
          for (let i = 0; i < N; i++) {
            const lowW = 1 - i / N
            out[i] = clamp(
              lowW * 0.95 * Math.exp(-ph * 4) +
                Math.random() * 0.25 * (0.4 + lowW * 0.6) +
                0.08,
              0,
              1,
            )
          }
          return out
        }

        let last = 0
        let vis = true
        let running = false

        function draw(ts: number) {
          const dt = Math.min(0.05, (ts - last) / 1000 || 0.016)
          last = ts
          setAnalyserStatusLine()
          if (W && N) {
            const tg = targets(ts)
            ctx.clearRect(0, 0, W, H)
            const bw = (W - (N - 1) * BGAP) / N
            const pitch = SEG + GAP
            const segs = Math.max(4, Math.floor((H + GAP) / pitch))
            const litColor = getComputedStyle(document.documentElement)
              .getPropertyValue("--stage-era")
              .trim() || "#C0392F"
            const hotColor = getComputedStyle(document.documentElement)
              .getPropertyValue("--pop")
              .trim() || "#E5472F"
            for (let i = 0; i < N; i++) {
              lvl[i] = Math.max(tg[i], lvl[i] - dt * 1.7)
              const L = lvl[i]
              if (L >= peak[i]) {
                peak[i] = L
                hold[i] = HOLD_MS
                vel[i] = 0
              } else if (hold[i] > 0) {
                hold[i] -= dt * 1000
              } else {
                vel[i] += FALL * dt
                peak[i] = Math.max(L, peak[i] - vel[i] * dt)
              }
              const x = i * (bw + BGAP)
              const lit = Math.round(L * segs)
              const cap = Math.min(segs - 1, Math.max(0, Math.round(peak[i] * segs) - 1))
              for (let s = 0; s < segs; s++) {
                const y = H - (s + 1) * pitch + GAP
                ctx.fillStyle =
                  s < lit
                    ? s / segs > 0.84
                      ? hotColor
                      : litColor
                    : "rgba(239,230,204,.07)"
                ctx.fillRect(x, y, bw, SEG)
              }
              if (peak[i] > 0.04) {
                ctx.fillStyle = "#EFE6CC"
                ctx.fillRect(x, H - (cap + 1) * pitch + GAP, bw, SEG)
              }
            }
          }
          if (!reduce && vis) requestAnimationFrame(draw)
          else running = false
        }
        function kick() {
          if (!running && !reduce) {
            running = true
            requestAnimationFrame(draw)
          }
        }
        new IntersectionObserver((entries) => {
          vis = entries[0].isIntersecting
          if (vis) kick()
        }).observe(drawer ?? viz)
        if (reduce) {
          for (let k = 0; k < 40; k++) draw(performance.now() + k * 40)
        }
      }
    }
  }

  document.addEventListener("astro:page-load", initPlayerBar)
</script>

<style>
  .player-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    height: 76px;
    background: var(--static);
    border-top: 1px solid var(--line);
    /* Hidden until a track is selected, on every screen size -- slide
       off-screen instead of display:none, since toggling display on a
       position:fixed element can leave Safari's fixed-position cache
       stale until a forced reflow (reads as the bar losing its bottom
       anchor and drifting with scroll). Staying in the fixed render
       tree the whole time avoids that. */
    transform: translateY(100%);
    transition: transform 0.2s ease;
    pointer-events: none;
  }
  .player-bar.has-track {
    transform: translateY(0);
    pointer-events: auto;
  }
  /* Hidden while the full-screen stage is open (it covers the bar
     anyway). Otherwise the bar, pinned to the very bottom, sits behind
     mobile Safari's floating toolbar and tints it the bar's lighter
     navy instead of the stage's near-black. */
  .player-bar.under-stage {
    visibility: hidden;
  }
  /* mobile-only stand-in for the draggable seek input -- a plain,
     non-interactive progress line pinned to the top edge of the bar */
  .progress-border {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--line);
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: var(--pop);
  }
  .player-inner {
    max-width: 1080px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .np {
    min-width: 0;
    flex: 1 1 160px;
    display: flex;
    align-items: center;
    gap: 0;
  }
  /* Desktop only -- no cover-art field exists anywhere in the content
     model (checked QueueTrack and every track/album JSON), so this
     always renders the placeholder: never invents art. Era color
     reuses --stage-era/-fg, the same custom properties the full-screen
     stage already reads, set once per track in paintTrackUI(). */
  .np-art {
    display: none;
    flex: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: var(--stage-era, var(--scarlet));
    color: var(--stage-era-fg, var(--bone));
    clip-path: polygon(8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%, 0 8px);
  }
  .np-art-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .np-sigil {
    width: 26px;
    height: 26px;
    fill: currentColor;
  }
  .np-sigil[hidden] {
    display: none;
  }
  .np-text {
    min-width: 0;
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
  }
  .np-open {
    display: block;
    width: 100%;
    min-width: 0;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .np-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.01em;
    font-size: 0.92rem;
    color: var(--bone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  /* long titles only -- fitTitleMarquee() adds .marquee and sets the
     overflow distance and cycle length. Holds 20% of the cycle at each
     end (plus a 1s head start) so it's readable before it moves. It
     slides the inner span with transform: animating text-indent on the
     title itself updated layout but never repainted inside this fixed,
     transformed bar, so the text looked frozen. */
  .np-title.marquee {
    text-overflow: clip;
  }
  .np-title.marquee .np-title-text {
    display: inline-block;
    animation: np-title-marquee var(--marquee-dur) ease-in-out 1s infinite
      alternate;
  }
  @keyframes np-title-marquee {
    0%,
    20% {
      transform: translateX(0);
    }
    80%,
    100% {
      transform: translateX(calc(-1 * var(--marquee-shift)));
    }
  }
  .np-album {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ash);
    text-decoration: none;
    margin-top: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s;
  }
  .np-album[href]:hover {
    color: var(--pop);
    text-decoration: underline;
  }
  /* display:contents is a no-op on mobile -- .np-album lays out
     exactly as if it were still a direct .np-text child (because, for
     layout purposes, it is). Only becomes a real flex row at desktop
     width, in the min-width: 980px block below. */
  .np-sub {
    display: contents;
  }
  /* Desktop only -- "· year" suffix, inline right after .np-album on
     the same line. A separate element so .np-album's own text and
     link (shared with mobile) never change. */
  .np-year {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--ash);
  }

  .controls {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tbtn {
    width: 34px;
    height: 34px;
    border-radius: 0;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ash);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s,
      transform 0.08s;
  }
  .tbtn:hover:not(:disabled) {
    color: var(--bone);
    border-color: var(--ash-dim);
  }
  .tbtn:active:not(:disabled) {
    transform: scale(0.92);
  }
  .tbtn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .tbtn.play {
    /* 44px is the desktop size -- mobile overrides to 48px in the
       max-width: 979px block further down, unchanged by this round. */
    width: 44px;
    height: 44px;
    background: var(--pop);
    border-color: transparent;
    color: var(--bone);
  }
  .tbtn.play:hover:not(:disabled) {
    background: var(--scarlet);
  }
  .tbtn.play:disabled {
    background: var(--ash-dim);
    border-color: var(--ash-dim);
    opacity: 1;
  }

  /* visible "open the stage" control -- desktop only; on phones the
     mini bar's whole track-info area already opens it */
  .expand-btn {
    display: none;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 0;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ash);
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .expand-btn:hover {
    color: var(--bone);
    border-color: var(--ash-dim);
  }
  .expand-btn svg {
    width: 16px;
    height: 16px;
  }
  .ic-play {
    width: 0;
    height: 0;
    margin-left: 2px;
    border-style: solid;
    border-width: 6px 0 6px 10px;
    border-color: transparent transparent transparent currentColor;
  }
  .ic-pause {
    width: 10px;
    height: 12px;
    background-image: linear-gradient(
      90deg,
      currentColor 0 30%,
      transparent 30% 70%,
      currentColor 70% 100%
    );
  }
  .ic-skip {
    width: 12px;
    height: 11px;
    position: relative;
    display: block;
  }
  .ic-skip::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 5.5px 0 5.5px 8px;
    border-color: transparent transparent transparent currentColor;
  }
  .ic-skip::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0;
    width: 2px;
    height: 11px;
    background: currentColor;
  }
  .ic-skip.prev {
    transform: scaleX(-1);
  }

  /* Desktop only. .controls (above) sits on top, this seek row below
     it, making the "one row of ~76px" bar a two-row center column at
     desktop width -- see the min-width: 980px block further down for
     exactly how tall that ends up and the rest of the grid. */
  .transport {
    flex: none;
    display: flex;
    align-items: center;
  }
  .bar-seek-row {
    display: none;
    align-items: center;
    gap: 9px;
    width: 100%;
  }
  .bar-seek-row .time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ash-dim);
    font-variant-numeric: tabular-nums;
    width: 2.6em;
    flex: none;
  }
  .bar-seek-row .time.now {
    text-align: right;
    color: var(--ash);
  }

  /* Desktop only -- volume. */
  .right-controls {
    flex: none;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .volume {
    display: none;
    align-items: center;
    gap: 8px;
  }
  .vol-btn {
    flex: none;
    width: 32px;
    height: 32px;
    border: none;
    background: transparent;
    color: var(--ash);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s;
  }
  .vol-btn:hover {
    color: var(--bone);
  }
  /* Speaker + sound-wave arcs, same stroke-based inline-SVG pattern as
     .expand-btn/.icon-btn's own icons elsewhere in this file. 20px,
     fixed -- same size at every width this button appears at (it only
     ever appears at desktop width, so there's no responsive variation
     to begin with). Three visual states toggled via data-level on the
     wrapping #vol-btn (see applyVolumeUI() in the script): "muted"
     shows only the speaker body (both arc paths hidden), "low" shows
     the inner arc only, "high" (default) shows both. */
  #vol-icon {
    width: 20px;
    height: 20px;
  }
  .vol-btn[data-level="muted"] .vol-arc {
    display: none;
  }
  .vol-btn[data-level="low"] .vol-arc-outer {
    display: none;
  }

  /* ---- desktop bar (>=980px): Spotify-style three-column layout,
     this label sheet's own tokens/fonts/square corners. The mobile
     mini bar below 980px is entirely untouched by this block -- every
     rule here only ever ADDS display:flex to something that defaults
     to display:none on narrower screens, or resizes something that's
     already desktop-only (.expand-btn). Placed here, after every base
     rule it overrides, deliberately -- same specificity as those base
     rules, so source order decides the tie; a draft that put this
     block earlier in the file had the base display:none rules win
     regardless of viewport width, hiding the seek row and volume
     controls outright (caught by a Playwright computed-style check
     reading "display: none" at 1280px). ---- */
  @media (min-width: 980px) {
    .expand-btn {
      display: flex;
    }
    .player-inner {
      /* height:100% + border-box means this inset is real, not just
         requested -- .transport was touching the bar's top border
         with zero vertical padding; this gives equal ~12px breathing
         room top and bottom. */
      padding: 12px 24px;
      gap: 24px;
    }
    .np {
      flex: 1 1 30%;
      max-width: 360px;
      gap: 12px;
    }
    .np-art {
      display: flex;
    }
    /* .np-sub becomes a real flex row here, so .np-album and .np-year
       flow onto one "Album · Year" line -- .np-album's own text/link
       is untouched, this only changes how it's laid out next to the
       new .np-year sibling. */
    .np-sub {
      display: flex;
      align-items: baseline;
      gap: 4px;
      min-width: 0;
    }
    .np-album {
      min-width: 0;
      flex: 0 1 auto;
    }
    .np-year {
      display: inline;
      flex: none;
    }
    .transport {
      flex: 1 1 40%;
      max-width: 480px;
      flex-direction: column;
      gap: 6px;
    }
    .controls {
      align-self: center;
    }
    .bar-seek-row {
      display: flex;
    }
    .right-controls {
      flex: 1 1 30%;
      max-width: 360px;
      justify-content: flex-end;
    }
    .volume {
      display: flex;
    }
    /* Two stacked rows need more than 76px -- the mobile bar keeps its
       own 68px (set in the max-width: 979px block further down).
       --minih (page bottom padding) and the stage's own offsets are
       already driven live off #player-bar's real offsetHeight (see
       initMinih() in the script), so this one height change is all
       that's needed for the rest of the page to adapt. */
    .player-bar {
      height: 88px;
    }
  }

  .range {
    -webkit-appearance: none;
    appearance: none;
    flex: 1;
    height: 44px;
    background: transparent;
    margin: 0;
    cursor: pointer;
  }
  .range:disabled {
    cursor: default;
    opacity: 0.6;
  }
  .range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 0;
    background: linear-gradient(
      to right,
      var(--pop) 0%,
      var(--pop) var(--progress, 0%),
      rgba(239, 230, 204, 0.2) var(--progress, 0%),
      rgba(239, 230, 204, 0.2) 100%
    );
  }
  .range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 10px;
    height: 18px;
    border-radius: 0;
    background: var(--bone);
    border: none;
    box-shadow: 0 0 0 2px var(--void);
    margin-top: -6px;
  }
  .range::-moz-range-thumb {
    width: 10px;
    height: 18px;
    border-radius: 0;
    background: var(--bone);
    border: none;
    box-shadow: 0 0 0 2px var(--void);
  }
  .range::-moz-range-progress {
    height: 6px;
    border-radius: 0;
    background: var(--pop);
  }
  .range::-moz-range-track {
    height: 6px;
    background: rgba(239, 230, 204, 0.2);
  }

  /* Desktop only -- the bar's own seek input and the volume slider.
     Placed here, after every .range rule above, deliberately: same
     specificity as .range's own pseudo-element rules, so source order
     decides the tie, the same reasoning the display:none/flex fix
     needed earlier in this file. A draft that left these BEFORE
     .range had .range's own height:44px/10x18px-thumb sizing silently
     win regardless of this block -- caught via a Playwright
     boundingBox read showing 44px instead of the intended ~14px. */
  .bar-seek,
  .vol-slider {
    height: 14px;
  }
  .bar-seek::-webkit-slider-runnable-track,
  .vol-slider::-webkit-slider-runnable-track {
    height: 4px;
  }
  .bar-seek::-moz-range-track,
  .vol-slider::-moz-range-track {
    height: 4px;
  }
  .bar-seek::-moz-range-progress,
  .vol-slider::-moz-range-progress {
    height: 4px;
  }
  /* Subtle at rest, fully visible on hover/focus/while dragging -- an
     opacity transition on the thumb only; the 4px track itself
     doesn't change. :active covers "currently being dragged" (held
     mouse-down), the same as it does natively for any other button. */
  .bar-seek::-webkit-slider-thumb,
  .vol-slider::-webkit-slider-thumb {
    width: 8px;
    height: 14px;
    margin-top: -5px;
    opacity: 0.45;
    transition: opacity 0.15s;
  }
  .bar-seek::-moz-range-thumb,
  .vol-slider::-moz-range-thumb {
    width: 8px;
    height: 14px;
    opacity: 0.45;
    transition: opacity 0.15s;
  }
  .bar-seek:hover::-webkit-slider-thumb,
  .bar-seek:focus-visible::-webkit-slider-thumb,
  .bar-seek:active::-webkit-slider-thumb,
  .vol-slider:hover::-webkit-slider-thumb,
  .vol-slider:focus-visible::-webkit-slider-thumb,
  .vol-slider:active::-webkit-slider-thumb {
    opacity: 1;
  }
  .bar-seek:hover::-moz-range-thumb,
  .bar-seek:focus-visible::-moz-range-thumb,
  .bar-seek:active::-moz-range-thumb,
  .vol-slider:hover::-moz-range-thumb,
  .vol-slider:focus-visible::-moz-range-thumb,
  .vol-slider:active::-moz-range-thumb {
    opacity: 1;
  }

  @media (max-width: 979px) {
    #prev-btn,
    #next-btn {
      display: none;
    }
    .progress-border {
      display: block;
    }
    /* the play button runs the bar's full height, flush to the right
       edge, so it reads as part of the bar; the track info centers on
       that same full height so it lines up with the button */
    .player-bar {
      height: 68px;
    }
    .player-inner {
      padding: 0 0 0 16px;
      align-items: stretch;
    }
    /* volume and expand are hidden here, so this would be an empty
       slot still taking a gap */
    .right-controls {
      display: none;
    }
    .transport,
    .controls {
      align-items: stretch;
    }
    .tbtn.play {
      width: 68px;
      height: auto;
    }
    .tbtn.play:active:not(:disabled) {
      transform: none;
    }
    /* icons scaled up to suit the bigger button; play and pause stay
       the same 14x16 box so toggling doesn't shift anything */
    .tbtn.play .ic-play {
      border-width: 8px 0 8px 14px;
    }
    .tbtn.play .ic-pause {
      width: 14px;
      height: 16px;
    }
    /* the whole track-info area opens the stage, not just the 21px
       title line: the title button's ::after stretches over .np */
    .np {
      position: relative;
      gap: 12px;
    }
    /* the album-sigil tile, a little smaller than desktop's 44px */
    .np-art {
      display: flex;
      width: 40px;
      height: 40px;
      clip-path: polygon(7px 0, 100% 0, 100% calc(100% - 7px), calc(100% - 7px) 100%, 0 100%, 0 7px);
    }
    .np-sigil {
      width: 24px;
      height: 24px;
    }
    .np-open::after {
      content: "";
      position: absolute;
      inset: 0;
    }
    /* the album link stays as wide as its text, not the whole column,
       and sits above that overlay; the padding (cancelled by the
       negative margins) grows its tap area to 31px tall without
       moving the text */
    .np-album {
      position: relative;
      z-index: 1;
      align-self: flex-start;
      max-width: 100%;
      padding-block: 8px;
      margin: -5px 0 -8px;
    }
  }

  /* ---- full-screen "now playing" stage -- opens from the mini bar on
     any screen size; on desktop a track row also opens it directly on
     play (see player:play's openStage handling). Sits below the sticky
     nav (top: var(--navh)) so the nav stays visible, matching the POC. ---- */
  .player-drawer {
    position: fixed;
    left: 0;
    right: 0;
    top: var(--navh);
    height: calc(100dvh - var(--navh));
    z-index: 70;
    display: none;
    flex-direction: column;
    background: var(--void);
    padding: calc(12px + env(safe-area-inset-top, 0px)) 16px
      calc(16px + env(safe-area-inset-bottom, 0px));
    overflow-y: auto;
    overflow-x: hidden;
    isolation: isolate;
  }
  .player-drawer.open {
    display: flex;
  }
  .stage-in {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
  }
  .stage-top {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 0;
    border: 1px solid var(--line);
    background: none;
    cursor: pointer;
  }
  .icon-btn svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  .collapse {
    flex: none;
    width: 56px;
    height: 56px;
    background: #c0392f;
    color: var(--bone);
    border: 0;
    transition: background 0.2s;
  }
  .collapse:hover {
    background: var(--pop);
  }
  .collapse svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
  }
  /* barcode + glitched catalog code, pushed to the right of the back
     button; the combining marks spill above and below the line, so it
     gets room and never clips */
  .code {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-right: 4px;
    font: 500 13px/1 var(--font-mono);
    letter-spacing: 0.08em;
    color: var(--ash);
    white-space: nowrap;
  }
  .title {
    margin: 10px 0 0;
    font: 700 clamp(36px, 10.5vw, 84px) / 0.98 var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.005em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .sub {
    margin: 10px 0 0;
    color: var(--ash);
    font-size: 16px;
  }
  .viz-wrap {
    position: relative;
    flex: 1;
    min-height: 200px;
  }
  #player-viz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .decal {
    position: absolute;
    right: -4px;
    top: -6px;
    transform: rotate(-3deg);
    width: 150px;
    padding: 8px 12px 12px;
    background: var(--hazard);
    color: var(--void);
    clip-path: polygon(
      0 0,
      calc(100% - 14px) 0,
      100% 14px,
      100% 100%,
      14px 100%,
      0 calc(100% - 14px)
    );
    pointer-events: none;
  }
  .decal[hidden] {
    display: none;
  }
  .decal b {
    display: block;
    font: 700 18px/1 var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .decal span {
    display: block;
    margin-top: 4px;
    font: 500 12px/1.2 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .decal i {
    display: block;
    margin-top: 6px;
    height: 6px;
    background: repeating-linear-gradient(
      -45deg,
      var(--void) 0 5px,
      transparent 5px 10px
    );
  }
  /* a thin strip under the spectrum: hairline on top, a short tick under
     each frequency, nothing drawn up through the bars. Always shown --
     over the simulated fallback the labels are decorative. */
  .freq-axis {
    position: relative;
    height: 24px;
    margin-top: -12px;
    border-top: 1px solid var(--line);
    font: 400 11px/1 var(--font-mono);
    color: var(--ash-dim);
  }
  /* marks sit at their true spots; labels center under them, except the
     first, which starts flush with the spectrum's left edge, and the
     last, which ends flush with its right edge */
  .freq-axis .mark {
    position: absolute;
    top: 0;
    width: 1px;
    height: 5px;
    background: var(--ash-dim);
  }
  .freq-axis .tick {
    position: absolute;
    top: 9px;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .freq-axis .tick[data-edge="start"] {
    left: 0;
    transform: none;
  }
  .freq-axis .tick[data-edge="end"] {
    left: auto;
    right: 0;
    transform: none;
  }
  .seek-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12px;
    font: 400 13px var(--font-mono);
    color: var(--ash);
    font-variant-numeric: tabular-nums;
  }
  .seek-row .range {
    width: 100%;
  }
  .stage-transport {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1fr;
    gap: 2px;
  }
  .stage-transport .tb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: auto;
    height: 64px;
    border: 0;
    background: var(--static-2);
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--bone);
    font: 600 13px var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s;
  }
  .stage-transport .tb:hover:not(:disabled) {
    background: #243049;
  }
  .stage-transport .tb:disabled {
    cursor: default;
    opacity: 0.5;
  }
  .stage-transport .tb svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .stage-transport .tb.play {
    background: var(--pop);
    box-shadow: none;
  }
  .stage-transport .tb.play:hover:not(:disabled) {
    background: #f0583f;
  }
  .stage-transport .tb.play .ic-play {
    border-width: 8px 0 8px 13px;
  }
  .stage-transport .tb.play .ic-pause {
    width: 13px;
    height: 16px;
  }
  @media (max-width: 379px) {
    .stage-transport .tb .tl {
      display: none;
    }
  }
  /* phones: Spotify-sized controls. A bare back chevron, plain skip
     icons and one solid 44px play square in a centered row (every tap
     area stays 44px), and the seek times move under the bar. Desktop
     keeps the boxed, labelled controls above. */
  @media (max-width: 979px) {
    .collapse {
      width: 44px;
      height: 44px;
      margin-left: -10px;
      background: none;
    }
    .collapse:hover {
      background: none;
      color: var(--pop);
    }
    .seek-row {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "bar bar"
        "cur tot";
      row-gap: 0;
      font-size: 11px;
    }
    /* the range keeps its tall touch area with the line centered in it,
       so pull the times up to sit just under the line */
    #drawer-cur-time,
    #drawer-tot-time {
      margin-top: -10px;
    }
    .seek-row .range {
      grid-area: bar;
    }
    #drawer-cur-time {
      grid-area: cur;
    }
    #drawer-tot-time {
      grid-area: tot;
      justify-self: end;
    }
    .stage-transport {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 40px;
    }
    .stage-transport .tb {
      width: 44px;
      height: 44px;
