---
---

<div
  class="player-bar"
  id="player-bar"
  transition:persist
  transition:name="player-bar"
>
  <!-- No <audio> element here -- the audio object is a detached
       singleton created once in the client script below (`new
       Audio()`, module scope), not a DOM node at all. #player-bar
       still keeps its own transition:persist for the UI chrome below
       (title, buttons, progress display), but the audio itself is
       never part of the document, so no Astro swap can ever find,
       move, or drop it. See the module-scope comment in the script
       for the WebKit/Chrome persistence issues this replaces. -->

  <div
    class="progress-border"
    id="progress-border"
    role="progressbar"
    aria-label="Playback progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <div class="progress-fill" id="progress-fill"></div>
  </div>

  <div class="player-inner">
    <div class="np" id="np">
      <button class="np-open" id="np-open" type="button" aria-label="Open player">
        <span class="np-title" id="np-title"></span>
      </button>
      <a class="np-album" id="np-album"></a>
      <span class="np-error" id="np-error" role="status" hidden>Playback error — try another track</span>
    </div>

    <div class="controls">
      <button
        class="tbtn"
        id="prev-btn"
        type="button"
        aria-label="Previous track"
        disabled
      >
        <span class="ic-skip prev"></span>
      </button>
      <button
        class="tbtn play"
        id="play-btn"
        type="button"
        aria-label="Play"
        disabled
      >
        <span class="ic-play" id="play-icon"></span>
      </button>
      <button
        class="tbtn"
        id="next-btn"
        type="button"
        aria-label="Next track"
        disabled
      >
        <span class="ic-skip"></span>
      </button>
    </div>

    <!-- Display only -- the bar shows playback position, it doesn't
         scrub it. Dragging/seeking lives only in the full-screen stage
         (#drawer-seek, a real range input with a 44px hit area). -->
    <div class="progress-row">
      <span class="time" id="cur-time">0:00</span>
      <div
        class="bar-progress"
        id="bar-progress"
        role="progressbar"
        aria-label="Playback progress"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="bar-progress-fill" id="bar-progress-fill"></div>
      </div>
      <span class="time now" id="tot-time">0:00</span>
    </div>

    <button class="expand-btn" id="expand-btn" type="button" aria-label="Open player">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="square"
        aria-hidden="true"
      >
        <path d="M6 15l6-6 6 6" />
      </svg>
    </button>
  </div>
</div>

<section
  class="player-drawer"
  id="player-drawer"
  aria-label="Now playing"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  transition:persist
  transition:name="player-drawer"
>
  <div class="stage-in">
    <div class="stage-top">
      <button
        class="icon-btn collapse"
        id="drawer-close-btn"
        type="button"
        aria-label="Back to archives"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="square"
          stroke-linejoin="miter"
          aria-hidden="true"
        >
          <path d="M15 5l-7 7 7 7" />
        </svg>
      </button>
      <div class="eyebrow-row">
        <span class="chip">Now playing</span>
        <span class="code" aria-hidden="true">
          <span id="drawer-barcode" data-barcode="stage"></span>
          <span id="drawer-code"></span>
        </span>
      </div>
    </div>

    <div>
      <h2 class="title" id="drawer-title">Pick a track</h2>
      <p class="sub" id="drawer-sub"></p>
    </div>

    <div class="viz-wrap">
      <canvas
        id="player-viz"
        role="img"
        aria-label="Live frequency bars. A cream cap holds at each peak, then falls."
      ></canvas>
      <div class="decal" id="drawer-decal" hidden aria-hidden="true">
        <b>Signal</b>
        <span id="drawer-decal-text"></span>
        <i></i>
      </div>
    </div>
    <div class="hazard" aria-hidden="true"></div>

    <div class="seek-row">
      <span id="drawer-cur-time">0:00</span>
      <input
        class="range"
        id="drawer-seek"
        type="range"
        min="0"
        max="1000"
        value="0"
        step="1"
        aria-label="Seek"
        disabled
      />
      <span id="drawer-tot-time">0:00</span>
    </div>

    <div class="stage-transport">
      <button
        class="icon-btn tb"
        id="drawer-prev-btn"
        type="button"
        aria-label="Previous track"
        disabled
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 5h2.5v14H6zM20 5v14L9.5 12z" />
        </svg>
        <span class="tl">Prev</span>
      </button>
      <button
        class="icon-btn tb play"
        id="drawer-play-btn"
        type="button"
        aria-label="Play"
        disabled
      >
        <span class="ic-play" id="drawer-play-icon"></span>
      </button>
      <button
        class="icon-btn tb"
        id="drawer-next-btn"
        type="button"
        aria-label="Next track"
        disabled
      >
        <span class="tl">Next</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15.5 5H18v14h-2.5zM4 5l10.5 7L4 19z" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  // body isn't a transition:persist element -- Astro replaces it with a
  // fresh node (no classes) on every navigation, unlike #player-bar
  // itself, which really does survive. Re-sync body's padding to the
  // bar's actual (persisted) state on every page load so a track
  // loaded on an earlier page doesn't leave a stale gap.
  function syncBodyPadding(bar: HTMLElement) {
    document.body.classList.toggle(
      "player-active",
      bar.classList.contains("has-track"),
    )
  }

  // Same seeded-barcode generator as Nav.astro, duplicated rather than
  // shared across a component boundary for a ~10-line utility -- the
  // stage's barcode reseeds per track (Nav's own copy only reseeds
  // per navigation), so this needs to be called directly from
  // loadTrack() below.
  function seededBarcode(seed: string, len: number, height: number) {
    let h = 2166136261
    for (let i = 0; i < seed.length; i++) {
      h ^= seed.charCodeAt(i)
      h = Math.imul(h, 16777619)
    }
    const rng = () => {
      h |= 0
      h = (h + 0x6d2b79f5) | 0
      let t = Math.imul(h ^ (h >>> 15), 1 | h)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }
    let x = 0
    let out = ""
    while (x < len) {
      const w = 1 + Math.floor(rng() * 3)
      const gap = 1 + Math.floor(rng() * 2)
      if (x + w > len) break
      out += `<rect x="${x}" y="0" width="${w}" height="${height}"/>`
      x += w + gap
    }
    return `<svg class="bars" viewBox="0 0 ${len} ${height}" width="${len}" height="${height}" aria-hidden="true" fill="currentColor">${out}</svg>`
  }

  type QueueTrack = {
    title: string
    album?: string
    albumId?: string
    audioUrl: string
    // optional: not sent by any dispatcher yet (no track in the
    // content collection has bpm/key set), but the stage's decal
    // reads them if present -- never invented when absent.
    bpm?: number
    key?: string
    // optional stage furniture, all precomputed by the dispatcher
    // (it has the album/track index and era data already, at build
    // time) rather than looked up here -- absent fields just leave
    // that piece of the subline/code off instead of inventing it.
    code?: string // "A06-T02" style
    year?: number
    trackNum?: number
    trackTotal?: number
    eraBg?: string // e.g. "var(--era-2012)"
    eraFg?: string
  }

  // ---------- the audio element: a detached singleton, not a DOM node ----------
  // Created exactly once, right here, when this script module first
  // evaluates. Astro's ClientRouter swaps the DOM on navigation but
  // never re-runs an already-loaded page module, so this one object
  // outlives every navigation for the whole tab's session -- nothing
  // in the document for Astro's swap to find, move, or drop. This
  // replaces an earlier design where <audio> lived in the DOM behind
  // #player-bar's transition:persist: that worked in Chrome but
  // WebKit doesn't implement Element.moveBefore(), so its fallback
  // swap could drop a persisted child even though the parent survived
  // -- recoverable (a later round made the recovery reliable), but a
  // replacement element has no buffered network data, so resuming it
  // always cost a brief, audible re-fetch. A singleton that's never
  // part of the document removes the failure mode entirely rather
  // than recovering from it.
  let audio: HTMLAudioElement | null = null
  let audioUnavailable = false
  try {
    audio = new Audio()
    audio.preload = "none"
    // Test-only hook: the singleton has no DOM presence anymore for
    // Playwright (or anything else) to find via getElementById, so
    // expose a reference for inspection. Read-only in spirit -- no
    // production code reads this back.
    ;(window as any).__playerAudio = audio
  } catch {
    audio = null
    audioUnavailable = true
  }

  // ---------- debug mode (?debug=1, ?noanalyser=1) ----------
  // Both persisted via sessionStorage so they stay on across client-
  // side navigation -- the query param is only present on whichever
  // URL the tab first loaded with. This is diagnostic-only: neither
  // flag changes behavior for a normal visit, and noanalyser is only
  // meant for isolating whether the Web Audio graph is implicated in
  // FAIL A (lock-screen skip/auto-advance going silent after the
  // first track) -- it is NOT a fix, just a way to test with that
  // whole code path removed from the picture.
  let debugMode = false
  let noAnalyser = false
  try {
    if (new URLSearchParams(location.search).get("debug") === "1") {
      sessionStorage.setItem("sb_debug", "1")
    }
    if (new URLSearchParams(location.search).get("noanalyser") === "1") {
      sessionStorage.setItem("sb_noanalyser", "1")
    }
    debugMode = sessionStorage.getItem("sb_debug") === "1"
    noAnalyser = sessionStorage.getItem("sb_noanalyser") === "1"
  } catch {}

  // Full diagnostic log for FAIL A. Kept at module scope (survives
  // navigation) and rendered into a panel that's recreated each
  // astro:page-load (the DOM gets swapped; the log data doesn't).
  // This is meant to be read directly on the phone after unlocking it,
  // not pulled from a devtools console the user can't easily attach
  // while testing lock-screen behavior -- see PROGRESS.md for the full
  // legend of what each line prefix means.
  const debugLogLines: string[] = []
  function debugLog(line: string) {
    if (!debugMode) return
    const t = (performance.now() / 1000).toFixed(2)
    debugLogLines.push(`[${t}s] ${line}`)
    renderDebugLog()
  }
  function renderDebugLog() {
    if (!debugPanel) return
    const body = debugPanel.querySelector("#sb-debug-log") as HTMLDivElement | null
    if (!body) return
    body.textContent = debugLogLines.join("\n")
    body.scrollTop = body.scrollHeight
  }

  let debugPanel: HTMLDivElement | null = null
  let debugStatusLine: HTMLDivElement | null = null
  function ensureDebugPanel() {
    if (!debugMode) return
    if (debugPanel && document.body.contains(debugPanel)) return
    debugPanel = document.createElement("div")
    debugPanel.id = "sb-debug-panel"
    // Anchored to the TOP, not the bottom -- the player bar and its
    // own tap targets (play/prev/next, the mini bar on mobile) live at
    // the bottom of the viewport, and a bottom-fixed panel tall enough
    // to show a useful amount of log would sit on top of them and
    // block every real control the person is trying to test. Found by
    // a Playwright click failing with "subtree intercepts pointer
    // events" on #next-btn with the panel open -- the same would block
    // a real tap on a phone.
    debugPanel.style.cssText =
      "position:fixed;top:0;left:0;right:0;max-height:32vh;overflow:hidden;" +
      "display:flex;flex-direction:column;" +
      "background:rgba(0,0,0,.88);color:#9f9;font:11px/1.4 monospace;" +
      "padding:6px 8px;z-index:999999;pointer-events:auto;"
    debugStatusLine = document.createElement("div")
    debugStatusLine.id = "sb-debug-status"
    debugStatusLine.style.cssText = "color:#ff9;font-weight:bold;margin-bottom:4px;flex:none;"
    debugStatusLine.textContent = noAnalyser ? "analyser: disabled (noanalyser=1)" : "analyser: --"
    const logBody = document.createElement("div")
    logBody.id = "sb-debug-log"
    logBody.style.cssText = "overflow:auto;white-space:pre-wrap;flex:1;"
    debugPanel.appendChild(debugStatusLine)
    debugPanel.appendChild(logBody)
    document.body.appendChild(debugPanel)
    renderDebugLog()
  }
  function setAnalyserStatusLine() {
    if (!debugMode || !debugStatusLine) return
    let mode: string = noAnalyser ? "disabled (noanalyser=1)" : "sim"
    if (!noAnalyser && analyser && !analyserFailed) {
      mode = audioCtx?.state === "suspended" ? "suspended" : "live"
    }
    debugStatusLine.textContent = `analyser: ${mode}`
  }

  // visibilitychange fires on lock/unlock and background/foreground --
  // registered once, here, since `document` itself is the same object
  // for the whole tab session regardless of client-side navigation.
  if (debugMode) {
    document.addEventListener("visibilitychange", () => {
      debugLog(`visibilitychange: ${document.visibilityState}`)
    })
  }

  let queue: QueueTrack[] = []
  let index = -1
  let isSeeking = false
  // Distinct from `!audio.paused`: .paused flips to false the instant
  // .play() is called, even while the element is still buffering and
  // producing no sound yet. The visualizer needs to know when playback
  // has actually, audibly started (the "playing" event) vs. merely
  // been requested, so a stall or a fresh track loading doesn't show
  // the energetic pattern while nothing is actually audible.
  let isActuallyPlaying = false
  let playbackError = false

  // UI element refs -- unlike `audio` above, these DO live in the
  // swapped DOM and are re-queried on every astro:page-load.
  let bar: HTMLElement | null = null
  let playBtn: HTMLButtonElement | null = null
  let playIcon: HTMLSpanElement | null = null
  let prevBtn: HTMLButtonElement | null = null
  let nextBtn: HTMLButtonElement | null = null
  let barProgress: HTMLDivElement | null = null
  let barProgressFill: HTMLDivElement | null = null
  let curTimeEl: HTMLSpanElement | null = null
  let totTimeEl: HTMLSpanElement | null = null
  let npTitle: HTMLDivElement | null = null
  let npAlbum: HTMLAnchorElement | null = null
  let npErrorEl: HTMLSpanElement | null = null
  let progressFill: HTMLDivElement | null = null
  let progressBorder: HTMLDivElement | null = null
  let npEl: HTMLDivElement | null = null
  let npOpenBtn: HTMLButtonElement | null = null
  let expandBtn: HTMLButtonElement | null = null
  let drawer: HTMLDivElement | null = null
  let drawerCloseBtn: HTMLButtonElement | null = null
  let drawerTitle: HTMLDivElement | null = null
  let drawerSub: HTMLParagraphElement | null = null
  let drawerBarcode: HTMLSpanElement | null = null
  let drawerCode: HTMLSpanElement | null = null
  let drawerSeek: HTMLInputElement | null = null
  let drawerCurTime: HTMLSpanElement | null = null
  let drawerTotTime: HTMLSpanElement | null = null
  let drawerPrevBtn: HTMLButtonElement | null = null
  let drawerNextBtn: HTMLButtonElement | null = null
  let drawerPlayBtn: HTMLButtonElement | null = null
  let drawerPlayIcon: HTMLSpanElement | null = null
  let drawerDecal: HTMLDivElement | null = null
  let drawerDecalText: HTMLSpanElement | null = null
  let viz: HTMLCanvasElement | null = null

  function fmt(seconds: number) {
    if (!Number.isFinite(seconds) || seconds < 0) return "0:00"
    const m = Math.floor(seconds / 60)
    const s = Math.floor(seconds % 60)
    return `${m}:${s < 10 ? "0" : ""}${s}`
  }

  // Still used by #drawer-seek -- the stage's own range input, the
  // only scrubbable one left.
  function setRangeProgress(input: HTMLInputElement) {
    const min = Number(input.min) || 0
    const max = Number(input.max) || 100
    const value = Number(input.value)
    const pct = max > min ? ((value - min) / (max - min)) * 100 : 0
    input.style.setProperty("--progress", `${pct}%`)
    return pct
  }

  // Drives both display-only progress indicators (the bar's own, and
  // the mobile mini bar's top-edge line) straight from audio state --
  // neither is backed by a range input anymore, so there's nothing to
  // read a .value from.
  function syncProgress() {
    if (!audio || !barProgress || !barProgressFill || !progressFill || !progressBorder) return
    const pct = audio.duration ? (audio.currentTime / audio.duration) * 100 : 0
    const rounded = String(Math.round(pct))
    barProgressFill.style.width = `${pct}%`
    barProgress.setAttribute("aria-valuenow", rounded)
    progressFill.style.width = `${pct}%`
    progressBorder.setAttribute("aria-valuenow", rounded)
  }

  function updatePlayIcon() {
    if (!audio || !playIcon || !playBtn) return
    playIcon.className = audio.paused ? "ic-play" : "ic-pause"
    playBtn.setAttribute("aria-label", audio.paused ? "Play" : "Pause")
    if (drawerPlayIcon && drawerPlayBtn) {
      drawerPlayIcon.className = audio.paused ? "ic-play" : "ic-pause"
      drawerPlayBtn.setAttribute("aria-label", audio.paused ? "Play" : "Pause")
    }
    if ("mediaSession" in navigator) {
      navigator.mediaSession.playbackState = audio.paused ? "paused" : "playing"
    }
    emitState()
  }

  // Lets any page's tracklist know which track (by audioUrl) is
  // currently loaded and whether it's playing, so it can highlight
  // the matching row -- broadcast on every load/play/pause, and also
  // on request (a freshly-loaded page asks via "player:query" since
  // it can't see this module's state directly).
  function emitState() {
    if (!audio) return
    const current = index >= 0 ? queue[index] : null
    document.dispatchEvent(
      new CustomEvent("player:state", {
        detail: {
          audioUrl: current?.audioUrl ?? null,
          playing: !audio.paused,
        },
      }),
    )
  }

  function updateNav() {
    if (!prevBtn || !nextBtn) return
    prevBtn.disabled = queue.length === 0
    nextBtn.disabled = queue.length === 0
    if (drawerPrevBtn) drawerPrevBtn.disabled = queue.length === 0
    if (drawerNextBtn) drawerNextBtn.disabled = queue.length === 0
  }

  function setErrorUI(hasError: boolean) {
    playbackError = hasError
    if (npErrorEl) npErrorEl.hidden = !hasError
    bar?.classList.toggle("has-error", hasError)
  }

  // ---------- CORS capability check + real analyser ----------
  // Per-origin cache so a HEAD request isn't repeated for every track.
  const corsResolved = new Map<string, boolean>()
  const corsChecking = new Set<string>()
  function originOf(url: string): string | null {
    try {
      return new URL(url, location.href).origin
    } catch {
      return null
    }
  }
  function checkCorsAsync(origin: string, sampleUrl: string) {
    if (corsChecking.has(origin)) return
    corsChecking.add(origin)
    // A `mode:"cors"` fetch's promise only resolves at all once the
    // browser has already verified the response's Access-Control-*
    // headers permit this origin -- a disallowed origin makes the
    // fetch reject (caught below), it never resolves with a non-ok
    // response for that reason. Checking for the ACAO header's
    // presence on top of that is unnecessary and was always false in
    // practice (browsers don't expose it to JS unless the server adds
    // it to Access-Control-Expose-Headers, which it has no reason to).
    fetch(sampleUrl, { method: "HEAD", mode: "cors", cache: "no-store" })
      .then((res) => {
        corsResolved.set(origin, res.ok)
      })
      .catch(() => {
        corsResolved.set(origin, false)
      })
  }

  // A fixed, always-present object on the shared audio origin, probed
  // once here at module init/idle -- *not* at the first tap. Before
  // this, the probe only ever started from inside prepareAnalyser(),
  // which only runs at tap time, so a fresh session's first track
  // could never win that race: the HEAD request hadn't even been
  // issued yet at the exact moment prepareAnalyser made its one-shot,
  // never-rechecked decision for that track. Confirmed empirically --
  // 12/12 fresh-session runs hit this before the fix, 0/12 after.
  // Starting the same probe here instead means it's almost always
  // already resolved by the time the user taps play on anything.
  const CORS_WARMUP_URL = "https://audio.sushibot.cloud/web/2012/buzz-symphony.mp3"
  ;(() => {
    const origin = originOf(CORS_WARMUP_URL)
    if (!origin) return
    const kick = () => checkCorsAsync(origin, CORS_WARMUP_URL)
    if ("requestIdleCallback" in window) (window as any).requestIdleCallback(kick)
    else kick()
  })()

  let audioCtx: AudioContext | null = null
  let analyser: AnalyserNode | null = null
  let freqData: Uint8Array | null = null
  let sourceNode: MediaElementAudioSourceNode | null = null
  let analyserFailed = false

  // Wires the graph exactly once for the whole session --
  // createMediaElementSource throws on a second call for the same
  // element, and since `audio` is now a singleton that's no longer a
  // "per element" constraint to work around, it's just "once, ever."
  function ensureAudioGraph() {
    if (!audio || sourceNode || analyserFailed || noAnalyser) return
    try {
      const AC = window.AudioContext || (window as any).webkitAudioContext
      if (!AC) {
        analyserFailed = true
        return
      }
      audioCtx = audioCtx || new AC()
      if (debugMode) {
        audioCtx.addEventListener("statechange", () => {
          debugLog(`audioCtx statechange: ${audioCtx!.state}`)
        })
      }
      sourceNode = audioCtx.createMediaElementSource(audio)
      analyser = audioCtx.createAnalyser()
      analyser.fftSize = 1024
      analyser.smoothingTimeConstant = 0.55
      freqData = new Uint8Array(analyser.frequencyBinCount)
      sourceNode.connect(analyser)
      analyser.connect(audioCtx.destination)
    } catch {
      analyserFailed = true
      sourceNode = null
      analyser = null
      freqData = null
    }
    setAnalyserStatusLine()
  }

  // crossOrigin is decided exactly once per track, here, strictly
  // before .src is assigned for it in loadTrack() below -- and never
  // touched again for that same load. The CORS_WARMUP_URL probe above
  // means `corsResolved` has almost always already settled by the time
  // any track is tapped. If it somehow hasn't (e.g. the probe is still
  // in flight on a very slow connection), crossOrigin is simply left
  // unset for THIS track -- the real analyser won't activate until a
  // later track, once the probe has had time to resolve. We never
  // retroactively flip crossOrigin on a load that's already in flight:
  // changing it after the fact can force the browser to redo the
  // fetch, which is exactly the kind of mid-playback disruption the
  // singleton rework exists to avoid in the first place.
  function prepareAnalyser(url: string) {
    if (!audio) return
    if (noAnalyser) {
      setAnalyserStatusLine()
      return
    }
    try {
      const origin = originOf(url)
      if (!origin) return
      checkCorsAsync(origin, url)
      if (corsResolved.get(origin) === true && audio.crossOrigin !== "anonymous") {
        audio.crossOrigin = "anonymous"
        ensureAudioGraph()
      }
    } catch {
      analyserFailed = true
    }
    setAnalyserStatusLine()
  }

  function resumeAudioContextIfNeeded() {
    try {
      if (audioCtx && audioCtx.state === "suspended") audioCtx.resume()
    } catch {}
  }

  function updateMediaSessionMetadata(track: QueueTrack) {
    if (!("mediaSession" in navigator) || typeof MediaMetadata === "undefined") return
    try {
      navigator.mediaSession.metadata = new MediaMetadata({
        title: track.title,
        artist: track.album ?? "SushiCloud",
        album: track.album ?? "",
        // No per-track artwork exists in the content model -- using
        // the site's own brand image for every track rather than
        // inventing per-track art that isn't there.
        artwork: [{ src: "/album-art/sushibot.jpg", sizes: "965x928", type: "image/jpeg" }],
      })
    } catch {}
  }

  function updatePositionState() {
    if (!("mediaSession" in navigator) || !audio) return
    if (!Number.isFinite(audio.duration) || audio.duration <= 0) return
    try {
      navigator.mediaSession.setPositionState({
        duration: audio.duration,
        playbackRate: audio.playbackRate || 1,
        position: Math.min(audio.currentTime, audio.duration),
      })
    } catch {}
  }

  function setupMediaSession() {
    if (!("mediaSession" in navigator)) return
    // debugLog() is synchronous (array push + a DOM textContent write)
    // -- it never introduces an await before the handler's own call,
    // which must stay direct and synchronous for iOS to accept it as
    // gesture-equivalent while the screen is locked.
    navigator.mediaSession.setActionHandler("play", () => {
      debugLog("mediaSession:play")
      togglePlayback()
    })
    navigator.mediaSession.setActionHandler("pause", () => {
      debugLog("mediaSession:pause")
      togglePlayback()
    })
    navigator.mediaSession.setActionHandler("previoustrack", () => {
      debugLog("mediaSession:previoustrack")
      goToPrev()
    })
    navigator.mediaSession.setActionHandler("nexttrack", () => {
      debugLog("mediaSession:nexttrack")
      goToNext()
    })
    navigator.mediaSession.setActionHandler("seekto", (details) => {
      debugLog(`mediaSession:seekto ${details.seekTime}`)
      if (!audio) return
      const t = details.seekTime ?? audio.currentTime
      if (details.fastSeek && "fastSeek" in audio) {
        ;(audio as any).fastSeek(t)
      } else {
        audio.currentTime = t
      }
    })
  }

  // Paints every piece of UI (bar + stage) for a given track. Called
  // both when a NEW track starts (from loadTrack()) and when resyncing
  // an already-playing track's info into a freshly-swapped page (see
  // initPlayerBar() below) -- the audio itself never stopped across a
  // navigation, but the DOM it's reflected into is brand new every
  // time and has to be told what's currently loaded.
  function paintTrackUI(track: QueueTrack) {
    if (!bar || !npTitle || !npAlbum) return
    bar.classList.add("has-track")
    syncBodyPadding(bar)
    npTitle.textContent = track.title
    npAlbum.textContent = track.album ?? ""
    if (track.albumId) {
      npAlbum.href = `/albums/${track.albumId}/`
    } else {
      npAlbum.removeAttribute("href")
    }
    if (drawerTitle) drawerTitle.textContent = track.title
    if (drawerSub) {
      const parts: string[] = []
      if (track.album) parts.push(track.album)
      if (track.year != null) parts.push(String(track.year))
      if (track.trackNum != null && track.trackTotal != null) {
        parts.push(`track ${track.trackNum} of ${track.trackTotal}`)
      }
      drawerSub.textContent = parts.join(" · ")
    }
    if (drawerCode) drawerCode.textContent = track.code ?? ""
    if (drawerBarcode) drawerBarcode.innerHTML = seededBarcode(track.audioUrl, 64, 14)
    document.documentElement.style.setProperty("--stage-era", track.eraBg ?? "var(--scarlet)")
    document.documentElement.style.setProperty("--stage-era-fg", track.eraFg ?? "var(--bone)")
    if (drawerDecal && drawerDecalText) {
      // Shown when bpm OR key is present, not just when both are --
      // the POC uses "//" as a separator between two possibly-partial
      // fields, not a requirement that both exist.
      if (track.bpm != null || track.key) {
        const bpmPart = track.bpm != null ? `${track.bpm} BPM` : ""
        const keyPart = track.key ?? ""
        drawerDecalText.textContent = [bpmPart, keyPart].filter(Boolean).join(" // ")
        drawerDecal.hidden = false
      } else {
        drawerDecal.hidden = true
      }
    }
    if (playBtn) playBtn.disabled = false
    if (drawerPlayBtn) drawerPlayBtn.disabled = false
    if (drawerSeek) drawerSeek.disabled = false
    updateNav()
    updateMediaSessionMetadata(track)
  }

  function loadTrack(newIndex: number, autoplay = true) {
    if (!audio || audioUnavailable) return
    const track = queue[newIndex]
    if (!track) return
    index = newIndex
    isActuallyPlaying = false
    setErrorUI(false)
    paintTrackUI(track)
    prepareAnalyser(track.audioUrl)
    debugLog(`src := ${track.audioUrl}`)
    audio.src = track.audioUrl
    if (autoplay) {
      resumeAudioContextIfNeeded()
      // .play() itself is still called synchronously, right here, in
      // direct response to a user gesture or the `ended` event's
      // auto-advance chain -- .then()/.catch() only observe what the
      // already-dispatched call resolves to, they don't delay it.
      audio.play().then(() => debugLog("play() resolved")).catch((err) => {
        debugLog(`play() rejected: ${err?.name ?? err}`)
      })
    }
    emitState()
  }

  function togglePlayback() {
    if (!audio || !audio.src) return
    if (audio.paused) {
      resumeAudioContextIfNeeded()
      audio.play().then(() => debugLog("play() resolved")).catch((err) => {
        debugLog(`play() rejected: ${err?.name ?? err}`)
      })
    } else {
      audio.pause()
    }
  }

  function goToPrev() {
    if (queue.length === 0) return
    loadTrack((index - 1 + queue.length) % queue.length)
  }

  function goToNext() {
    if (queue.length === 0) return
    loadTrack((index + 1) % queue.length)
  }

  let drawerScrollY = 0
  // Tracks whatever had focus when the stage opened (a row on an
  // album page, the mini bar's open button, etc.) so focus can return
  // to it on close, matching the POC's open/close focus contract.
  let openerEl: HTMLElement | null = null

  // While the stage is open, everything else on the page (nav, main
  // content, the mini bar itself) becomes inert -- #player-drawer is
  // always one of body's direct children (it's transition:persist),
  // so this only ever needs to look at body's immediate children.
  function setBehindStageInert(isOpen: boolean) {
    if (!drawer) return
    for (const el of Array.from(document.body.children)) {
      if (el === drawer) continue
      ;(el as HTMLElement).inert = isOpen
    }
  }

  // overflow:hidden on body doesn't reliably block touch-scrolling on
  // iOS Safari -- pin body in place at its current scroll offset and
  // restore the real scroll position on close instead.
  function openDrawer() {
    if (!drawer || drawer.classList.contains("open")) return
    openerEl = document.activeElement as HTMLElement | null
    drawerScrollY = window.scrollY
    document.body.style.position = "fixed"
    document.body.style.top = `-${drawerScrollY}px`
    document.body.style.left = "0"
    document.body.style.right = "0"
    drawer.classList.add("open")
    drawer.setAttribute("aria-hidden", "false")
    setBehindStageInert(true)
    drawerPlayBtn?.focus({ preventScroll: true })
  }

  function closeDrawer() {
    if (!drawer || !drawer.classList.contains("open")) return
    drawer.classList.remove("open")
    drawer.setAttribute("aria-hidden", "true")
    document.body.style.position = ""
    document.body.style.top = ""
    document.body.style.left = ""
    document.body.style.right = ""
    window.scrollTo(0, drawerScrollY)
    setBehindStageInert(false)
    ;(openerEl ?? npOpenBtn)?.focus({ preventScroll: true })
    openerEl = null
  }

  // Attaches every listener that lives directly on the audio object --
  // called exactly once, right after the singleton is constructed
  // above, not per astro:page-load (there's nothing to re-wire: it's
  // always the same object).
  function wireAudio() {
    if (!audio) return

    if (debugMode) {
      for (const ev of [
        "play", "pause", "playing", "waiting", "stalled", "ended",
        "error", "emptied", "abort", "seeking", "seeked",
        "loadstart", "canplay",
      ]) {
        audio.addEventListener(ev, () => {
          if (!audio) return
          debugLog(`audio:${ev} paused=${audio.paused} ct=${audio.currentTime.toFixed(2)} rs=${audio.readyState}`)
        })
      }
    }

    audio.addEventListener("play", updatePlayIcon)
    audio.addEventListener("pause", updatePlayIcon)
    audio.addEventListener("ended", () => {
      if (queue.length > 0) {
        debugLog("ended -> auto-advance")
        goToNext()
      }
    })

    // Drives the visualizer's idle/energetic switch -- see the
    // isActuallyPlaying declaration above for why this isn't just
    // !audio.paused.
    audio.addEventListener("playing", () => {
      isActuallyPlaying = true
      setErrorUI(false)
    })
    audio.addEventListener("pause", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("waiting", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("stalled", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("ended", () => {
      isActuallyPlaying = false
    })
    audio.addEventListener("error", () => {
      isActuallyPlaying = false
      setErrorUI(true)
    })
    audio.addEventListener("loadedmetadata", () => {
      if (!audio) return
      if (totTimeEl) totTimeEl.textContent = fmt(audio.duration)
      if (drawerTotTime) drawerTotTime.textContent = fmt(audio.duration)
      if (drawerSeek) drawerSeek.max = String(Math.floor(audio.duration * 1000))
      updatePositionState()
    })
    audio.addEventListener("timeupdate", () => {
      if (!audio) return
      if (isSeeking) return
      if (curTimeEl) curTimeEl.textContent = fmt(audio.currentTime)
      if (drawerCurTime) drawerCurTime.textContent = fmt(audio.currentTime)
      if (drawerSeek) {
        drawerSeek.value = String(Math.floor(audio.currentTime * 1000))
        setRangeProgress(drawerSeek)
      }
      syncProgress()
      updatePositionState()
    })

    setupMediaSession()
  }
  wireAudio()

  function initPlayerBar() {
    bar = document.getElementById("player-bar")
    if (!bar) return
    syncBodyPadding(bar)
    ensureDebugPanel()

    playBtn = document.getElementById("play-btn") as HTMLButtonElement | null
    playIcon = document.getElementById("play-icon") as HTMLSpanElement | null
    prevBtn = document.getElementById("prev-btn") as HTMLButtonElement | null
    nextBtn = document.getElementById("next-btn") as HTMLButtonElement | null
    barProgress = document.getElementById("bar-progress") as HTMLDivElement | null
    barProgressFill = document.getElementById("bar-progress-fill") as HTMLDivElement | null
    curTimeEl = document.getElementById("cur-time") as HTMLSpanElement | null
    totTimeEl = document.getElementById("tot-time") as HTMLSpanElement | null
    npTitle = document.getElementById("np-title") as HTMLDivElement | null
    npAlbum = document.getElementById("np-album") as HTMLAnchorElement | null
    npErrorEl = document.getElementById("np-error") as HTMLSpanElement | null
    progressFill = document.getElementById("progress-fill") as HTMLDivElement | null
    progressBorder = document.getElementById("progress-border") as HTMLDivElement | null
    npEl = document.getElementById("np") as HTMLDivElement | null
    // Explicit "open player" affordances for desktop -- a real button
    // wrapping the title (keyboard accessible), and a separate visible
    // expand control.
    npOpenBtn = document.getElementById("np-open") as HTMLButtonElement | null
    expandBtn = document.getElementById("expand-btn") as HTMLButtonElement | null

    // Drawer elements are mobile-only UI; guard each use individually
    // rather than bailing out of the whole player if one is missing.
    drawer = document.getElementById("player-drawer") as HTMLDivElement | null
    drawerCloseBtn = document.getElementById("drawer-close-btn") as HTMLButtonElement | null
    drawerTitle = document.getElementById("drawer-title") as HTMLDivElement | null
    drawerSub = document.getElementById("drawer-sub") as HTMLParagraphElement | null
    drawerBarcode = document.getElementById("drawer-barcode") as HTMLSpanElement | null
    drawerCode = document.getElementById("drawer-code") as HTMLSpanElement | null
    drawerSeek = document.getElementById("drawer-seek") as HTMLInputElement | null
    drawerCurTime = document.getElementById("drawer-cur-time") as HTMLSpanElement | null
    drawerTotTime = document.getElementById("drawer-tot-time") as HTMLSpanElement | null
    drawerPrevBtn = document.getElementById("drawer-prev-btn") as HTMLButtonElement | null
    drawerNextBtn = document.getElementById("drawer-next-btn") as HTMLButtonElement | null
    drawerPlayBtn = document.getElementById("drawer-play-btn") as HTMLButtonElement | null
    drawerPlayIcon = document.getElementById("drawer-play-icon") as HTMLSpanElement | null
    // Optional "Signal" decal (bpm/key), shown only when a track
    // carries that data, and the stage's spectrum canvas.
    drawerDecal = document.getElementById("drawer-decal") as HTMLDivElement | null
    drawerDecalText = document.getElementById("drawer-decal-text") as HTMLSpanElement | null
    viz = document.getElementById("player-viz") as HTMLCanvasElement | null

    if (!audio || audioUnavailable) return

    if (
      !playBtn ||
      !playIcon ||
      !prevBtn ||
      !nextBtn ||
      !barProgress ||
      !barProgressFill ||
      !curTimeEl ||
      !totTimeEl ||
      !npTitle ||
      !npAlbum ||
      !npEl ||
      !progressFill ||
      !progressBorder
    ) {
      return
    }

    audio.volume = 0.8

    // The audio object never stopped across this navigation -- it's
    // the same singleton it has always been. But the DOM it's
    // reflected into is brand new every swap, so resync every bit of
    // UI directly from its live state here rather than relying on
    // whatever events happen to have already fired by this point.
    syncProgress()
    updatePlayIcon()
    updateNav()
    if (index >= 0 && queue[index]) paintTrackUI(queue[index])
    setErrorUI(playbackError)

    if (bar.dataset.initialized === "true") return
    bar.dataset.initialized = "true"

    playBtn.addEventListener("click", togglePlayback)
    drawerPlayBtn?.addEventListener("click", togglePlayback)

    npOpenBtn?.addEventListener("click", () => {
      if (!audio?.src) return
      // Safari/WebKit doesn't focus a <button> on click the way other
      // browsers do -- openDrawer() below captures document.activeElement
      // as the "opener" to restore focus to on close, so without this
      // it would capture whatever had focus before the click instead.
      npOpenBtn?.focus()
      openDrawer()
    })
    expandBtn?.addEventListener("click", () => {
      if (!audio?.src) return
      expandBtn?.focus()
      openDrawer()
    })

    drawerCloseBtn?.addEventListener("click", closeDrawer)

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return
      if (!drawer?.classList.contains("open")) return
      closeDrawer()
    })

    document.addEventListener("keydown", (event) => {
      if (event.code !== "Space" && event.key !== " ") return
      if (!audio?.src) return

      const target = event.target as HTMLElement | null
      const tag = target?.tagName
      const isFormField =
        tag === "INPUT" ||
        tag === "TEXTAREA" ||
        tag === "SELECT" ||
        tag === "BUTTON" ||
        target?.isContentEditable

      if (isFormField) return

      event.preventDefault()
      togglePlayback()
    })

    prevBtn.addEventListener("click", goToPrev)
    nextBtn.addEventListener("click", goToNext)
    drawerPrevBtn?.addEventListener("click", goToPrev)
    drawerNextBtn?.addEventListener("click", goToNext)

    // The stage's #drawer-seek is the only scrubbable range input left
    // -- the bar's progress display is read-only (see syncProgress).
    drawerSeek?.addEventListener("input", () => {
      if (!drawerSeek) return
      isSeeking = true
      curTimeEl!.textContent = fmt(Number(drawerSeek.value) / 1000)
      if (drawerCurTime)
        drawerCurTime.textContent = fmt(Number(drawerSeek.value) / 1000)
      setRangeProgress(drawerSeek)
    })
    drawerSeek?.addEventListener("change", () => {
      if (!drawerSeek || !audio) return
      audio.currentTime = Number(drawerSeek.value) / 1000
      isSeeking = false
    })

    // A track row click only plays -- it never opens the stage, on any
    // screen size. This is a deliberate POC deviation; see PROGRESS.md.
    document.addEventListener("player:play", ((event: CustomEvent) => {
      const detail = event.detail
      if (!detail || !Array.isArray(detail.queue)) return
      queue = detail.queue
      loadTrack(detail.index ?? 0, detail.autoplay ?? true)
    }) as EventListener)

    document.addEventListener("player:toggle", togglePlayback)

    // Opens the stage without touching playback -- used by the bar's
    // info area and expand button (desktop) and the mini bar (phones).
    document.addEventListener("player:open-stage", () => {
      if (!audio?.src) return
      openDrawer()
    })

    document.addEventListener("player:query", emitState)

    // ---------- --minih (mini bar height) for page bottom padding ----------
    function initMinih() {
      function set() {
        document.documentElement.style.setProperty(
          "--minih",
          bar!.offsetHeight + "px",
        )
      }
      new ResizeObserver(set).observe(bar!)
      set()
    }
    initMinih()

    // ---------- stage spectrum -- real analyser with a 118 BPM
    // simulated fallback, matching the home page's About spectrum pattern ----------
    if (viz) {
      const ctx = viz.getContext("2d")
      if (ctx) {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
        const SEG = 6,
          GAP = 3,
          BGAP = 4,
          HOLD_MS = 650,
          FALL = 2.4,
          SIM_BPM = 118
        let W = 0,
          H = 0,
          N = 0
        let lvl: number[] = [],
          peak: number[] = [],
          hold: number[] = [],
          vel: number[] = []
        const clamp = (v: number, a: number, b: number) =>
          Math.max(a, Math.min(b, v))

        new ResizeObserver(() => {
          const r = viz!.getBoundingClientRect()
          const dpr = Math.min(2, devicePixelRatio || 1)
          W = r.width
          H = r.height
          viz!.width = Math.round(W * dpr)
          viz!.height = Math.round(H * dpr)
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
          N = clamp(Math.floor((W + BGAP) / (12 + BGAP)), 14, 40)
          lvl = Array(N).fill(0)
          peak = Array(N).fill(0)
          hold = Array(N).fill(0)
          vel = Array(N).fill(0)
        }).observe(viz)

        function targets(ts: number) {
          const out = new Array(N).fill(0)
          if (!audio || !isActuallyPlaying) {
            if (!reduce)
              for (let i = 0; i < N; i++)
                out[i] = 0.05 + 0.05 * (0.5 + 0.5 * Math.sin(ts / 600 + i * 0.55))
            return out
          }
          if (analyser && freqData && !analyserFailed) {
            analyser.getByteFrequencyData(freqData)
            const nyq = (audioCtx?.sampleRate ?? 44100) / 2
            const bins = freqData.length
            const f0 = 45,
              f1 = 9000
            for (let i = 0; i < N; i++) {
              const a = f0 * Math.pow(f1 / f0, i / N)
              const b = f0 * Math.pow(f1 / f0, (i + 1) / N)
              const lo = Math.floor((a / nyq) * bins)
              const hi = Math.max(lo + 1, Math.ceil((b / nyq) * bins))
              let m = 0
              for (let k = lo; k < hi && k < bins; k++)
                if (freqData[k] > m) m = freqData[k]
              out[i] = clamp(Math.pow(m / 255, 1.7) * (1 + (i / N) * 0.35), 0, 1)
            }
            return out
          }
          // simulated fallback: fixed 118 BPM, phased off currentTime
          const ph = (audio.currentTime / (60 / SIM_BPM)) % 1
          for (let i = 0; i < N; i++) {
            const lowW = 1 - i / N
            out[i] = clamp(
              lowW * 0.95 * Math.exp(-ph * 4) +
                Math.random() * 0.25 * (0.4 + lowW * 0.6) +
                0.08,
              0,
              1,
            )
          }
          return out
        }

        let last = 0
        let vis = true
        let running = false

        function draw(ts: number) {
          const dt = Math.min(0.05, (ts - last) / 1000 || 0.016)
          last = ts
          setAnalyserStatusLine()
          if (W && N) {
            const tg = targets(ts)
            ctx.clearRect(0, 0, W, H)
            const bw = (W - (N - 1) * BGAP) / N
            const pitch = SEG + GAP
            const segs = Math.max(4, Math.floor((H + GAP) / pitch))
            const litColor = getComputedStyle(document.documentElement)
              .getPropertyValue("--stage-era")
              .trim() || "#C0392F"
            const hotColor = getComputedStyle(document.documentElement)
              .getPropertyValue("--pop")
              .trim() || "#E5472F"
            for (let i = 0; i < N; i++) {
              lvl[i] = Math.max(tg[i], lvl[i] - dt * 1.7)
              const L = lvl[i]
              if (L >= peak[i]) {
                peak[i] = L
                hold[i] = HOLD_MS
                vel[i] = 0
              } else if (hold[i] > 0) {
                hold[i] -= dt * 1000
              } else {
                vel[i] += FALL * dt
                peak[i] = Math.max(L, peak[i] - vel[i] * dt)
              }
              const x = i * (bw + BGAP)
              const lit = Math.round(L * segs)
              const cap = Math.min(segs - 1, Math.max(0, Math.round(peak[i] * segs) - 1))
              for (let s = 0; s < segs; s++) {
                const y = H - (s + 1) * pitch + GAP
                ctx.fillStyle =
                  s < lit
                    ? s / segs > 0.84
                      ? hotColor
                      : litColor
                    : "rgba(239,230,204,.07)"
                ctx.fillRect(x, y, bw, SEG)
              }
              if (peak[i] > 0.04) {
                ctx.fillStyle = "#EFE6CC"
                ctx.fillRect(x, H - (cap + 1) * pitch + GAP, bw, SEG)
              }
            }
          }
          if (!reduce && vis) requestAnimationFrame(draw)
          else running = false
        }
        function kick() {
          if (!running && !reduce) {
            running = true
            requestAnimationFrame(draw)
          }
        }
        new IntersectionObserver((entries) => {
          vis = entries[0].isIntersecting
          if (vis) kick()
        }).observe(drawer ?? viz)
        if (reduce) {
          for (let k = 0; k < 40; k++) draw(performance.now() + k * 40)
        }
      }
    }
  }

  document.addEventListener("astro:page-load", initPlayerBar)
</script>

<style>
  .player-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    height: 76px;
    background: var(--static);
    border-top: 1px solid var(--line);
    /* Hidden until a track is selected, on every screen size -- slide
       off-screen instead of display:none, since toggling display on a
       position:fixed element can leave Safari's fixed-position cache
       stale until a forced reflow (reads as the bar losing its bottom
       anchor and drifting with scroll). Staying in the fixed render
       tree the whole time avoids that. */
    transform: translateY(100%);
    transition: transform 0.2s ease;
    pointer-events: none;
  }
  .player-bar.has-track {
    transform: translateY(0);
    pointer-events: auto;
  }
  /* mobile-only stand-in for the draggable seek input -- a plain,
     non-interactive progress line pinned to the top edge of the bar */
  .progress-border {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--line);
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: var(--pop);
  }
  .player-inner {
    max-width: 1080px;
    height: 100%;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .np {
    min-width: 0;
    flex: 1 1 160px;
    display: flex;
    flex-direction: column;
  }
  .np-open {
    display: block;
    width: 100%;
    min-width: 0;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }
  .np-title {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.01em;
    font-size: 0.92rem;
    color: var(--bone);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .np-album {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ash);
    text-decoration: none;
    margin-top: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.15s;
  }
  .np-album[href]:hover {
    color: var(--pop);
    text-decoration: underline;
  }
  .np-error {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pop);
    margin-top: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .controls {
    flex: none;
